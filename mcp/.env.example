# Residence Tlemcen admin MCP server - copy this file to `.env` and fill in real values.
# NEVER commit `.env` (it is covered by .gitignore).

# Existing Supabase project (Postgres + Auth). Use the anon/publishable key ONLY.
# Never put the service role key here: this server must run under RLS.
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# A real administrator account (profiles.role = 'admin').
# The seed script (scripts/seed.py) creates admin@residence.test / Admin1234! for demos.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Shared secret for this server. ChatGPT and the MCP Inspector must send it as
# "Authorization: Bearer <MCP_AUTH_TOKEN>". Minimum 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
MCP_AUTH_TOKEN=replace-with-a-random-string-of-at-least-32-characters

# HTTP port for the local server (default 8000).
PORT=8000
