# Provider-neutral SMTP Configuration for Supabase Auth
# Default provider: Brevo (https://www.brevo.com)
#
# DO NOT COMMIT SECRETS TO GIT.
# Copy this file to .env.local or set variables in your cloud Supabase Dashboard.
#
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-smtp-login
SMTP_PASS=your-brevo-smtp-key
SMTP_FROM=no-reply@resivo.univ-tlemcen.dz
SMTP_FROM_NAME="RÉSIVO - Cité Universitaire Tlemcen"
