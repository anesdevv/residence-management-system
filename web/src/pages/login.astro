---
/**
 * RÉSIVO — resident sign in (simple contact email flow).
 * Card ID + password sign-in only; no email codes, magic links, or email password reset.
 */
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import BrandMark from '../components/BrandMark.astro';
import InlineBanner from '../components/InlineBanner.astro';
import PageHeader from '../components/PageHeader.astro';
import { localizePath, t, type SupportedLocale } from '../lib/i18n';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'no-store, no-cache, must-revalidate, max-age=0');
const locale: SupportedLocale = Astro.locals.locale || 'en';

const error = Astro.url.searchParams.get('error');
const registered = Astro.url.searchParams.get('registered');
---

<Layout title={locale === 'fr' ? 'Connexion Résident — RÉSIVO' : 'Resident Sign In — RÉSIVO'} activeNav="login">
  <div class="mx-auto flex w-full max-w-md flex-col gap-6 py-6 sm:py-8">
    <div class="card p-6 sm:p-8">
      <div class="mb-6 flex justify-center">
        <BrandMark variant="mark" size={48} />
      </div>

      <PageHeader
        title={t(locale, 'auth.login_title')}
        overline={t(locale, 'auth.login_overline')}
        subtitle={t(locale, 'auth.login_subtitle')}
      />

      {
        registered && (
          <InlineBanner kind="success" title={t(locale, 'auth.login_application_received')} class="mb-4">
            {t(locale, 'auth.login_application_received_desc')}
          </InlineBanner>
        )
      }

      {
        error && (
          <InlineBanner kind="error" title={t(locale, 'common.error')} class="mb-4">
            {error}
          </InlineBanner>
        )
      }

      <!-- Simple card ID + password sign-in form -->
      <form method="POST" action="/api/login" class="flex flex-col gap-4" id="login-form">
        <div class="flex flex-col gap-2">
          <label class="label" for="card_id">{t(locale, 'auth.login_card_id')}</label>
          <input
            class="input tnum"
            type="text"
            name="card_id"
            id="card_id"
            required
            inputmode="numeric"
            autocomplete="username"
            placeholder={t(locale, 'auth.login_card_id_placeholder')}
          />
          <p class="field-hint">{t(locale, 'auth.login_card_id_hint')}</p>
        </div>

        <div class="flex flex-col gap-2">
          <label class="label" for="password">{t(locale, 'fields.password')}</label>
          <div class="relative">
            <input
              class="input pr-12"
              type="password"
              name="password"
              id="password"
              required
              autocomplete="current-password"
              placeholder="••••••••"
            />
            <button
              type="button"
              id="toggle-password"
              class="absolute right-3 top-1/2 -translate-y-1/2 text-muted hover:text-ink transition-colors p-1"
              aria-label={locale === 'fr' ? 'Afficher le mot de passe' : 'Show password'}
              title={locale === 'fr' ? 'Afficher le mot de passe' : 'Show password'}
            >
              <span id="toggle-eye-icon"><Icon name="eye" size={18} /></span>
            </button>
          </div>
          <p class="field-hint">{t(locale, 'auth.forgot_password_office')}</p>
        </div>

        <button class="btn btn-primary w-full mt-2" type="submit">
          <Icon name="log-in" size={18} />
          <span>{t(locale, 'auth.login_btn')}</span>
        </button>
      </form>

      <div class="mt-6 flex flex-col gap-2 border-t border-line pt-6 text-center">
        <p class="text-small font-normal text-muted">
          {t(locale, 'auth.login_no_account')}{' '}
          <a class="link font-semibold" href={localizePath(locale, '/register')}>{t(locale, 'auth.login_register_link')}</a>
        </p>
        <p class="text-small font-normal text-muted">
          {t(locale, 'auth.login_staff_note')}
        </p>
      </div>
    </div>

    <p class="text-center text-small font-normal text-muted">
      Direction des Œuvres Universitaires (DOU) · Cité Universitaire · Tlemcen
    </p>
  </div>
</Layout>

<script is:inline>
  const toggleBtn = document.getElementById('toggle-password');
  const pwdInput = document.getElementById('password');
  const eyeIcon = document.getElementById('toggle-eye-icon');

  if (toggleBtn && pwdInput) {
    toggleBtn.addEventListener('click', () => {
      const isPassword = pwdInput.getAttribute('type') === 'password';
      pwdInput.setAttribute('type', isPassword ? 'text' : 'password');
      toggleBtn.setAttribute('aria-label', isPassword ? 'Hide password' : 'Show password');
      toggleBtn.setAttribute('title', isPassword ? 'Hide password' : 'Show password');
      if (eyeIcon) {
        eyeIcon.style.opacity = isPassword ? '0.5' : '1';
      }
    });
  }
</script>
