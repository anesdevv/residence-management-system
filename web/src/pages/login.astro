---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';

export const prerender = false;
const error = Astro.url.searchParams.get('error');
const registered = Astro.url.searchParams.get('registered');
---

<Layout title="Resident Sign In — Residence Tlemcen" activeNav="login">
  <div class="mx-auto max-w-4xl py-4 sm:py-8 lg:py-12">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-stretch">
      <!-- Institutional Showcase Banner (Left Column on Desktop) -->
      <div class="lg:col-span-5 rounded-2xl bg-slate-900 text-white p-6 sm:p-8 flex flex-col justify-between shadow-sm relative overflow-hidden">
        <div class="space-y-6">
          <div class="flex items-center gap-3">
            <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-white/10 text-white border border-white/10 shadow-xs">
              <Icon name="crest" size={24} />
            </div>
            <div>
              <span class="block font-bold text-base leading-tight tracking-tight">Residence Tlemcen</span>
              <span class="block text-xs text-slate-400 font-medium">Cité Universitaire • DOU Tlemcen</span>
            </div>
          </div>

          <div class="space-y-3 pt-2">
            <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-white leading-snug">
              Official University Housing Management
            </h2>
            <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
              Secure digital portal for enrolled university students to manage residence status, maintenance dispatches, and room allocations.
            </p>
          </div>

          <!-- Feature Highlights -->
          <div class="space-y-3 pt-2">
            <div class="flex items-start gap-3 rounded-xl bg-white/5 p-3 border border-white/5">
              <div class="rounded-lg bg-blue-500/20 text-blue-300 p-2 shrink-0">
                <Icon name="shield" size={16} />
              </div>
              <div>
                <span class="block text-xs font-semibold text-white">Admissions Verification</span>
                <span class="block text-[11px] text-slate-400 mt-0.5">Cross-referenced with university matriculation rosters.</span>
              </div>
            </div>

            <div class="flex items-start gap-3 rounded-xl bg-white/5 p-3 border border-white/5">
              <div class="rounded-lg bg-emerald-500/20 text-emerald-300 p-2 shrink-0">
                <Icon name="wrench" size={16} />
              </div>
              <div>
                <span class="block text-xs font-semibold text-white">24/7 Facility Response</span>
                <span class="block text-[11px] text-slate-400 mt-0.5">Report room faults with instant staff ticket tracking.</span>
              </div>
            </div>

            <div class="flex items-start gap-3 rounded-xl bg-white/5 p-3 border border-white/5">
              <div class="rounded-lg bg-indigo-500/20 text-indigo-300 p-2 shrink-0">
                <Icon name="swap" size={16} />
              </div>
              <div>
                <span class="block text-xs font-semibold text-white">Room Relocation Portal</span>
                <span class="block text-[11px] text-slate-400 mt-0.5">Submit transfer requests directly to housing officers.</span>
              </div>
            </div>
          </div>
        </div>

        <div class="pt-6 mt-6 border-t border-white/10 flex items-center justify-between text-[11px] text-slate-400">
          <span>Direction des Œuvres Universitaires</span>
          <span class="font-medium text-slate-300">Tlemcen, Algérie</span>
        </div>
      </div>

      <!-- Sign In Card (Right Column on Desktop) -->
      <div class="lg:col-span-7 rounded-2xl border border-slate-200 bg-white p-6 sm:p-10 shadow-xs flex flex-col justify-center">
        <div>
          <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-slate-900">
            Resident Sign In
          </h1>
          <p class="mt-2 text-xs sm:text-sm text-slate-500 leading-relaxed">
            Enter your official student card ID and portal password to access your dormitory account.
          </p>
        </div>

        <!-- Feedback Alerts -->
        {registered && (
          <div class="mt-5 flex items-start gap-3 rounded-xl border border-emerald-200 bg-emerald-50 p-4 text-emerald-950">
            <Icon name="check-circle" size={20} class="text-emerald-700 shrink-0 mt-0.5" />
            <div class="text-xs sm:text-sm">
              <span class="font-bold">Application Received!</span>
              <p class="mt-0.5 text-emerald-800 leading-relaxed">Your registration file has been created. Please sign in below to monitor your dormitory approval progress.</p>
            </div>
          </div>
        )}

        {error && (
          <div class="mt-5 flex items-start gap-3 rounded-xl border border-red-200 bg-red-50 p-4 text-red-950">
            <Icon name="alert-circle" size={20} class="text-red-700 shrink-0 mt-0.5" />
            <div class="text-xs sm:text-sm">
              <span class="font-bold">Authentication Failed</span>
              <p class="mt-0.5 text-red-800 leading-relaxed">{error}</p>
            </div>
          </div>
        )}

        <!-- Form -->
        <form method="POST" action="/api/login" class="mt-6 sm:mt-8 space-y-5">
          <div>
            <label for="card_id" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">
              Student Card ID (Carte d'étudiant)
            </label>
            <div class="relative">
              <input
                type="text"
                name="card_id"
                id="card_id"
                required
                autocomplete="username"
                placeholder="e.g. 202338012345"
                class="w-full min-h-[44px] rounded-xl border border-slate-300 px-4 py-2.5 text-sm text-slate-900 placeholder:text-slate-400 focus:border-blue-600 focus:ring-2 focus:ring-blue-600/20 focus:outline-none transition tnum"
              />
            </div>
            <span class="mt-1.5 block text-[11px] text-slate-400">The 12-digit matriculation number found on your university card.</span>
          </div>

          <div>
            <div class="flex items-center justify-between mb-2">
              <label for="password" class="block text-xs font-bold uppercase tracking-wider text-slate-700">
                Password
              </label>
            </div>
            <div class="relative">
              <input
                type="password"
                name="password"
                id="password"
                required
                autocomplete="current-password"
                placeholder="••••••••"
                class="w-full min-h-[44px] rounded-xl border border-slate-300 px-4 py-2.5 text-sm text-slate-900 placeholder:text-slate-400 focus:border-blue-600 focus:ring-2 focus:ring-blue-600/20 focus:outline-none transition"
              />
            </div>
          </div>

          <div class="pt-2">
            <button
              type="submit"
              class="w-full min-h-[48px] flex items-center justify-center gap-2 rounded-xl bg-slate-900 px-5 py-3 text-sm font-semibold text-white shadow-xs hover:bg-blue-600 active:scale-[0.99] focus:outline-none focus:ring-2 focus:ring-blue-600 focus:ring-offset-2 transition cursor-pointer"
            >
              <Icon name="login" size={18} />
              <span>Sign In to Housing Portal</span>
            </button>
          </div>
        </form>

        <!-- Footer Links -->
        <div class="mt-8 border-t border-slate-100 pt-5 text-center text-xs text-slate-500 space-y-2">
          <p>
            First time applying for dormitory accommodation?{' '}
            <a href="/register" class="font-semibold text-blue-600 hover:text-blue-700 hover:underline">
              Register as Resident
            </a>
          </p>
          <p class="text-[11px] text-slate-400">
            Administrative staff & technicians should log in via the desktop operations console.
          </p>
        </div>
      </div>
    </div>
  </div>
</Layout>
