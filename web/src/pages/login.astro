---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';

export const prerender = false;
const error = Astro.url.searchParams.get('error');
const registered = Astro.url.searchParams.get('registered');
---

<Layout title="Resident Sign In — Residence Tlemcen" activeNav="login">
  <div class="mx-auto max-w-md py-6 sm:py-10">
    <div class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-8 shadow-xs">
      <!-- Header -->
      <div class="text-center">
        <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-xl bg-slate-900 text-white shadow-xs">
          <Icon name="crest" size={24} />
        </div>
        <h1 class="mt-4 text-2xl font-bold tracking-tight text-slate-900">Resident Sign In</h1>
        <p class="mt-1.5 text-xs sm:text-sm text-slate-500">
          Enter your student card ID and password to access your dormitory portal.
        </p>
      </div>

      <!-- Feedback Alerts -->
      {registered && (
        <div class="mt-5 flex items-start gap-3 rounded-lg border border-emerald-200 bg-emerald-50 p-3.5 text-emerald-900">
          <Icon name="check-circle" size={18} class="text-emerald-700 shrink-0 mt-0.5" />
          <div class="text-xs">
            <span class="font-bold">Application Received!</span>
            <p class="mt-0.5 text-emerald-800">Your registration has been submitted. You can now sign in to monitor your approval status.</p>
          </div>
        </div>
      )}

      {error && (
        <div class="mt-5 flex items-start gap-3 rounded-lg border border-red-200 bg-red-50 p-3.5 text-red-900">
          <Icon name="alert-circle" size={18} class="text-red-700 shrink-0 mt-0.5" />
          <div class="text-xs">
            <span class="font-bold">Authentication Failed</span>
            <p class="mt-0.5 text-red-800">{error}</p>
          </div>
        </div>
      )}

      <!-- Form -->
      <form method="POST" action="/api/login" class="mt-6 space-y-4">
        <div>
          <label for="card_id" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-1.5">
            Student Card ID (Carte d'étudiant)
          </label>
          <div class="relative">
            <input
              type="text"
              name="card_id"
              id="card_id"
              required
              autocomplete="username"
              placeholder="e.g. 202338012345"
              class="w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 placeholder:text-slate-400 focus:border-blue-600 focus:ring-2 focus:ring-blue-600/20 focus:outline-none transition tnum"
            />
          </div>
          <span class="mt-1 block text-[11px] text-slate-400">Your official university registration number.</span>
        </div>

        <div>
          <div class="flex items-center justify-between mb-1.5">
            <label for="password" class="block text-xs font-semibold uppercase tracking-wider text-slate-700">
              Password
            </label>
          </div>
          <div class="relative">
            <input
              type="password"
              name="password"
              id="password"
              required
              autocomplete="current-password"
              placeholder="••••••••"
              class="w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 placeholder:text-slate-400 focus:border-blue-600 focus:ring-2 focus:ring-blue-600/20 focus:outline-none transition"
            />
          </div>
        </div>

        <button
          type="submit"
          class="w-full mt-2 flex items-center justify-center gap-2 rounded-lg bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white shadow-xs hover:bg-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-600 focus:ring-offset-2 transition cursor-pointer"
        >
          <Icon name="login" size={16} />
          <span>Sign In to Dashboard</span>
        </button>
      </form>

      <!-- Footer Links -->
      <div class="mt-6 border-t border-slate-100 pt-4 text-center text-xs text-slate-500">
        <p>
          Don't have an accommodation account?{' '}
          <a href="/register" class="font-semibold text-blue-600 hover:text-blue-700 hover:underline">
            Register here
          </a>
        </p>
        <p class="mt-2 text-[11px] text-slate-400">
          Department staff or technicians? Please use the desktop administration console.
        </p>
      </div>
    </div>
  </div>
</Layout>
