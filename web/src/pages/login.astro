---
/**
 * RÉSIVO — login (docs/DESIGN.md §8, plan Phase 4).
 * Centred card on the canvas: brand mark, PageHeader-style title, the existing
 * card_id/password form (same action, same fields) and the query-param banners.
 */
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import BrandMark from '../components/BrandMark.astro';
import InlineBanner from '../components/InlineBanner.astro';
import PageHeader from '../components/PageHeader.astro';

export const prerender = false;
const error = Astro.url.searchParams.get('error');
const registered = Astro.url.searchParams.get('registered');
---

<Layout title="Resident Sign In — RÉSIVO" activeNav="login">
  <div class="mx-auto flex w-full max-w-md flex-col gap-6 py-6 sm:py-8">
    <div class="card p-6 sm:p-8">
      <div class="mb-6 flex justify-center">
        <BrandMark variant="mark" size={48} />
      </div>

      <PageHeader
        title="Resident sign in"
        overline="Resident authentication"
        subtitle="Enter your official student card ID and portal password to access your dormitory account."
      />

      {
        registered && (
          <InlineBanner kind="success" title="Application received!" class="mb-4">
            Your registration dossier has been submitted. Sign in below to track your housing approval progress.
          </InlineBanner>
        )
      }

      {
        error && (
          <InlineBanner kind="error" title="Authentication failed" class="mb-4">
            {error}
          </InlineBanner>
        )
      }

      <form method="POST" action="/api/login" class="flex flex-col gap-4">
        <div class="flex flex-col gap-2">
          <label class="label" for="card_id">Student card ID (Carte d'étudiant)</label>
          <input
            class="input tnum"
            type="text"
            name="card_id"
            id="card_id"
            required
            autocomplete="username"
            placeholder="e.g. 202338012345"
          />
          <p class="field-hint">The matriculation number found on your university student card.</p>
        </div>

        <div class="flex flex-col gap-2">
          <label class="label" for="password">Password</label>
          <input
            class="input"
            type="password"
            name="password"
            id="password"
            required
            autocomplete="current-password"
            placeholder="••••••••"
          />
        </div>

        <button class="btn btn-primary w-full" type="submit">
          <Icon name="log-in" size={18} />
          <span>Sign in</span>
        </button>
      </form>

      <div class="mt-6 flex flex-col gap-2 border-t border-line pt-6 text-center">
        <p class="text-small font-normal text-muted">
          First time applying for dormitory accommodation?{' '}
          <a class="link font-semibold" href="/register">Register as resident</a>
        </p>
        <p class="text-small font-normal text-muted">
          Administrative staff &amp; technicians should sign in via the desktop operations console.
        </p>
      </div>
    </div>

    <p class="text-center text-small font-normal text-muted">
      Student portal · Cité Universitaire Tlemcen — Direction des Œuvres Universitaires.
    </p>
  </div>
</Layout>
