---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';

export const prerender = false;
const error = Astro.url.searchParams.get('error');
const registered = Astro.url.searchParams.get('registered');
---

<Layout title="Resident Sign In — RÉSIVO" activeNav="login">
  <div class="mx-auto max-w-6xl py-4 sm:py-8 lg:py-10">
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 items-stretch">
      <!-- Left Column: Authentication Form -->
      <div class="lg:col-span-7 flex flex-col justify-center">
        <div class="rounded-2xl border border-line/70 bg-surface p-6 sm:p-10 shadow-sm">
          <div class="mb-6">
            <div class="mb-3 inline-flex items-center gap-2 rounded-full bg-canvas px-3 py-1 text-xs font-semibold text-amber-ink">
              <span class="inline-block h-1.5 w-1.5 rounded-full bg-amber"></span>
              <span>Resident Authentication</span>
            </div>
            <h1 class="font-display text-2xl sm:text-3xl font-extrabold tracking-tight text-navy">
              Resident Sign In
            </h1>
            <p class="mt-2 text-xs sm:text-sm text-muted leading-relaxed">
              Enter your official student card ID and portal password to access your dormitory account.
            </p>
          </div>

          <!-- Feedback Alerts -->
          {registered && (
            <div class="mb-6 flex items-start gap-3 rounded-xl border border-emerald-200 bg-emerald-50 p-4 text-emerald-950">
              <Icon name="check-circle" size={20} class="text-emerald-700 shrink-0 mt-0.5" />
              <div class="text-xs sm:text-sm">
                <span class="font-bold">Application Received!</span>
                <p class="mt-0.5 text-emerald-800 leading-relaxed">
                  Your registration dossier has been submitted. Sign in below to track your housing approval progress.
                </p>
              </div>
            </div>
          )}

          {error && (
            <div class="mb-6 flex items-start gap-3 rounded-xl border border-red-200 bg-red-50 p-4 text-red-950">
              <Icon name="alert-circle" size={20} class="text-red-700 shrink-0 mt-0.5" />
              <div class="text-xs sm:text-sm">
                <span class="font-bold">Authentication Failed</span>
                <p class="mt-0.5 text-red-800 leading-relaxed">{error}</p>
              </div>
            </div>
          )}

          <!-- Form -->
          <form method="POST" action="/api/login" class="space-y-5">
            <div>
              <label for="card_id" class="block text-xs font-bold uppercase tracking-wider text-navy mb-2">
                Student Card ID (Carte d'étudiant)
              </label>
              <div class="relative">
                <input
                  type="text"
                  name="card_id"
                  id="card_id"
                  required
                  autocomplete="username"
                  placeholder="e.g. 202338012345"
                  class="w-full min-h-[44px] rounded-xl border border-line bg-canvas/40 px-4 py-2.5 text-sm text-ink placeholder:text-muted/60 focus:border-navy focus:bg-surface focus:ring-2 focus:ring-navy/15 focus:outline-none transition tnum"
                />
              </div>
              <span class="mt-1.5 block text-[11px] text-muted">
                The matriculation number found on your university student card.
              </span>
            </div>

            <div>
              <label for="password" class="block text-xs font-bold uppercase tracking-wider text-navy mb-2">
                Password
              </label>
              <div class="relative">
                <input
                  type="password"
                  name="password"
                  id="password"
                  required
                  autocomplete="current-password"
                  placeholder="••••••••"
                  class="w-full min-h-[44px] rounded-xl border border-line bg-canvas/40 px-4 py-2.5 text-sm text-ink placeholder:text-muted/60 focus:border-navy focus:bg-surface focus:ring-2 focus:ring-navy/15 focus:outline-none transition"
                />
              </div>
            </div>

            <div class="pt-2">
              <button
                type="submit"
                class="w-full min-h-[48px] flex items-center justify-center gap-2 rounded-xl bg-navy px-5 py-3 text-sm font-semibold text-white shadow-sm hover:bg-navy-2 active:scale-[0.99] focus:outline-none focus:ring-2 focus:ring-navy focus:ring-offset-2 transition cursor-pointer"
              >
                <Icon name="login" size={18} />
                <span>Sign In to Housing Portal</span>
              </button>
            </div>
          </form>

          <!-- Footer Links -->
          <div class="mt-8 border-t border-line/60 pt-5 text-center text-xs text-muted space-y-2">
            <p>
              First time applying for dormitory accommodation?{' '}
              <a href="/register" class="font-semibold text-amber-ink hover:underline">
                Register as Resident
              </a>
            </p>
            <p class="text-[11px] text-muted/75">
              Administrative staff & technicians should sign in via the desktop operations console.
            </p>
          </div>
        </div>
      </div>

      <!-- Right Column: Navy Hero Panel -->
      <div class="lg:col-span-5 rounded-2xl bg-navy text-white p-6 sm:p-8 lg:p-10 shadow-md flex flex-col justify-between relative overflow-hidden">
        <!-- Subtle background accent -->
        <div class="absolute -right-16 -top-16 h-64 w-64 rounded-full bg-navy-2/60 blur-3xl pointer-events-none"></div>
        <div class="absolute -left-16 -bottom-16 h-64 w-64 rounded-full bg-amber/10 blur-3xl pointer-events-none"></div>

        <div class="relative z-10 space-y-6">
          <div class="flex items-center gap-3">
            <img src="/resivo-logo.svg" alt="RÉSIVO" class="h-12 w-12 object-contain" width="48" height="48" />
            <div>
              <span class="block font-display text-lg font-extrabold leading-tight tracking-tight text-white">RÉSIVO</span>
              <span class="block text-xs text-white/70 font-medium">Cité Universitaire • DOU Tlemcen</span>
            </div>
          </div>

          <div class="space-y-3 pt-2">
            <h2 class="font-display text-xl sm:text-2xl font-bold tracking-tight text-white leading-snug">
              Official University Housing Management
            </h2>
            <p class="text-xs sm:text-sm text-white/75 leading-relaxed">
              Your official digital gateway to student housing at Cité Universitaire Tlemcen. Track status, request room transfers, and dispatch maintenance.
            </p>
          </div>

          <!-- 3-4 Real Feature Bullets -->
          <div class="space-y-3 pt-2">
            <div class="flex items-start gap-3 rounded-xl bg-white/5 p-3.5 border border-white/10">
              <div class="rounded-lg bg-amber/20 text-amber p-2 shrink-0">
                <Icon name="shield" size={17} />
              </div>
              <div>
                <span class="block text-xs font-semibold text-white">Admissions &amp; Room Assignment</span>
                <span class="block text-[11px] text-white/70 mt-0.5">Cross-referenced with official university enrollment records.</span>
              </div>
            </div>

            <div class="flex items-start gap-3 rounded-xl bg-white/5 p-3.5 border border-white/10">
              <div class="rounded-lg bg-emerald-500/20 text-emerald-300 p-2 shrink-0">
                <Icon name="wrench" size={17} />
              </div>
              <div>
                <span class="block text-xs font-semibold text-white">Maintenance Triage with Photos</span>
                <span class="block text-[11px] text-white/70 mt-0.5">Report room issues directly with photos and track repair tickets live.</span>
              </div>
            </div>

            <div class="flex items-start gap-3 rounded-xl bg-white/5 p-3.5 border border-white/10">
              <div class="rounded-lg bg-blue-500/20 text-blue-300 p-2 shrink-0">
                <Icon name="swap" size={17} />
              </div>
              <div>
                <span class="block text-xs font-semibold text-white">Room Transfer Requests</span>
                <span class="block text-[11px] text-white/70 mt-0.5">Request room relocation and change preferences online.</span>
              </div>
            </div>

            <div class="flex items-start gap-3 rounded-xl bg-white/5 p-3.5 border border-white/10">
              <div class="rounded-lg bg-indigo-500/20 text-indigo-300 p-2 shrink-0">
                <Icon name="building" size={17} />
              </div>
              <div>
                <span class="block text-xs font-semibold text-white">Cité Universitaire • Tlemcen</span>
                <span class="block text-[11px] text-white/70 mt-0.5">Direction des Œuvres Universitaires (DOU) dormitory network.</span>
              </div>
            </div>
          </div>
        </div>

        <div class="relative z-10 pt-6 mt-6 border-t border-white/10 flex items-center justify-between text-[11px] text-white/60">
          <span>Direction des Œuvres Universitaires</span>
          <span class="font-medium text-white/80">Tlemcen, Algérie</span>
        </div>
      </div>
    </div>
  </div>
</Layout>
