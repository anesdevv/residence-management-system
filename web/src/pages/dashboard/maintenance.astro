---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { createSupabaseServerClient } from '../../lib/supabase';

export const prerender = false;

const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);
const uid = Astro.locals.user!.id;

const { data: reports } = await supabase
  .from('maintenance_reports')
  .select('id, category, description, status, staff_note, photo_path, created_at')
  .eq('student_id', uid)
  .order('created_at', { ascending: false });

const { data: student } = await supabase
  .from('students')
  .select('status, room_id, rooms(block, number)')
  .eq('id', uid)
  .single();

const isActive = student?.status === 'active';

const withUrls = await Promise.all((reports ?? []).map(async (r) => {
  if (!r.photo_path) return { ...r, url: null };
  const { data } = await supabase.storage.from('maintenance-photos').createSignedUrl(r.photo_path, 300);
  return { ...r, url: data?.signedUrl ?? null };
}));

const totalCount = withUrls.length;
const pendingCount = withUrls.filter(r => r.status === 'pending').length;
const inProgressCount = withUrls.filter(r => r.status === 'in_progress').length;
const resolvedCount = withUrls.filter(r => r.status === 'resolved').length;

const error = Astro.url.searchParams.get('error');
const created = Astro.url.searchParams.get('created');

const categories = [
  { id: 'plumbing', label: 'Plumbing', icon: 'plumbing', desc: 'Leaks, faucets, drainage, pipes' },
  { id: 'electrical', label: 'Electrical', icon: 'electrical', desc: 'Lighting, power outlets, switches' },
  { id: 'furniture', label: 'Furniture', icon: 'furniture', desc: 'Beds, desks, doors, locks, closets' },
  { id: 'internet', label: 'Campus Wi-Fi', icon: 'internet', desc: 'Connectivity & ethernet jacks' },
  { id: 'other', label: 'General / Heating', icon: 'wrench', desc: 'Radiators, windows, structural' },
];
---

<Layout title="Maintenance Requests — Residence Tlemcen" activeNav="maintenance">
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-slate-200/90 pb-5">
    <div>
      <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-slate-900">
        Facility Maintenance
      </h1>
      <p class="mt-1 text-xs sm:text-sm text-slate-500">
        Submit fault tickets for your assigned room and monitor technician triage in real time.
      </p>
    </div>

    <a
      href="/dashboard"
      class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-600 hover:text-slate-900 bg-white border border-slate-200 px-3.5 py-2 rounded-xl shadow-xs transition self-start sm:self-auto min-h-[40px]"
    >
      <Icon name="arrow-left" size={14} />
      <span>Back to Dashboard</span>
    </a>
  </div>

  <!-- Emergency Assistance Banner -->
  <div class="mt-5 rounded-2xl border border-amber-200 bg-amber-50/70 p-4 sm:p-5 flex items-start sm:items-center justify-between gap-3 text-amber-950">
    <div class="flex items-start gap-3">
      <div class="rounded-xl bg-amber-100 p-2 text-amber-800 shrink-0 mt-0.5 sm:mt-0">
        <Icon name="alert-triangle" size={18} />
      </div>
      <div>
        <span class="block text-xs sm:text-sm font-bold text-amber-950">Urgent Hazard / Major Water Leak?</span>
        <span class="block text-xs text-amber-900/90 mt-0.5">Contact campus security desk immediately for on-duty technician emergency response.</span>
      </div>
    </div>
    <a
      href="tel:+21343210000"
      class="hidden sm:inline-flex items-center gap-1.5 text-xs font-bold text-amber-950 bg-amber-200/80 hover:bg-amber-200 px-3 py-1.5 rounded-lg whitespace-nowrap transition"
    >
      <Icon name="phone" size={14} />
      <span>24/7 Hotline</span>
    </a>
  </div>

  <!-- Status / Metric Strip -->
  <div class="mt-5 grid grid-cols-2 sm:grid-cols-4 gap-3">
    <div class="rounded-xl border border-slate-200 bg-white p-3.5 shadow-xs">
      <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400 block">Total Tickets</span>
      <span class="text-xl sm:text-2xl font-extrabold text-slate-900 mt-1 block tnum">{totalCount}</span>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white p-3.5 shadow-xs">
      <span class="text-[11px] font-bold uppercase tracking-wider text-amber-600 block">Pending Triage</span>
      <span class="text-xl sm:text-2xl font-extrabold text-amber-600 mt-1 block tnum">{pendingCount}</span>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white p-3.5 shadow-xs">
      <span class="text-[11px] font-bold uppercase tracking-wider text-blue-600 block">In Progress</span>
      <span class="text-xl sm:text-2xl font-extrabold text-blue-600 mt-1 block tnum">{inProgressCount}</span>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white p-3.5 shadow-xs">
      <span class="text-[11px] font-bold uppercase tracking-wider text-emerald-600 block">Resolved</span>
      <span class="text-xl sm:text-2xl font-extrabold text-emerald-600 mt-1 block tnum">{resolvedCount}</span>
    </div>
  </div>

  <!-- Feedback Alerts -->
  {created && (
    <div class="mt-6 flex items-start gap-3 rounded-2xl border border-emerald-200 bg-emerald-50 p-4 sm:p-5 text-emerald-950">
      <Icon name="check-circle" size={22} class="text-emerald-700 shrink-0 mt-0.5" />
      <div class="text-xs sm:text-sm">
        <span class="font-bold">Maintenance Ticket Dispatched!</span>
        <p class="mt-0.5 text-emerald-800 leading-relaxed">Your report has been queued for housing facility technicians. You can follow progress in your ticket history below.</p>
      </div>
    </div>
  )}

  {error && (
    <div class="mt-6 flex items-start gap-3 rounded-2xl border border-red-200 bg-red-50 p-4 sm:p-5 text-red-950">
      <Icon name="alert-circle" size={22} class="text-red-700 shrink-0 mt-0.5" />
      <div class="text-xs sm:text-sm">
        <span class="font-bold">Unable to Submit Report</span>
        <p class="mt-0.5 text-red-800 leading-relaxed">{error}</p>
      </div>
    </div>
  )}

  <!-- Locked State or Submission Form -->
  {!isActive ? (
    <div class="mt-6 rounded-2xl border border-amber-200 bg-amber-50/70 p-6 sm:p-8 text-amber-950 shadow-xs">
      <div class="flex items-start gap-4">
        <div class="rounded-xl bg-amber-100 p-3 text-amber-700 shrink-0">
          <Icon name="lock" size={24} />
        </div>
        <div>
          <h2 class="text-base sm:text-lg font-bold text-amber-950">Maintenance Reporting Locked</h2>
          <p class="mt-1.5 text-xs sm:text-sm text-amber-900 leading-relaxed max-w-2xl">
            Your account status is <span class="font-bold uppercase tracking-wider">{student?.status ?? 'pending'}</span>.
            Maintenance requests are strictly tied to an officially assigned dormitory room. Once your housing registration is verified and approved, you will be able to file repair tickets here.
          </p>
        </div>
      </div>
    </div>
  ) : (
    <div class="mt-6 rounded-2xl border border-slate-200 bg-white p-6 sm:p-8 shadow-xs">
      <div class="border-b border-slate-100 pb-4 mb-6">
        <h2 class="text-base sm:text-lg font-bold text-slate-900">Submit a New Maintenance Ticket</h2>
        <p class="text-xs text-slate-500 mt-0.5">Select the affected category and provide specific details for rapid dispatch.</p>
      </div>

      <form method="POST" action="/api/maintenance" enctype="multipart/form-data" class="space-y-6">
        <!-- Category Radio Picker -->
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2.5">
            Fault Category <span class="text-red-500">*</span>
          </label>
          <div class="grid grid-cols-2 sm:grid-cols-5 gap-3">
            {categories.map((c, i) => (
              <label class="cursor-pointer">
                <input
                  type="radio"
                  name="category"
                  value={c.id}
                  required
                  checked={i === 0}
                  class="peer sr-only"
                />
                <div class="flex flex-col items-center justify-center p-3.5 text-center rounded-xl border border-slate-200 bg-slate-50/60 hover:bg-slate-100 peer-checked:border-blue-600 peer-checked:bg-blue-50/70 peer-checked:text-blue-900 transition h-full min-h-[90px]">
                  <Icon name={c.icon} size={22} class="text-slate-600 peer-checked:text-blue-600" />
                  <span class="mt-2 text-xs font-semibold">{c.label}</span>
                  <span class="mt-0.5 text-[10px] text-slate-400 leading-tight hidden sm:block">{c.desc}</span>
                </div>
              </label>
            ))}
          </div>
        </div>

        <!-- Description -->
        <div>
          <label for="description" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
            Detailed Issue Description <span class="text-red-500">*</span>
          </label>
          <textarea
            name="description"
            id="description"
            required
            rows="3"
            placeholder="Explain the problem clearly (e.g. Bathroom sink faucet leaking steadily, desk drawer handle loose, radiator valve stuck closed)..."
            class="w-full rounded-xl border border-slate-300 p-3.5 text-sm text-slate-900 placeholder:text-slate-400 focus:border-blue-600 focus:ring-2 focus:ring-blue-600/20 focus:outline-none transition min-h-[96px]"
          ></textarea>
        </div>

        <!-- Photo Upload Box -->
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
            Attach Fault Photo (Recommended)
          </label>
          <div class="flex items-center gap-3">
            <input
              type="file"
              name="photo"
              id="photo"
              accept="image/*"
              class="block w-full text-xs text-slate-500 file:mr-4 file:py-2.5 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-slate-100 file:text-slate-700 hover:file:bg-slate-200 cursor-pointer min-h-[44px]"
            />
          </div>
          <span class="mt-1.5 block text-[11px] text-slate-400">Clear photos help technicians bring the correct tools and replacement parts. PNG or JPEG up to 10MB.</span>
        </div>

        <!-- Submit Button -->
        <div class="pt-2">
          <button
            type="submit"
            class="min-h-[48px] inline-flex items-center justify-center gap-2 rounded-xl bg-slate-900 px-7 py-3 text-sm font-semibold text-white shadow-xs hover:bg-blue-600 active:scale-[0.99] focus:outline-none focus:ring-2 focus:ring-blue-600 focus:ring-offset-2 transition cursor-pointer"
          >
            <Icon name="check-circle" size={18} />
            <span>Submit Maintenance Ticket</span>
          </button>
        </div>
      </form>
    </div>
  )}

  <!-- History Section with Filter Controls -->
  <div class="mt-10 sm:mt-12 space-y-4">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
      <div>
        <h2 class="text-lg font-bold text-slate-900">Work Orders & History</h2>
        <span class="text-xs text-slate-400">({totalCount} tickets filed)</span>
      </div>

      <!-- Filter Chips -->
      <div class="flex items-center gap-1.5 overflow-x-auto pb-1 sm:pb-0" id="filterChips">
        <button
          type="button"
          data-filter="all"
          class="filter-chip px-3 py-1.5 rounded-full text-xs font-semibold bg-slate-900 text-white transition cursor-pointer min-h-[32px]"
        >
          All ({totalCount})
        </button>
        <button
          type="button"
          data-filter="pending"
          class="filter-chip px-3 py-1.5 rounded-full text-xs font-medium bg-slate-100 text-slate-600 hover:bg-slate-200 transition cursor-pointer min-h-[32px]"
        >
          Pending ({pendingCount})
        </button>
        <button
          type="button"
          data-filter="in_progress"
          class="filter-chip px-3 py-1.5 rounded-full text-xs font-medium bg-slate-100 text-slate-600 hover:bg-slate-200 transition cursor-pointer min-h-[32px]"
        >
          In Progress ({inProgressCount})
        </button>
        <button
          type="button"
          data-filter="resolved"
          class="filter-chip px-3 py-1.5 rounded-full text-xs font-medium bg-slate-100 text-slate-600 hover:bg-slate-200 transition cursor-pointer min-h-[32px]"
        >
          Resolved ({resolvedCount})
        </button>
      </div>
    </div>

    {withUrls.length === 0 ? (
      <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-8 sm:p-10 text-center text-slate-400">
        <Icon name="wrench" size={36} class="mx-auto text-slate-300 mb-2" />
        <p class="text-sm font-semibold text-slate-700">No maintenance reports filed</p>
        <p class="text-xs text-slate-400 mt-1 max-w-sm mx-auto">When you report faults in your dormitory quarters, tickets and progress will be tracked here.</p>
      </div>
    ) : (
      <div class="space-y-4" id="ticketList">
        {withUrls.map((r) => (
          <article
            class="ticket-card rounded-2xl border border-slate-200 bg-white p-5 sm:p-6 shadow-xs"
            data-status={r.status}
          >
            <!-- Card Header -->
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 border-b border-slate-100 pb-4">
              <div class="flex items-center gap-3">
                <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-slate-100 text-slate-700 shrink-0">
                  <Icon name={r.category === 'plumbing' ? 'plumbing' : r.category === 'electrical' ? 'electrical' : r.category === 'furniture' ? 'furniture' : r.category === 'internet' ? 'internet' : 'wrench'} size={20} />
                </div>
                <div>
                  <div class="flex items-center gap-2">
                    <span class="font-bold text-sm sm:text-base text-slate-900 capitalize">{r.category}</span>
                    <span class="text-xs font-medium text-slate-400">#MN-{r.id.slice(0, 8)}</span>
                  </div>
                  <span class="text-[11px] text-slate-400 block mt-0.5">
                    Submitted {new Date(r.created_at).toLocaleDateString()} at {new Date(r.created_at).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}
                  </span>
                </div>
              </div>

              <div>
                {r.status === 'resolved' ? (
                  <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-50 border border-emerald-200 px-3.5 py-1 text-xs font-semibold text-emerald-800">
                    <Icon name="check-circle" size={14} class="text-emerald-600" /> Resolved
                  </span>
                ) : r.status === 'in_progress' ? (
                  <span class="inline-flex items-center gap-1.5 rounded-full bg-blue-50 border border-blue-200 px-3.5 py-1 text-xs font-semibold text-blue-800">
                    <Icon name="clock" size={14} class="text-blue-600" /> In Progress
                  </span>
                ) : (
                  <span class="inline-flex items-center gap-1.5 rounded-full bg-amber-50 border border-amber-200 px-3.5 py-1 text-xs font-semibold text-amber-800">
                    <Icon name="clock" size={14} class="text-amber-600" /> Pending Triage
                  </span>
                )}
              </div>
            </div>

            <!-- 4-Step Progress Tracker -->
            <div class="mt-4 pt-1">
              <div class="grid grid-cols-4 gap-2 text-center text-[11px]">
                <div class="flex flex-col items-center">
                  <div class="h-2 w-full rounded-full bg-blue-600 mb-1.5"></div>
                  <span class="font-semibold text-slate-800">Submitted</span>
                </div>
                <div class="flex flex-col items-center">
                  <div class={`h-2 w-full rounded-full mb-1.5 ${r.status !== 'pending' ? 'bg-blue-600' : 'bg-slate-200'}`}></div>
                  <span class={`font-semibold ${r.status !== 'pending' ? 'text-slate-800' : 'text-slate-400'}`}>Triaged</span>
                </div>
                <div class="flex flex-col items-center">
                  <div class={`h-2 w-full rounded-full mb-1.5 ${r.status === 'in_progress' || r.status === 'resolved' ? 'bg-blue-600' : 'bg-slate-200'}`}></div>
                  <span class={`font-semibold ${r.status === 'in_progress' || r.status === 'resolved' ? 'text-slate-800' : 'text-slate-400'}`}>Dispatched</span>
                </div>
                <div class="flex flex-col items-center">
                  <div class={`h-2 w-full rounded-full mb-1.5 ${r.status === 'resolved' ? 'bg-emerald-500' : 'bg-slate-200'}`}></div>
                  <span class={`font-semibold ${r.status === 'resolved' ? 'text-emerald-700' : 'text-slate-400'}`}>Resolved</span>
                </div>
              </div>
            </div>

            <!-- Description Body -->
            <p class="mt-4 text-xs sm:text-sm text-slate-700 leading-relaxed">{r.description}</p>

            <!-- Staff / Technician Feedback Note -->
            {r.staff_note && (
              <div class="mt-4 rounded-xl border border-blue-200 bg-blue-50/70 p-3.5 text-xs text-blue-950">
                <span class="font-bold uppercase tracking-wider text-blue-900 block text-[10px] mb-0.5">Technician / Housing Note:</span>
                <p class="font-medium leading-relaxed">{r.staff_note}</p>
              </div>
            )}

            <!-- Attached Inspection Photo -->
            {r.url && (
              <div class="mt-4 pt-3 border-t border-slate-100">
                <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider block mb-2">Attached Fault Inspection Photo</span>
                <a href={r.url} target="_blank" rel="noopener noreferrer" class="inline-block group">
                  <img
                    src={r.url}
                    alt="Fault inspection documentation"
                    class="h-32 sm:h-40 w-auto max-w-sm object-cover rounded-xl border border-slate-200 shadow-xs group-hover:opacity-95 transition"
                  />
                </a>
              </div>
            )}
          </article>
        ))}
      </div>
    )}
  </div>

  <!-- Client-side Interactive Filter Script -->
  <script>
    const filterContainer = document.getElementById('filterChips');
    const ticketCards = document.querySelectorAll('.ticket-card');

    if (filterContainer && ticketCards.length > 0) {
      const chips = filterContainer.querySelectorAll('.filter-chip');
      chips.forEach((chip) => {
        chip.addEventListener('click', () => {
          const filter = chip.getAttribute('data-filter');
          chips.forEach((c) => {
            c.classList.remove('bg-slate-900', 'text-white');
            c.classList.add('bg-slate-100', 'text-slate-600');
          });
          chip.classList.add('bg-slate-900', 'text-white');
          chip.classList.remove('bg-slate-100', 'text-slate-600');

          ticketCards.forEach((card) => {
            const status = card.getAttribute('data-status');
            if (filter === 'all' || status === filter) {
              (card as HTMLElement).style.display = 'block';
            } else {
              (card as HTMLElement).style.display = 'none';
            }
          });
        });
      });
    }
  </script>
</Layout>
