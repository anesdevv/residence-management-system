---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import PageHeader from '../../components/PageHeader.astro';
import StatusPill from '../../components/StatusPill.astro';
import Stepper from '../../components/Stepper.astro';
import InlineBanner from '../../components/InlineBanner.astro';
import EmptyState from '../../components/EmptyState.astro';
import { createSupabaseServerClient } from '../../lib/supabase';
import { getStageIndex, MAINTENANCE_CATEGORIES, getCategoryMeta } from '../../lib/maintenance';
import { t, tn, formatDateTime, type SupportedLocale } from '../../lib/i18n';

export const prerender = false;
const locale: SupportedLocale = Astro.locals.locale || 'en';

const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);
const uid = Astro.locals.user!.id;

let reports: any[] = [];
let student: any = null;
let queryError: string | null = null;
let partialReportsError: string | null = null;
let partialStudentError: string | null = null;

try {
  const [repRes, stuRes] = await Promise.allSettled([
    supabase
      .from('maintenance_reports')
      .select('id, category, description, status, staff_note, photo_path, created_at')
      .eq('student_id', uid)
      .order('created_at', { ascending: false }),
    supabase
      .from('students')
      .select('status, room_id, rooms(block, number)')
      .eq('id', uid)
      .single(),
  ]);

  if (repRes.status === 'fulfilled') {
    if (repRes.value.error) {
      partialReportsError = repRes.value.error.message;
    } else {
      reports = repRes.value.data ?? [];
    }
  } else {
    partialReportsError = repRes.reason?.message || 'Failed to load maintenance tickets.';
  }

  if (stuRes.status === 'fulfilled') {
    if (stuRes.value.error) {
      partialStudentError = stuRes.value.error.message;
    } else {
      student = stuRes.value.data;
    }
  } else {
    partialStudentError = stuRes.reason?.message || 'Failed to verify residency status.';
  }

  if (partialReportsError && partialStudentError) {
    queryError = partialReportsError;
  }
} catch (err: any) {
  queryError = err?.message || 'The server is taking too long to respond. Check your connection and try again.';
}

const isActive = student?.status === 'active';

const totalCount = (reports ?? []).length;
const pendingCount = (reports ?? []).filter((r: any) => r.status === 'pending' || r.status === 'under_review').length;
const inProgressCount = (reports ?? []).filter((r: any) => r.status === 'in_progress').length;
const resolvedCount = (reports ?? []).filter((r: any) => r.status === 'resolved').length;

const error = Astro.url.searchParams.get('error');
const created = Astro.url.searchParams.get('created');

const categories = [...MAINTENANCE_CATEGORIES];

const STAGES = [t(locale, 'status.pending'), t(locale, 'status.in_progress'), t(locale, 'status.resolved')];
---

<Layout title={locale === 'fr' ? 'Maintenance des Bâtiments | RÉSIVO' : 'Facility Maintenance | RÉSIVO'} activeNav="maintenance">
  <PageHeader
    title={t(locale, 'maintenance.title')}
    subtitle={t(locale, 'maintenance.subtitle')}
  />

  <!-- Metric Strip -->
  <div class="flex flex-wrap items-center justify-between gap-3 p-3.5 sm:px-5 rounded-card border border-line bg-surface mb-6">
    <div class="flex items-center gap-2 text-small font-medium text-ink">
      <span class="flex h-7 w-7 items-center justify-center rounded-input bg-teal-600/10 text-teal-600">
        <Icon name="wrench" size={15} />
      </span>
      <span>{locale === 'fr' ? 'Dossier technique de la chambre' : 'Dormitory Technical Records'}</span>
    </div>
    <div class="flex items-center gap-3 sm:gap-5 text-small tnum">
      <span class="text-muted">
        {locale === 'fr' ? 'Total :' : 'Total:'} <strong class="text-ink font-semibold">{totalCount}</strong>
      </span>
      <span class="text-pending font-medium">
        {t(locale, 'maintenance.stat_pending')} : <strong class="font-semibold">{pendingCount}</strong>
      </span>
      <span class="text-teal-600 font-medium">
        {t(locale, 'maintenance.stat_resolved')} : <strong class="font-semibold">{resolvedCount}</strong>
      </span>
    </div>
  </div>

  <!-- Feedback Alerts -->
  {created && (
    <InlineBanner kind="success" title={t(locale, 'maintenance.ticket_dispatched_title')} class="mb-6">
      {t(locale, 'maintenance.ticket_dispatched_desc')}
    </InlineBanner>
  )}

  {queryError && (
    <InlineBanner kind="error" title={t(locale, 'errors.connection_error')} class="mb-6">
      {queryError}
    </InlineBanner>
  )}

  {partialReportsError && !queryError && (
    <InlineBanner kind="warning" title={t(locale, 'maintenance.tickets_unavailable_title')} class="mb-6">
      {partialReportsError}
    </InlineBanner>
  )}

  {partialStudentError && !queryError && (
    <InlineBanner kind="warning" title={t(locale, 'maintenance.residency_unavailable_title')} class="mb-6">
      {partialStudentError}
    </InlineBanner>
  )}

  {error && (
    <InlineBanner kind="error" title={t(locale, 'common.error')} class="mb-6">
      {error}
    </InlineBanner>
  )}

  <!-- Locked State or Submission Form -->
  {!isActive ? (
    <div class="flex flex-col gap-6 mb-8">
      <InlineBanner kind="warning" title={t(locale, 'maintenance.reporting_locked_title')} icon="lock">
        {locale === 'fr'
          ? `Le statut de votre dossier est ${student?.status ?? 'en attente'}. Les déclarations d'intervention technique sont strictement réservées aux étudiants affectés à une chambre. Dès que votre dossier sera validé, vous pourrez déclarer des pannes ici.`
          : `Your account status is ${student?.status ?? 'pending'}. Maintenance requests are strictly tied to an officially assigned dormitory room. Once your housing registration is verified and approved, you will be able to file repair tickets here.`}
      </InlineBanner>

      <!-- Emergency Hotline (Always accessible) -->
      <div class="rounded-card border border-pending-line bg-pending-bg p-4 sm:p-5 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div class="flex items-start gap-3">
          <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-input bg-surface text-pending">
            <Icon name="alert-triangle" size={20} />
          </span>
          <div>
            <h2 class="text-body font-semibold text-pending">{t(locale, 'maintenance.emergency_title')}</h2>
            <p class="text-small text-ink-2 mt-0.5">{t(locale, 'maintenance.emergency_desc')}</p>
          </div>
        </div>
        <a href="tel:+21343210000" class="btn btn-sm btn-secondary shrink-0 min-h-[44px] whitespace-nowrap" dir="ltr">
          <Icon name="phone" size={14} class="rtl-mirror shrink-0" />
          <span class="tnum font-mono">+213 (0) 43 21 00 00</span>
        </a>
      </div>
    </div>
  ) : (
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-start mb-8">
      <!-- Left: Ticket Submission Form -->
      <section class="card p-4 sm:p-6 lg:col-span-8">
        <header class="border-b border-line pb-4 mb-6">
          <h2 class="card-title">{t(locale, 'maintenance.new_ticket_header')}</h2>
          <p class="text-small font-normal text-muted mt-1">{t(locale, 'maintenance.new_ticket_subtitle')}</p>
        </header>

        <form method="POST" action="/api/maintenance" enctype="multipart/form-data" class="flex flex-col gap-6">
          <!-- Category Radio Picker (4 equal-height categories) -->
          <fieldset class="flex flex-col gap-2 border-0 p-0 m-0">
            <legend class="label">{t(locale, 'maintenance.fault_category_legend')} <span class="text-danger" aria-hidden="true">*</span></legend>
            <div class="grid grid-cols-2 gap-2.5 sm:gap-3 sm:grid-cols-4">
              {categories.map((c, i) => (
                <label class="cursor-pointer h-full">
                  <input
                    type="radio"
                    name="category"
                    value={c.id}
                    required
                    checked={i === 0}
                    class="peer sr-only"
                  />
                  <div class="flex h-full flex-col items-center justify-center p-3 text-center rounded-input border border-line bg-subtle hover:bg-canvas peer-checked:border-teal-600 peer-checked:bg-teal-600/5 peer-checked:text-teal-600 transition-colors min-h-[96px]">
                    <Icon name={c.icon} size={22} class="text-ink-2 peer-checked:text-teal-600" />
                    <span class="mt-2 text-small font-semibold text-ink">{t(locale, 'category.' + c.id)}</span>
                    <span class="mt-0.5 text-small text-muted hidden sm:block">{c.desc}</span>
                  </div>
                </label>
              ))}
            </div>
          </fieldset>

          <!-- Description -->
          <div class="flex flex-col gap-2">
            <label for="description" class="label">{t(locale, 'maintenance.description_label_detailed')} <span class="text-danger" aria-hidden="true">*</span></label>
            <textarea
              name="description"
              id="description"
              required
              minlength="5"
              rows="3"
              placeholder={t(locale, 'maintenance.description_placeholder_detailed')}
              class="input min-h-[96px]"
            ></textarea>
          </div>

          <!-- Photo Upload Box with Preview -->
          <div class="flex flex-col gap-2">
            <label for="photo" class="label">{t(locale, 'maintenance.photo_optional_label')}</label>
            <div class="rounded-input border border-dashed border-line bg-subtle p-4 sm:p-5 flex flex-col items-center justify-center gap-2">
              <Icon name="image" size={24} class="text-muted" />
              <input
                type="file"
                name="photo"
                id="photo"
                accept="image/*"
                class="block w-full text-small text-muted file:me-4 file:py-2 file:px-4 file:rounded-input file:border-0 file:text-small file:font-semibold file:bg-navy-800 file:text-surface hover:file:bg-navy-700 cursor-pointer min-h-[44px]"
              />
              <p class="field-hint text-center">{t(locale, 'maintenance.photo_hint_detailed')}</p>
              <div id="photoStatus" class="hidden flex items-center gap-2 text-small text-teal-600 font-medium py-1">
                <Icon name="spinner" size={16} class="motion-safe:animate-spin shrink-0" />
                <span>{t(locale, 'maintenance.photo_optimizing')}</span>
              </div>
              <div id="photoError" class="hidden text-small text-danger font-medium py-1"></div>
              <div id="photoPreview" class="hidden mt-2 flex flex-col items-center gap-1.5">
                <img id="previewImg" src="" alt="Photo preview" class="max-h-48 rounded-input border border-line object-cover" />
                <span id="photoSizeBadge" class="text-small text-muted bg-canvas border border-line px-2.5 py-0.5 rounded-pill font-mono"></span>
              </div>
            </div>
          </div>

          <!-- Submit Button -->
          <div>
            <button type="submit" class="btn btn-primary min-h-[44px] whitespace-nowrap">
              <Icon name="check-circle" size={18} />
              <span>{t(locale, 'maintenance.submit_btn')}</span>
            </button>
          </div>
        </form>
      </section>

      <!-- Right Sidebar: Emergency Hotline & Guidelines -->
      <aside class="flex flex-col gap-5 lg:col-span-4">
        <!-- Emergency Hotline Callout Card -->
        <div class="rounded-card border border-pending-line bg-pending-bg p-5 flex flex-col gap-3">
          <div class="flex items-center gap-2.5 text-pending font-semibold">
            <Icon name="alert-triangle" size={18} />
            <h2 class="text-body font-semibold">{t(locale, 'maintenance.emergency_title')}</h2>
          </div>
          <p class="text-small text-ink-2 leading-relaxed">
            {t(locale, 'maintenance.emergency_desc')}
          </p>
          <p class="text-small font-medium text-ink">
            {t(locale, 'maintenance.emergency_hotline')}
          </p>
          <div>
            <a
              href="tel:+21343210000"
              class="btn btn-sm btn-secondary w-full justify-center min-h-[44px] whitespace-nowrap"
              dir="ltr"
            >
              <Icon name="phone" size={14} class="rtl-mirror shrink-0" />
              <span class="tnum font-mono font-medium">+213 (0) 43 21 00 00</span>
            </a>
          </div>
        </div>

        <!-- Intervention Notice Card -->
        <div class="card p-5 flex flex-col gap-2.5 text-small text-muted">
          <div class="flex items-center gap-2 text-ink font-semibold">
            <Icon name="info" size={16} class="text-teal-600" />
            <span>{locale === 'fr' ? 'Accès des techniciens' : 'Technician Access'}</span>
          </div>
          <p class="leading-relaxed">
            {locale === 'fr'
              ? 'Les interventions ont lieu durant les heures de bureau (08h30 à 16h00). Assurez-vous de libérer l’accès à la zone d’intervention dans votre chambre.'
              : 'Technical teams inspect and repair during standard service hours (08:30 to 16:00). Please ensure clear access to the affected fixture.'}
          </p>
        </div>
      </aside>
    </div>
  )}

  <!-- History Section with Filter Controls -->
  <div class="flex flex-col gap-4">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 border-b border-line pb-4">
      <div>
        <h2 class="font-display text-h2 text-ink">{t(locale, 'maintenance.history_title')}</h2>
        <p class="text-small text-muted mt-0.5">{tn(locale, 'maintenance.filed_count', totalCount)}</p>
      </div>

      <!-- Filter Chips -->
      <div class="seg overflow-x-auto max-w-full" id="filterChips" role="group" aria-label={locale === 'fr' ? 'Filtrer les signalements par statut' : 'Filter tickets by status'}>
        <button
          type="button"
          data-filter="all"
          aria-pressed="true"
          class="filter-chip seg-item whitespace-nowrap"
        >
          {t(locale, 'maintenance.filter_all', { count: totalCount })}
        </button>
        <button
          type="button"
          data-filter="pending"
          aria-pressed="false"
          class="filter-chip seg-item whitespace-nowrap"
        >
          {t(locale, 'maintenance.filter_pending', { count: pendingCount })}
        </button>
        <button
          type="button"
          data-filter="in_progress"
          aria-pressed="false"
          class="filter-chip seg-item whitespace-nowrap"
        >
          {t(locale, 'maintenance.filter_in_progress', { count: inProgressCount })}
        </button>
        <button
          type="button"
          data-filter="resolved"
          aria-pressed="false"
          class="filter-chip seg-item whitespace-nowrap"
        >
          {t(locale, 'maintenance.filter_resolved', { count: resolvedCount })}
        </button>
      </div>
    </div>

    {(reports ?? []).length === 0 ? (
      <EmptyState
        icon="wrench"
        title={t(locale, 'maintenance.empty_title')}
        message={t(locale, 'maintenance.empty_desc')}
      />
    ) : (
      <div class="flex flex-col gap-4" id="ticketList">
        {(reports ?? []).map((r: any) => {
          const catSpec = getCategoryMeta(r.category);
          const stageIdx = getStageIndex(r.status);
          const normStatus = r.status === 'under_review' ? 'pending' : r.status;
          const statusKind = normStatus === 'resolved' ? 'ok' : normStatus === 'in_progress' ? 'progress' : 'pending';
          const statusLabel = normStatus === 'resolved' ? t(locale, 'status.resolved') : normStatus === 'in_progress' ? t(locale, 'status.in_progress') : t(locale, 'status.pending');
          return (
            <article class="ticket-card card p-4 sm:p-6" data-status={normStatus}>
              <!-- Card Header -->
              <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 border-b border-line pb-4">
                <div class="flex items-center gap-3">
                  <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-input bg-subtle text-teal-600">
                    <Icon name={catSpec.icon} size={20} />
                  </span>
                  <div>
                    <div class="flex items-center gap-2">
                      <h3 class="font-display text-h3 text-ink">{t(locale, 'category.' + catSpec.id)}</h3>
                      <span class="text-small font-normal text-muted tnum">#MN-{r.id.slice(0, 8)}</span>
                    </div>
                    <p class="text-small font-normal text-muted mt-0.5">
                      {formatDateTime(locale, r.created_at)}
                    </p>
                  </div>
                </div>

                <div>
                  <StatusPill kind={statusKind} label={statusLabel} />
                </div>
              </div>

              <!-- 3-Step Stepper -->
              <div class="mt-4 pt-2">
                <Stepper steps={STAGES} current={stageIdx} />
              </div>

              <!-- Description Body -->
              <p class="mt-4 text-body text-ink leading-relaxed">{r.description}</p>

              <!-- Staff / Technician Feedback Note -->
              {r.staff_note && (
                <div class="mt-4 rounded-input border border-line bg-subtle p-3.5">
                  <span class="block text-small font-semibold text-muted mb-1">{t(locale, 'maintenance.technician_note_title')}</span>
                  <p class="text-small font-normal text-ink leading-relaxed">{r.staff_note}</p>
                </div>
              )}

              <!-- Attached Inspection Photo (Lazy Loaded with Fixed Aspect Ratio for CLS = 0) -->
              {r.photo_path && (
                <div class="mt-4 pt-3 border-t border-line">
                  <span class="block text-small font-semibold text-muted mb-2">{t(locale, 'maintenance.photo_inspection_title')}</span>
                  <div
                    class="photo-lazy-container relative w-full max-w-sm aspect-[16/10] rounded-input border border-line bg-subtle overflow-hidden"
                    data-photo-path={r.photo_path}
                  >
                    <div class="photo-skeleton skeleton absolute inset-0 flex items-center justify-center text-muted" aria-hidden="true">
                      <Icon name="image" size={24} class="opacity-50" />
                    </div>
                    <a href="#" target="_blank" rel="noopener noreferrer" class="photo-link hidden group block w-full h-full">
                      <img
                        src=""
                        alt="Fault inspection documentation"
                        width="384"
                        height="160"
                        class="h-full w-full object-cover group-hover:opacity-90 transition-opacity"
                        loading="lazy"
                        decoding="async"
                      />
                    </a>
                  </div>
                </div>
              )}
            </article>
          );
        })}
        <div id="filterEmptyState" class="hidden card card-flat p-8 text-center text-small text-muted">
          {locale === 'fr' ? 'Aucun signalement ne correspond à ce statut.' : 'No maintenance tickets match this status.'}
        </div>
      </div>
    )}
  </div>

  <!-- Interactive Scripts -->
  <script>
    import { optimizePhotoFile, formatFileSize } from '../../lib/photo-optimizer';

    // 1. Photo optimization & client-side preview
    const fileInput = document.getElementById('photo') as HTMLInputElement | null;
    const previewDiv = document.getElementById('photoPreview');
    const previewImg = document.getElementById('previewImg') as HTMLImageElement | null;
    const photoStatus = document.getElementById('photoStatus');
    const photoError = document.getElementById('photoError');
    const photoSizeBadge = document.getElementById('photoSizeBadge');
    const submitBtn = document.querySelector('button[type="submit"]') as HTMLButtonElement | null;

    let currentObjectUrl: string | null = null;

    if (fileInput) {
      fileInput.addEventListener('change', async () => {
        const file = fileInput.files?.[0];
        if (photoError) photoError.classList.add('hidden');

        if (!file) {
          if (previewDiv) previewDiv.classList.add('hidden');
          if (photoStatus) photoStatus.classList.add('hidden');
          if (currentObjectUrl) {
            URL.revokeObjectURL(currentObjectUrl);
            currentObjectUrl = null;
          }
          return;
        }

        // Show optimizing indicator & disable submit button
        if (photoStatus) photoStatus.classList.remove('hidden');
        if (previewDiv) previewDiv.classList.add('hidden');
        if (submitBtn) submitBtn.disabled = true;

        try {
          const result = await optimizePhotoFile(file, {
            maxSide: 1600,
            targetBytes: 500 * 1024,
            initialQuality: 0.82,
            minQuality: 0.60,
          });

          // Replace input file with optimized file using DataTransfer
          try {
            const dt = new DataTransfer();
            dt.items.add(result.file);
            fileInput.files = dt.files;
          } catch {
            // DataTransfer fallback
          }

          if (currentObjectUrl) {
            URL.revokeObjectURL(currentObjectUrl);
          }
          currentObjectUrl = URL.createObjectURL(result.file);

          if (previewImg && previewDiv) {
            previewImg.src = currentObjectUrl;
            previewDiv.classList.remove('hidden');
          }

          if (photoSizeBadge) {
            if (!result.fallback && result.optimizedSize < result.originalSize) {
              const pct = Math.round((1 - result.optimizedSize / result.originalSize) * 100);
              photoSizeBadge.textContent = `${formatFileSize(result.originalSize)} → ${formatFileSize(result.optimizedSize)} (${pct}% smaller)`;
            } else {
              photoSizeBadge.textContent = formatFileSize(result.optimizedSize);
            }
          }
        } catch (err: any) {
          if (file.size <= 4 * 1024 * 1024) {
            // Fall back to original file if within 4MB limit
            if (currentObjectUrl) URL.revokeObjectURL(currentObjectUrl);
            currentObjectUrl = URL.createObjectURL(file);
            if (previewImg && previewDiv) {
              previewImg.src = currentObjectUrl;
              previewDiv.classList.remove('hidden');
            }
            if (photoSizeBadge) {
              photoSizeBadge.textContent = formatFileSize(file.size);
            }
          } else {
            fileInput.value = '';
            if (photoError) {
              photoError.textContent = err?.message || 'Could not process photo and file exceeds 4MB limit.';
              photoError.classList.remove('hidden');
            }
          }
        } finally {
          if (photoStatus) photoStatus.classList.add('hidden');
          if (submitBtn) submitBtn.disabled = false;
        }
      });
    }

    // 2. Client-side signed URL cache & IntersectionObserver for photos
    const SIGNED_URL_CACHE = new Map<string, { url: string; expiresAt: number }>();

    async function getPhotoUrl(path: string): Promise<string | null> {
      const cached = SIGNED_URL_CACHE.get(path);
      if (cached && Date.now() < cached.expiresAt - 60_000) {
        return cached.url;
      }
      try {
        const res = await fetch(`/api/photo-url?path=${encodeURIComponent(path)}`);
        if (!res.ok) return null;
        const data = await res.json();
        if (data.url) {
          SIGNED_URL_CACHE.set(path, {
            url: data.url,
            expiresAt: data.expiresAt || Date.now() + 3600_000,
          });
          return data.url;
        }
      } catch {
        // Network or JSON parse error
      }
      return null;
    }

    const photoContainers = document.querySelectorAll<HTMLElement>('.photo-lazy-container');
    if (photoContainers.length > 0) {
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries, obs) => {
          entries.forEach(async (entry) => {
            if (entry.isIntersecting) {
              const container = entry.target as HTMLElement;
              obs.unobserve(container);
              const path = container.getAttribute('data-photo-path');
              if (!path) return;
              const url = await getPhotoUrl(path);
              const link = container.querySelector<HTMLAnchorElement>('.photo-link');
              const img = container.querySelector<HTMLImageElement>('img');
              const skeleton = container.querySelector<HTMLElement>('.photo-skeleton');
              if (url && link && img) {
                link.href = url;
                img.src = url;
                img.onload = () => {
                  link.classList.remove('hidden');
                  if (skeleton) skeleton.classList.add('hidden');
                };
                img.onerror = () => {
                  if (skeleton) {
                    skeleton.classList.remove('skeleton');
                    skeleton.innerHTML = '<span class="text-small text-muted">Failed to load photo</span>';
                  }
                };
              } else if (skeleton) {
                skeleton.classList.remove('skeleton');
                skeleton.innerHTML = '<span class="text-small text-muted">Photo unavailable</span>';
              }
            }
          });
        }, { rootMargin: '200px 0px' });

        photoContainers.forEach((el) => observer.observe(el));
      } else {
        // Fallback for browsers without IntersectionObserver
        photoContainers.forEach(async (container) => {
          const path = container.getAttribute('data-photo-path');
          if (!path) return;
          const url = await getPhotoUrl(path);
          const link = container.querySelector<HTMLAnchorElement>('.photo-link');
          const img = container.querySelector<HTMLImageElement>('img');
          const skeleton = container.querySelector<HTMLElement>('.photo-skeleton');
          if (url && link && img) {
            link.href = url;
            img.src = url;
            link.classList.remove('hidden');
            if (skeleton) skeleton.classList.add('hidden');
          }
        });
      }
    }

    // 3. Filter chips handling
    const filterContainer = document.getElementById('filterChips');
    const ticketCards = document.querySelectorAll('.ticket-card');
    const filterEmptyState = document.getElementById('filterEmptyState');

    function applyFilter(filter: string) {
      if (!filterContainer) return;
      const chips = filterContainer.querySelectorAll('.filter-chip');
      chips.forEach((c) => {
        const isActive = c.getAttribute('data-filter') === filter;
        c.setAttribute('aria-pressed', isActive ? 'true' : 'false');
      });

      let visibleCount = 0;
      ticketCards.forEach((card) => {
        const status = card.getAttribute('data-status');
        const show = filter === 'all' || status === filter;
        card.classList.toggle('hidden', !show);
        if (show) visibleCount++;
      });

      if (filterEmptyState) {
        filterEmptyState.classList.toggle('hidden', visibleCount > 0 || ticketCards.length === 0);
      }
    }

    if (filterContainer && ticketCards.length > 0) {
      const chips = filterContainer.querySelectorAll('.filter-chip');
      const initialStatus = new URLSearchParams(window.location.search).get('status');
      const validFilters = new Set(Array.from(chips).map((c) => c.getAttribute('data-filter')));
      if (initialStatus && validFilters.has(initialStatus)) {
        applyFilter(initialStatus);
      }

      chips.forEach((chip) => {
        chip.addEventListener('click', () => {
          const filter = chip.getAttribute('data-filter') || 'all';
          applyFilter(filter);
          try {
            const url = new URL(window.location.href);
            if (filter === 'all') {
              url.searchParams.delete('status');
            } else {
              url.searchParams.set('status', filter);
            }
            window.history.replaceState({}, '', url.toString());
          } catch {
            // URL sync best-effort
          }
        });
      });
    }
  </script>
</Layout>
