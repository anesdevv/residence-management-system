---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import PageHeader from '../../components/PageHeader.astro';
import StatusPill from '../../components/StatusPill.astro';
import Stepper from '../../components/Stepper.astro';
import InlineBanner from '../../components/InlineBanner.astro';
import EmptyState from '../../components/EmptyState.astro';
import StatCard from '../../components/StatCard.astro';
import { createSupabaseServerClient } from '../../lib/supabase';
import { MAINTENANCE_STAGES, getStageIndex, MAINTENANCE_CATEGORIES, getCategoryMeta, batchResolveSignedUrls } from '../../lib/maintenance';
import { localizePath, t, type SupportedLocale } from '../../lib/i18n';

export const prerender = false;
const locale: SupportedLocale = Astro.locals.locale || 'en';

const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);
const uid = Astro.locals.user!.id;

let reports: any[] = [];
let student: any = null;
let queryError: string | null = null;
let partialReportsError: string | null = null;
let partialStudentError: string | null = null;

try {
  const [repRes, stuRes] = await Promise.allSettled([
    supabase
      .from('maintenance_reports')
      .select('id, category, description, status, staff_note, photo_path, created_at')
      .eq('student_id', uid)
      .order('created_at', { ascending: false }),
    supabase
      .from('students')
      .select('status, room_id, rooms(block, number)')
      .eq('id', uid)
      .single(),
  ]);

  if (repRes.status === 'fulfilled') {
    if (repRes.value.error) {
      partialReportsError = repRes.value.error.message;
    } else {
      reports = repRes.value.data ?? [];
    }
  } else {
    partialReportsError = repRes.reason?.message || 'Failed to load maintenance tickets.';
  }

  if (stuRes.status === 'fulfilled') {
    if (stuRes.value.error) {
      partialStudentError = stuRes.value.error.message;
    } else {
      student = stuRes.value.data;
    }
  } else {
    partialStudentError = stuRes.reason?.message || 'Failed to verify residency status.';
  }

  if (partialReportsError && partialStudentError) {
    queryError = partialReportsError;
  }
} catch (err: any) {
  queryError = err?.message || 'The server is taking too long to respond. Check your connection and try again.';
}

const isActive = student?.status === 'active';

const totalCount = (reports ?? []).length;
const pendingCount = (reports ?? []).filter((r: any) => r.status === 'pending' || r.status === 'under_review').length;
const inProgressCount = (reports ?? []).filter((r: any) => r.status === 'in_progress').length;
const resolvedCount = (reports ?? []).filter((r: any) => r.status === 'resolved').length;

const error = Astro.url.searchParams.get('error');
const created = Astro.url.searchParams.get('created');

const categories = [...MAINTENANCE_CATEGORIES];

const STAGES = [...MAINTENANCE_STAGES];
---

<Layout title={locale === 'fr' ? 'Maintenance des Bâtiments — RÉSIVO' : 'Facility Maintenance — RÉSIVO'} activeNav="maintenance">
  <PageHeader
    title={t(locale, 'maintenance.title')}
    overline="Cité Universitaire Tlemcen"
    subtitle={t(locale, 'maintenance.subtitle')}
  >
    <Fragment slot="actions">
      <a href={localizePath(locale, '/dashboard')} class="btn btn-secondary">
        <Icon name="arrow-left" size={16} />
        <span>{t(locale, 'common.back')}</span>
      </a>
    </Fragment>
  </PageHeader>

  <!-- Emergency Assistance Banner -->
  <InlineBanner kind="warning" title="Urgent hazard or major water leak?" icon="alert-triangle" class="mb-6">
    Contact the campus security desk immediately for on-duty technician emergency response.
    <div slot="actions">
      <a href="tel:+21343210000" class="btn btn-sm btn-secondary">
        <Icon name="phone" size={14} />
        <span>24/7 Hotline</span>
      </a>
    </div>
  </InlineBanner>

  <!-- Metric Strip -->
  <div class="grid grid-cols-2 gap-4 sm:grid-cols-4 mb-6">
    <StatCard label="Total tickets" value={totalCount} icon="wrench" accent="navy" />
    <StatCard label="Pending triage" value={pendingCount} icon="clock" accent="gold" />
    <StatCard label="In progress" value={inProgressCount} icon="hammer" accent="teal" />
    <StatCard label="Resolved" value={resolvedCount} icon="check-circle" accent="teal" />
  </div>

  <!-- Feedback Alerts -->
  {created && (
    <InlineBanner kind="success" title="Maintenance ticket dispatched!" class="mb-6">
      Your report has been queued for housing facility technicians. You can follow progress in your ticket history below.
    </InlineBanner>
  )}

  {queryError && (
    <InlineBanner kind="error" title="Connection error" class="mb-6">
      {queryError}
    </InlineBanner>
  )}

  {partialReportsError && !queryError && (
    <InlineBanner kind="warning" title="Ticket history unavailable" class="mb-6">
      {partialReportsError}
    </InlineBanner>
  )}

  {partialStudentError && !queryError && (
    <InlineBanner kind="warning" title="Residency verification unavailable" class="mb-6">
      {partialStudentError}
    </InlineBanner>
  )}

  {error && (
    <InlineBanner kind="error" title="Unable to submit report" class="mb-6">
      {error}
    </InlineBanner>
  )}

  <!-- Locked State or Submission Form -->
  {!isActive ? (
    <InlineBanner kind="warning" title="Maintenance reporting locked" icon="lock" class="mb-8">
      Your account status is <strong class="uppercase">{student?.status ?? 'pending'}</strong>.
      Maintenance requests are strictly tied to an officially assigned dormitory room. Once your housing registration is verified and approved, you will be able to file repair tickets here.
    </InlineBanner>
  ) : (
    <section class="card p-4 sm:p-6 mb-8">
      <header class="border-b border-line pb-4 mb-6">
        <h2 class="card-title">Submit a new maintenance ticket</h2>
        <p class="text-small font-normal text-muted mt-1">Select the affected category and provide specific details for rapid dispatch.</p>
      </header>

      <form method="POST" action="/api/maintenance" enctype="multipart/form-data" class="flex flex-col gap-6">
        <!-- Category Radio Picker -->
        <fieldset class="flex flex-col gap-2 border-0 p-0 m-0">
          <legend class="label">Fault category <span class="text-danger" aria-hidden="true">*</span></legend>
          <div class="grid grid-cols-2 gap-3 sm:grid-cols-5">
            {categories.map((c, i) => (
              <label class="cursor-pointer">
                <input
                  type="radio"
                  name="category"
                  value={c.id}
                  required
                  checked={i === 0}
                  class="peer sr-only"
                />
                <div class="flex flex-col items-center justify-center p-3.5 text-center rounded-card border border-line bg-subtle hover:bg-canvas peer-checked:border-teal-600 peer-checked:bg-teal-600/5 peer-checked:text-teal-600 transition min-h-[96px]">
                  <Icon name={c.icon} size={22} class="text-muted peer-checked:text-teal-600" />
                  <span class="mt-2 text-small font-semibold text-ink">{c.label}</span>
                  <span class="mt-0.5 text-small text-muted hidden sm:block">{c.desc}</span>
                </div>
              </label>
            ))}
          </div>
        </fieldset>

        <!-- Description -->
        <div class="flex flex-col gap-2">
          <label for="description" class="label">Detailed issue description <span class="text-danger" aria-hidden="true">*</span></label>
          <textarea
            name="description"
            id="description"
            required
            minlength="5"
            rows="3"
            placeholder="Explain the problem clearly (e.g. Bathroom sink faucet leaking steadily, desk drawer handle loose, radiator valve stuck closed)..."
            class="input min-h-[96px]"
          ></textarea>
        </div>

        <!-- Photo Upload Box with Preview -->
        <div class="flex flex-col gap-2">
          <label for="photo" class="label">Attach fault photo (optional)</label>
          <div class="rounded-card border border-dashed border-line bg-subtle p-4 sm:p-5 flex flex-col items-center justify-center gap-2">
            <Icon name="image" size={24} class="text-muted" />
            <input
              type="file"
              name="photo"
              id="photo"
              accept="image/*"
              class="block w-full text-small text-muted file:mr-4 file:py-2 file:px-4 file:rounded-input file:border-0 file:text-small file:font-semibold file:bg-navy-800 file:text-surface hover:file:bg-navy-700 cursor-pointer min-h-[44px]"
            />
            <p class="field-hint text-center">Clear photos help technicians bring the correct tools and replacement parts. PNG or JPEG up to 4MB.</p>
            <div id="photoStatus" class="hidden flex items-center gap-2 text-small text-teal-600 font-medium py-1">
              <span class="inline-block animate-spin font-bold">&#8635;</span>
              <span>Optimizing photo...</span>
            </div>
            <div id="photoError" class="hidden text-small text-danger font-medium py-1"></div>
            <div id="photoPreview" class="hidden mt-2 flex flex-col items-center gap-1.5">
              <img id="previewImg" src="" alt="Photo preview" class="max-h-48 rounded-card border border-line object-cover" />
              <span id="photoSizeBadge" class="text-caption text-muted bg-canvas border border-line px-2.5 py-0.5 rounded-full font-mono"></span>
            </div>
          </div>
        </div>

        <!-- Submit Button -->
        <div>
          <button type="submit" class="btn btn-primary min-h-[44px]">
            <Icon name="check-circle" size={18} />
            <span>Submit maintenance ticket</span>
          </button>
        </div>
      </form>
    </section>
  )}

  <!-- History Section with Filter Controls -->
  <div class="flex flex-col gap-4">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 border-b border-line pb-4">
      <div>
        <h2 class="font-display text-h2 text-ink">Work orders &amp; history</h2>
        <p class="text-small text-muted mt-0.5">{totalCount} ticket{totalCount === 1 ? '' : 's'} filed</p>
      </div>

      <!-- Filter Chips -->
      <div class="flex items-center gap-1.5 overflow-x-auto" id="filterChips" role="group" aria-label="Filter tickets by status">
        <button
          type="button"
          data-filter="all"
          aria-pressed="true"
          class="filter-chip btn btn-sm btn-primary min-h-[40px]"
        >
          All ({totalCount})
        </button>
        <button
          type="button"
          data-filter="pending"
          aria-pressed="false"
          class="filter-chip btn btn-sm btn-secondary min-h-[40px]"
        >
          Pending ({pendingCount})
        </button>
        <button
          type="button"
          data-filter="in_progress"
          aria-pressed="false"
          class="filter-chip btn btn-sm btn-secondary min-h-[40px]"
        >
          In progress ({inProgressCount})
        </button>
        <button
          type="button"
          data-filter="resolved"
          aria-pressed="false"
          class="filter-chip btn btn-sm btn-secondary min-h-[40px]"
        >
          Resolved ({resolvedCount})
        </button>
      </div>
    </div>

    {(reports ?? []).length === 0 ? (
      <EmptyState
        icon="wrench"
        title="No maintenance reports filed"
        message="When you report faults in your dormitory quarters, tickets and progress will be tracked here."
      />
    ) : (
      <div class="flex flex-col gap-4" id="ticketList">
        {(reports ?? []).map((r: any) => {
          const catSpec = getCategoryMeta(r.category);
          const stageIdx = getStageIndex(r.status);
          const normStatus = r.status === 'under_review' ? 'pending' : r.status;
          const statusKind = normStatus === 'resolved' ? 'ok' : normStatus === 'in_progress' ? 'progress' : 'pending';
          const statusLabel = normStatus === 'resolved' ? 'Resolved' : normStatus === 'in_progress' ? 'In progress' : 'Pending';
          return (
            <article class="ticket-card card p-4 sm:p-6" data-status={normStatus}>
              <!-- Card Header -->
              <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 border-b border-line pb-4">
                <div class="flex items-center gap-3">
                  <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-input bg-subtle text-teal-600">
                    <Icon name={catSpec.icon} size={20} />
                  </span>
                  <div>
                    <div class="flex items-center gap-2">
                      <h3 class="font-display text-h3 text-ink">{catSpec.label}</h3>
                      <span class="text-small font-normal text-muted tnum">#MN-{r.id.slice(0, 8)}</span>
                    </div>
                    <p class="text-small font-normal text-muted mt-0.5">
                      Submitted {new Date(r.created_at).toLocaleDateString()} at {new Date(r.created_at).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}
                    </p>
                  </div>
                </div>

                <div>
                  <StatusPill kind={statusKind} label={statusLabel} />
                </div>
              </div>

              <!-- 3-Step Stepper -->
              <div class="mt-4 pt-2">
                <Stepper steps={STAGES} current={stageIdx} />
              </div>

              <!-- Description Body -->
              <p class="mt-4 text-body text-ink leading-relaxed">{r.description}</p>

              <!-- Staff / Technician Feedback Note -->
              {r.staff_note && (
                <div class="mt-4 rounded-card border border-line bg-subtle p-3.5">
                  <span class="overline block text-muted mb-1">Technician / Housing Note</span>
                  <p class="text-small font-normal text-ink leading-relaxed">{r.staff_note}</p>
                </div>
              )}

              <!-- Attached Inspection Photo (Lazy Loaded with Fixed Aspect Ratio for CLS = 0) -->
              {r.photo_path && (
                <div class="mt-4 pt-3 border-t border-line">
                  <span class="overline block text-muted mb-2">Attached Fault Inspection Photo</span>
                  <div
                    class="photo-lazy-container relative w-full max-w-sm aspect-[16/10] rounded-card border border-line bg-subtle overflow-hidden"
                    data-photo-path={r.photo_path}
                  >
                    <div class="photo-skeleton absolute inset-0 flex items-center justify-center text-muted">
                      <Icon name="image" size={24} class="opacity-40 animate-pulse" />
                    </div>
                    <a href="#" target="_blank" rel="noopener noreferrer" class="photo-link hidden group block w-full h-full">
                      <img
                        src=""
                        alt="Fault inspection documentation"
                        width="384"
                        height="160"
                        class="h-full w-full object-cover group-hover:opacity-90 transition"
                        loading="lazy"
                        decoding="async"
                      />
                    </a>
                  </div>
                </div>
              )}
            </article>
          );
        })}
      </div>
    )}
  </div>

  <!-- Interactive Scripts -->
  <script>
    import { optimizePhotoFile, formatFileSize } from '../../lib/photo-optimizer';

    // 1. Photo optimization & client-side preview
    const fileInput = document.getElementById('photo') as HTMLInputElement | null;
    const previewDiv = document.getElementById('photoPreview');
    const previewImg = document.getElementById('previewImg') as HTMLImageElement | null;
    const photoStatus = document.getElementById('photoStatus');
    const photoError = document.getElementById('photoError');
    const photoSizeBadge = document.getElementById('photoSizeBadge');
    const submitBtn = document.querySelector('button[type="submit"]') as HTMLButtonElement | null;

    let currentObjectUrl: string | null = null;

    if (fileInput) {
      fileInput.addEventListener('change', async () => {
        const file = fileInput.files?.[0];
        if (photoError) photoError.classList.add('hidden');

        if (!file) {
          if (previewDiv) previewDiv.classList.add('hidden');
          if (photoStatus) photoStatus.classList.add('hidden');
          if (currentObjectUrl) {
            URL.revokeObjectURL(currentObjectUrl);
            currentObjectUrl = null;
          }
          return;
        }

        // Show optimizing indicator & disable submit button
        if (photoStatus) photoStatus.classList.remove('hidden');
        if (previewDiv) previewDiv.classList.add('hidden');
        if (submitBtn) submitBtn.disabled = true;

        try {
          const result = await optimizePhotoFile(file, {
            maxDimension: 1600,
            maxBytes: 500 * 1024,
            initialQuality: 0.82,
            minQuality: 0.60,
          });

          // Replace input file with optimized file using DataTransfer
          try {
            const dt = new DataTransfer();
            dt.items.add(result.file);
            fileInput.files = dt.files;
          } catch {
            // DataTransfer fallback
          }

          if (currentObjectUrl) {
            URL.revokeObjectURL(currentObjectUrl);
          }
          currentObjectUrl = URL.createObjectURL(result.file);

          if (previewImg && previewDiv) {
            previewImg.src = currentObjectUrl;
            previewDiv.classList.remove('hidden');
          }

          if (photoSizeBadge) {
            if (result.wasOptimized) {
              const pct = Math.round((1 - result.optimizedSize / result.originalSize) * 100);
              photoSizeBadge.textContent = `${formatFileSize(result.originalSize)} → ${formatFileSize(result.optimizedSize)} (${pct}% smaller)`;
            } else {
              photoSizeBadge.textContent = formatFileSize(result.optimizedSize);
            }
          }
        } catch (err: any) {
          if (file.size <= 4 * 1024 * 1024) {
            // Fall back to original file if within 4MB limit
            if (currentObjectUrl) URL.revokeObjectURL(currentObjectUrl);
            currentObjectUrl = URL.createObjectURL(file);
            if (previewImg && previewDiv) {
              previewImg.src = currentObjectUrl;
              previewDiv.classList.remove('hidden');
            }
            if (photoSizeBadge) {
              photoSizeBadge.textContent = formatFileSize(file.size);
            }
          } else {
            fileInput.value = '';
            if (photoError) {
              photoError.textContent = err?.message || 'Could not process photo and file exceeds 4MB limit.';
              photoError.classList.remove('hidden');
            }
          }
        } finally {
          if (photoStatus) photoStatus.classList.add('hidden');
          if (submitBtn) submitBtn.disabled = false;
        }
      });
    }

    // 2. Client-side signed URL cache & IntersectionObserver for photos
    const SIGNED_URL_CACHE = new Map<string, { url: string; expiresAt: number }>();

    async function getPhotoUrl(path: string): Promise<string | null> {
      const cached = SIGNED_URL_CACHE.get(path);
      if (cached && Date.now() < cached.expiresAt - 60_000) {
        return cached.url;
      }
      try {
        const res = await fetch(`/api/photo-url?path=${encodeURIComponent(path)}`);
        if (!res.ok) return null;
        const data = await res.json();
        if (data.url) {
          SIGNED_URL_CACHE.set(path, {
            url: data.url,
            expiresAt: data.expiresAt || Date.now() + 3600_000,
          });
          return data.url;
        }
      } catch {
        // Network or JSON parse error
      }
      return null;
    }

    const photoContainers = document.querySelectorAll<HTMLElement>('.photo-lazy-container');
    if (photoContainers.length > 0) {
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries, obs) => {
          entries.forEach(async (entry) => {
            if (entry.isIntersecting) {
              const container = entry.target as HTMLElement;
              obs.unobserve(container);
              const path = container.getAttribute('data-photo-path');
              if (!path) return;
              const url = await getPhotoUrl(path);
              const link = container.querySelector<HTMLAnchorElement>('.photo-link');
              const img = container.querySelector<HTMLImageElement>('img');
              const skeleton = container.querySelector<HTMLElement>('.photo-skeleton');
              if (url && link && img) {
                link.href = url;
                img.src = url;
                img.onload = () => {
                  link.classList.remove('hidden');
                  if (skeleton) skeleton.classList.add('hidden');
                };
                img.onerror = () => {
                  if (skeleton) {
                    skeleton.innerHTML = '<span class="text-caption text-muted">Failed to load photo</span>';
                  }
                };
              } else if (skeleton) {
                skeleton.innerHTML = '<span class="text-caption text-muted">Photo unavailable</span>';
              }
            }
          });
        }, { rootMargin: '200px 0px' });

        photoContainers.forEach((el) => observer.observe(el));
      } else {
        // Fallback for browsers without IntersectionObserver
        photoContainers.forEach(async (container) => {
          const path = container.getAttribute('data-photo-path');
          if (!path) return;
          const url = await getPhotoUrl(path);
          const link = container.querySelector<HTMLAnchorElement>('.photo-link');
          const img = container.querySelector<HTMLImageElement>('img');
          const skeleton = container.querySelector<HTMLElement>('.photo-skeleton');
          if (url && link && img) {
            link.href = url;
            img.src = url;
            link.classList.remove('hidden');
            if (skeleton) skeleton.classList.add('hidden');
          }
        });
      }
    }

    // 3. Filter chips handling
    const filterContainer = document.getElementById('filterChips');
    const ticketCards = document.querySelectorAll('.ticket-card');

    if (filterContainer && ticketCards.length > 0) {
      const chips = filterContainer.querySelectorAll('.filter-chip');
      chips.forEach((chip) => {
        chip.addEventListener('click', () => {
          const filter = chip.getAttribute('data-filter');
          chips.forEach((c) => {
            c.classList.remove('btn-primary');
            c.classList.add('btn-secondary');
          });
          chip.classList.add('btn-primary');
          chip.classList.remove('btn-secondary');

          ticketCards.forEach((card) => {
            const status = card.getAttribute('data-status');
            if (filter === 'all' || status === filter) {
              (card as HTMLElement).style.display = 'block';
            } else {
              (card as HTMLElement).style.display = 'none';
            }
          });
        });
      });
    }
  </script>
</Layout>
