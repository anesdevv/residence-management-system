---
/**
 * RÉSIVO — dashboard (docs/DESIGN.md §8, plan Phase 4).
 * Visual layer only: the three queries and every derived value are frozen.
 *
 * Layout: PageHeader with the greeting + status pill, a state hero card
 * (pending amber / active ok / rejected danger), the digital resident pass
 * for active students, resident services and the recent-activity stream.
 */
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import PageHeader from '../../components/PageHeader.astro';
import StatusPill from '../../components/StatusPill.astro';
import Stepper from '../../components/Stepper.astro';
import ResidentPass from '../../components/ResidentPass.astro';
import EmptyState from '../../components/EmptyState.astro';
import InlineBanner from '../../components/InlineBanner.astro';
import { createSupabaseServerClient } from '../../lib/supabase';
import { getCategoryMeta } from '../../lib/maintenance';
import { localizePath, t, formatDate, formatResidentName, type SupportedLocale } from '../../lib/i18n';

export const prerender = false;
const locale: SupportedLocale = Astro.locals.locale || 'en';

const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);
const uid = Astro.locals.user!.id;

let student: any = null;
let recentReports: any[] = [];
let recentRoomChanges: any[] = [];
let queryError: string | null = null;
let partialReportsError: string | null = null;
let partialRoomChangesError: string | null = null;

try {
  const [sRes, repRes, rcRes] = await Promise.allSettled([
    supabase
      .from('students')
      .select('first_name, last_name, card_id, status, rejection_reason, room_id, university, faculty, study_level, rooms(block, floor, number)')
      .eq('id', uid)
      .single(),
    supabase
      .from('maintenance_reports')
      .select('id, category, description, status, created_at')
      .eq('student_id', uid)
      .order('created_at', { ascending: false })
      .limit(3),
    supabase
      .from('room_change_requests')
      .select('id, reason, status, created_at')
      .eq('student_id', uid)
      .order('created_at', { ascending: false })
      .limit(2),
  ]);

  if (sRes.status === 'fulfilled') {
    if (sRes.value.error) {
      queryError = sRes.value.error.message;
    } else {
      student = sRes.value.data;
    }
  } else {
    queryError = sRes.reason?.message || 'Failed to load resident profile.';
  }

  if (repRes.status === 'fulfilled') {
    if (repRes.value.error) {
      partialReportsError = repRes.value.error.message;
    } else {
      recentReports = repRes.value.data ?? [];
    }
  } else {
    partialReportsError = repRes.reason?.message || 'Failed to load maintenance tickets.';
  }

  if (rcRes.status === 'fulfilled') {
    if (rcRes.value.error) {
      partialRoomChangesError = rcRes.value.error.message;
    } else {
      recentRoomChanges = rcRes.value.data ?? [];
    }
  } else {
    partialRoomChangesError = rcRes.reason?.message || 'Failed to load room changes.';
  }
} catch (err: any) {
  queryError = err?.message || 'The server is taking too long to respond. Check your connection and try again.';
}

const rawRoom = student?.rooms;
const room = (Array.isArray(rawRoom) ? rawRoom[0] : rawRoom) as { block: string; floor: string | number; number: string } | null | undefined;
const isActive = student?.status === 'active';
const isPending = student?.status === 'pending';
const isRejected = student?.status === 'rejected';
const fullName = student ? formatResidentName(student.first_name, student.last_name) : 'Resident';

/* --- presentation-only helpers (no data, no metrics) ---------------------- */
const statusPill = isActive
  ? { kind: 'ok', label: t(locale, 'status.active') }
  : isRejected
    ? { kind: 'danger', label: t(locale, 'status.rejected') }
    : isPending
      ? { kind: 'pending', label: t(locale, 'status.pending') }
      : null;

const subtitle = [student?.faculty, student?.university || 'Université de Tlemcen'].filter(Boolean).join(', ');
---

<Layout title={locale === 'fr' ? 'Tableau de bord | RÉSIVO' : 'Dashboard | RÉSIVO'} activeNav="dashboard">
  {
    queryError && (
      <InlineBanner kind="error" title={t(locale, 'errors.connection_error')} class="mb-6">
        {queryError}
      </InlineBanner>
    )
  }

  <PageHeader
    title={t(locale, 'dashboard.title')}
    subtitle={[fullName, subtitle].filter(Boolean).join(', ')}
  >
    {
      statusPill && (
        <Fragment slot="actions">
          <StatusPill kind={statusPill.kind} label={statusPill.label} />
        </Fragment>
      )
    }
  </PageHeader>

  <!-- ======================================================================
       State hero — changes with the application state
       ====================================================================== -->

  {/* Pending — amber tokens + the 3-step review tracker */}
  {
    isPending && (
      <section class="hero-card border border-pending-line bg-pending-bg p-4 sm:p-7 shadow-e1">
        <div class="flex flex-col gap-5 sm:flex-row sm:items-start">
          <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-input border border-pending-line bg-surface text-pending">
            <Icon name="clock" size={24} />
          </span>
          <div class="flex min-w-0 flex-1 flex-col gap-5 sm:gap-6">
            <div>
              <h2 class="font-display text-h1 sm:text-display text-ink tracking-tight">{t(locale, 'dashboard.verification_in_progress')}</h2>
              <p class="measure mt-1.5 text-body text-ink-2 leading-relaxed">
                {t(locale, 'dashboard.status_pending_desc')}
              </p>
            </div>

            <div class="rounded-input border border-pending-line/80 bg-surface p-4 sm:p-5">
              <Stepper
                steps={[
                  t(locale, 'dashboard.stepper_submitted'),
                  t(locale, 'dashboard.stepper_matching'),
                  t(locale, 'dashboard.stepper_handover'),
                ]}
                current={1}
              />
            </div>

            <div class="flex items-start gap-3 rounded-input border border-pending-line bg-surface p-3.5 sm:px-4">
              <Icon name="lock" size={16} class="mt-0.5 shrink-0 text-pending" />
              <p class="text-small font-normal text-ink-2 leading-relaxed">
                {t(locale, 'dashboard.service_requests_locked')}
              </p>
            </div>
          </div>
        </div>
      </section>
    )
  }

  {/* Rejected — danger tokens + the reason in a quoted block */}
  {
    isRejected && (
      <section class="hero-card border border-danger-line bg-danger-bg p-4 sm:p-7 shadow-e1">
        <div class="flex flex-col gap-5 sm:flex-row sm:items-start">
          <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-input border border-danger-line bg-surface text-danger">
            <Icon name="x-circle" size={24} />
          </span>
          <div class="flex min-w-0 flex-1 flex-col gap-5">
            <div>
              <h2 class="font-display text-h1 sm:text-display text-ink tracking-tight">{t(locale, 'dashboard.rejection_header')}</h2>
              <p class="measure mt-1.5 text-body text-ink-2 leading-relaxed">
                {t(locale, 'dashboard.status_rejected_desc')}
              </p>
            </div>

            <blockquote class="rounded-input border border-danger-line bg-surface p-4 sm:p-5">
              <p class="text-small font-semibold text-danger mb-1.5">{t(locale, 'dashboard.rejection_reason_label')}</p>
              <p class="break-words text-body font-medium text-danger">
                “{student?.rejection_reason || t(locale, 'dashboard.rejection_default')}”
              </p>
            </blockquote>

            <div class="flex items-start gap-3 rounded-input border border-danger-line bg-surface p-3.5 sm:p-4">
              <Icon name="building" size={18} class="mt-0.5 shrink-0 text-danger" />
              <p class="measure text-small font-normal text-ink-2 leading-relaxed">
                {t(locale, 'dashboard.rejection_bureau_notice')}
              </p>
            </div>
          </div>
        </div>
      </section>
    )
  }

  <!-- ======================================================================
       Active Resident Overview: Digital Pass (Primary) + Actionable Summary
       ====================================================================== -->
  {
    isActive && room && (
      <div class="grid grid-cols-1 gap-6 lg:grid-cols-12 lg:gap-8 items-start">
        <!-- Left / Primary: Digital Resident Pass -->
        <section class="lg:col-span-7 flex flex-col gap-3" aria-labelledby="pass-heading">
          <div>
            <h2 id="pass-heading" class="font-display text-h1 sm:text-h2 text-ink tracking-tight">
              {t(locale, 'dashboard.pass_section_title')}
            </h2>
            <p class="text-small text-muted mt-0.5">
              {t(locale, 'dashboard.pass_section_desc')}
            </p>
          </div>
          <ResidentPass
            class="mt-2"
            fullName={fullName}
            cardId={student?.card_id ?? ''}
            block={room.block}
            floor={room.floor}
            room={room.number}
            studyLevel={student?.study_level}
            university={student?.university}
          />
        </section>

        <!-- Right / Secondary: Actionable Residency Summary & Quick Actions -->
        <div class="lg:col-span-5 flex flex-col gap-5">
          <!-- Quick Services Card -->
          <section class="card p-5 sm:p-6 flex flex-col gap-4">
            <h3 class="font-display text-h3 font-semibold text-ink">
              {locale === 'fr' ? 'Accès rapide aux services' : 'Quick Resident Services'}
            </h3>

            <div class="flex flex-col gap-3">
              <a
                href={localizePath(locale, '/dashboard/maintenance')}
                class="group flex items-center justify-between gap-3 p-3.5 rounded-input border border-line bg-subtle hover:bg-canvas hover:border-teal-600 transition-colors min-h-[52px]"
              >
                <div class="flex items-center gap-3">
                  <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-input border border-teal-600/15 bg-teal-600/10 text-teal-600">
                    <Icon name="wrench" size={18} />
                  </span>
                  <div class="min-w-0">
                    <span class="block text-body font-semibold text-ink group-hover:text-teal-600 transition-colors">
                      {t(locale, 'dashboard.service_maintenance_title')}
                    </span>
                    <span class="block text-small text-muted">
                      {locale === 'fr' ? 'Signaler une panne ou une dégradation' : 'Report repair issue or damage'}
                    </span>
                  </div>
                </div>
                <Icon name="chevron-right" size={16} class="text-muted group-hover:text-teal-600 rtl-mirror transition-colors shrink-0" />
              </a>

              <a
                href={localizePath(locale, '/dashboard/room-change')}
                class="group flex items-center justify-between gap-3 p-3.5 rounded-input border border-line bg-subtle hover:bg-canvas hover:border-teal-600 transition-colors min-h-[52px]"
              >
                <div class="flex items-center gap-3">
                  <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-input border border-navy-800/15 bg-navy-800/10 text-navy-800">
                    <Icon name="arrow-left-right" size={18} />
                  </span>
                  <div class="min-w-0">
                    <span class="block text-body font-semibold text-ink group-hover:text-teal-600 transition-colors">
                      {t(locale, 'dashboard.service_transfer_title')}
                    </span>
                    <span class="block text-small text-muted">
                      {locale === 'fr' ? 'Changement de chambre ou d’étage' : 'Request room or floor transfer'}
                    </span>
                  </div>
                </div>
                <Icon name="chevron-right" size={16} class="text-muted group-hover:text-teal-600 rtl-mirror transition-colors shrink-0" />
              </a>
            </div>
          </section>

          <!-- Direct Residence Desk Contact & Hours -->
          <section class="card p-5 sm:p-6 flex flex-col gap-3">
            <h3 class="font-display text-h3 font-semibold text-ink">{locale === 'fr' ? 'Permanence de la résidence' : 'Residence Desk'}</h3>
            <div class="flex items-start gap-3">
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-input bg-subtle text-teal-600">
                <Icon name="building" size={18} />
              </span>
              <div class="min-w-0">
                <p class="text-body font-semibold text-ink">Bureau de la Résidence, Pavillon Central</p>
                <p class="text-small text-muted mt-0.5">
                  {locale === 'fr' ? 'Dimanche au Jeudi : 08h30 à 16h30' : 'Sunday to Thursday: 08:30 to 16:30'}
                </p>
              </div>
            </div>
            <div class="border-t border-line pt-3 flex items-center justify-between gap-2">
              <span class="text-small text-muted">{locale === 'fr' ? 'Guichet d’accueil' : 'Help Desk'}</span>
              <a
                href="tel:+21343210000"
                class="inline-flex items-center gap-1.5 text-small font-semibold text-teal-600 hover:underline min-h-[44px] whitespace-nowrap"
                dir="ltr"
              >
                <Icon name="phone" size={14} class="rtl-mirror shrink-0" />
                <span class="tnum font-mono">+213 (0) 43 21 00 00</span>
              </a>
            </div>
          </section>
        </div>
      </div>
    )
  }

  {/* Active without a room yet */}
  {
    isActive && !room && (
      <section class="hero-card border border-line bg-surface p-5 sm:p-7 shadow-e1">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-start">
          <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-input border border-pending-line bg-pending-bg text-pending">
            <Icon name="clock" size={24} />
          </span>
          <div class="min-w-0">
            <h2 class="font-display text-h1 sm:text-h2 text-ink tracking-tight">{t(locale, 'dashboard.allocation_finalizing_title')}</h2>
            <p class="measure mt-1.5 text-body text-ink-2 leading-relaxed">
              {t(locale, 'dashboard.allocation_finalizing_desc')}
            </p>
          </div>
        </div>
      </section>
    )
  }

  {/* Resident services — shown when not active with room */}
  {
    (!isActive || !room) && (
      <section class="mt-8 sm:mt-10" aria-labelledby="services-heading">
        <h2 id="services-heading" class="font-display text-h1 sm:text-h2 text-ink tracking-tight">
          {t(locale, 'dashboard.services_section_title')}
        </h2>

        <div class="mt-5 grid grid-cols-1 gap-4 lg:grid-cols-12 items-stretch">
          <div class="card card-flat divide-y divide-line bg-subtle/50 lg:col-span-7 flex flex-col justify-center">
            <div class="flex flex-col gap-2 p-5 sm:p-6">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <div class="flex items-center gap-2.5 text-muted">
                  <Icon name="wrench" size={18} />
                  <h3 class="text-h3 font-semibold text-ink">{t(locale, 'dashboard.service_maintenance_title')}</h3>
                </div>
                <StatusPill kind="neutral" icon="lock" label={t(locale, 'dashboard.service_locked_badge')} size="sm" />
              </div>
              <p class="text-small font-normal text-ink-2 leading-relaxed">
                {t(locale, 'dashboard.service_maintenance_desc')}
              </p>
              <p class="flex items-start gap-2 text-small font-normal text-muted">
                <Icon name="lock" size={15} class="mt-0.5 shrink-0" />
                <span>{t(locale, 'dashboard.service_maintenance_locked')}</span>
              </p>
            </div>

            <div class="flex flex-col gap-2 p-5 sm:p-6">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <div class="flex items-center gap-2.5 text-muted">
                  <Icon name="arrow-left-right" size={18} />
                  <h3 class="text-h3 font-semibold text-ink">{t(locale, 'dashboard.service_transfer_title')}</h3>
                </div>
                <StatusPill kind="neutral" icon="lock" label={t(locale, 'dashboard.service_locked_badge')} size="sm" />
              </div>
              <p class="text-small font-normal text-ink-2 leading-relaxed">
                {t(locale, 'dashboard.service_transfer_desc')}
              </p>
              <p class="flex items-start gap-2 text-small font-normal text-muted">
                <Icon name="lock" size={15} class="mt-0.5 shrink-0" />
                <span>{t(locale, 'dashboard.service_transfer_locked')}</span>
              </p>
            </div>
          </div>

          <a
            href={localizePath(locale, '/dashboard/profile')}
            class="card group lg:col-span-5 flex flex-col justify-between gap-5 p-5 sm:p-6 transition-colors duration-200 hover:border-teal-600"
          >
            <div>
              <div class="flex items-center gap-2.5 text-navy-800">
                <Icon name="user" size={20} />
                <h3 class="text-h3 font-semibold text-ink transition-colors group-hover:text-teal-600">
                  {t(locale, 'dashboard.service_profile_title')}
                </h3>
              </div>
              <p class="mt-2.5 text-small font-normal text-ink-2 leading-relaxed">
                {t(locale, 'dashboard.service_profile_desc')}
              </p>
            </div>
            <span class="inline-flex items-center gap-1.5 text-small font-semibold text-teal-600 whitespace-nowrap">
              <span>{t(locale, 'dashboard.service_profile_cta')}</span>
              <Icon name="chevron-right" size={16} class="rtl-mirror" />
            </span>
          </a>
        </div>
      </section>
    )
  }

  <!-- ======================================================================
       Recent activity — maintenance tickets + room-change requests
       ====================================================================== -->
  <section class="mt-10 sm:mt-12" aria-labelledby="activity-heading">
    <div class="flex flex-wrap items-end justify-between gap-3">
      <h2 id="activity-heading" class="font-display text-h1 sm:text-h2 text-ink tracking-tight">
        {t(locale, 'dashboard.timeline_title')}
      </h2>
      {
        isActive && (
          <a
            href={localizePath(locale, '/dashboard/maintenance')}
            class="inline-flex min-h-11 items-center gap-1.5 text-small font-semibold text-teal-600 hover:underline"
          >
            <span>{t(locale, 'dashboard.timeline_view_all')}</span>
            <Icon name="chevron-right" size={16} class="rtl-mirror" />
          </a>
        )
      }
    </div>

    {
      partialReportsError && (
        <InlineBanner kind="warning" title={t(locale, 'dashboard.error_maintenance_unavailable')} class="mt-5">
          {partialReportsError}
        </InlineBanner>
      )
    }

    {
      partialRoomChangesError && (
        <InlineBanner kind="warning" title={t(locale, 'dashboard.error_transfers_unavailable')} class="mt-5">
          {partialRoomChangesError}
        </InlineBanner>
      )
    }

    {
      (!recentReports || recentReports.length === 0) && (!recentRoomChanges || recentRoomChanges.length === 0) ? (
        <EmptyState
          class="mt-5"
          icon="file-text"
          title={t(locale, 'dashboard.timeline_empty_title')}
          message={
            isActive
              ? t(locale, 'dashboard.timeline_empty_active')
              : t(locale, 'dashboard.timeline_empty_inactive')
          }
        />
      ) : (
        <ul class="mt-5 flex flex-col gap-3">
          {recentReports &&
            recentReports.map((r) => (
              <li class="card flex flex-col gap-4 p-4 sm:flex-row sm:items-center sm:justify-between sm:px-6 transition-colors hover:border-border-strong">
                <div class="flex min-w-0 items-start gap-3.5">
                  <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-input border border-teal-600/15 bg-teal-600/10 text-teal-600">
                    <Icon name={getCategoryMeta(r.category).icon} size={20} />
                  </span>
                  <div class="min-w-0">
                    <p class="text-small font-medium text-muted">{t(locale, 'nav.maintenance')}: {getCategoryMeta(r.category).label}</p>
                    <p class="line-clamp-1 text-body font-semibold text-ink">{r.description}</p>
                    <time class="tnum block text-small font-normal text-muted mt-0.5" datetime={r.created_at}>
                      {formatDate(locale, r.created_at, { year: 'numeric', month: 'short', day: 'numeric' })}
                    </time>
                  </div>
                </div>
                <StatusPill
                  kind={r.status === 'resolved' ? 'ok' : r.status === 'in_progress' ? 'progress' : 'pending'}
                  label={r.status === 'resolved' ? t(locale, 'status.resolved') : r.status === 'in_progress' ? t(locale, 'status.in_progress') : t(locale, 'status.pending')}
                  class="shrink-0 self-start sm:self-auto"
                />
              </li>
            ))}

          {recentRoomChanges &&
            recentRoomChanges.map((rc) => (
              <li class="card flex flex-col gap-4 p-4 sm:flex-row sm:items-center sm:justify-between sm:px-6 transition-colors hover:border-border-strong">
                <div class="flex min-w-0 items-start gap-3.5">
                  <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-input border border-navy-800/15 bg-navy-800/10 text-navy-800">
                    <Icon name="arrow-left-right" size={20} />
                  </span>
                  <div class="min-w-0">
                    <p class="text-small font-medium text-muted">{t(locale, 'terms.room_change_request')}</p>
                    <p class="line-clamp-1 text-body font-semibold text-ink">{rc.reason}</p>
                    <time class="tnum block text-small font-normal text-muted mt-0.5" datetime={rc.created_at}>
                      {formatDate(locale, rc.created_at, { year: 'numeric', month: 'short', day: 'numeric' })}
                    </time>
                  </div>
                </div>
                <StatusPill
                  kind={rc.status === 'approved' ? 'ok' : rc.status === 'rejected' ? 'danger' : 'review'}
                  label={rc.status === 'approved' ? t(locale, 'status.approved') : rc.status === 'rejected' ? t(locale, 'status.rejected') : t(locale, 'status.under_review')}
                  class="shrink-0 self-start sm:self-auto"
                />
              </li>
            ))}
        </ul>
      )
    }
  </section>
  <style>
    h1,
    h2 {
      overflow-wrap: break-word;
      min-width: 0;
      text-wrap: balance;
    }
  </style>
</Layout>
