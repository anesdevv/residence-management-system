---
/**
 * RÉSIVO — dashboard (docs/DESIGN.md §8, plan Phase 4).
 * Visual layer only: the three queries and every derived value are frozen.
 *
 * Layout: PageHeader with the greeting + status pill, a state hero card
 * (pending amber / active ok / rejected danger), the digital resident pass
 * for active students, resident services and the recent-activity stream.
 */
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import PageHeader from '../../components/PageHeader.astro';
import StatusPill from '../../components/StatusPill.astro';
import Stepper from '../../components/Stepper.astro';
import ResidentPass from '../../components/ResidentPass.astro';
import EmptyState from '../../components/EmptyState.astro';
import { createSupabaseServerClient } from '../../lib/supabase';

export const prerender = false;

const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);
const uid = Astro.locals.user!.id;

const [
  { data: student },
  { data: recentReports },
  { data: recentRoomChanges },
] = await Promise.all([
  supabase
    .from('students')
    .select('first_name, last_name, card_id, status, rejection_reason, room_id, university, faculty, study_level, rooms(block, floor, number)')
    .eq('id', uid)
    .single(),
  supabase
    .from('maintenance_reports')
    .select('id, category, description, status, created_at')
    .eq('student_id', uid)
    .order('created_at', { ascending: false })
    .limit(3),
  supabase
    .from('room_change_requests')
    .select('id, reason, status, created_at')
    .eq('student_id', uid)
    .order('created_at', { ascending: false })
    .limit(2),
]);

const rawRoom = student?.rooms;
const room = (Array.isArray(rawRoom) ? rawRoom[0] : rawRoom) as { block: string; floor: string | number; number: string } | null | undefined;
const isActive = student?.status === 'active';
const isPending = student?.status === 'pending';
const isRejected = student?.status === 'rejected';
const fullName = student ? `${student.first_name || 'Resident'}${student.last_name ? ` ${student.last_name}` : ''}` : 'Resident';

/* --- presentation-only helpers (no data, no metrics) ---------------------- */
const statusPill = isActive
  ? { kind: 'ok', label: 'Active resident' }
  : isRejected
    ? { kind: 'danger', label: 'Application rejected' }
    : isPending
      ? { kind: 'pending', label: 'Pending verification' }
      : null;

const subtitle = [student?.faculty, student?.university || 'Université de Tlemcen'].filter(Boolean).join(' · ');

/** Maintenance category to authored icon + label (docs/DESIGN.md section 5 aliases). */
const CATEGORY: Record<string, { icon: string; label: string }> = {
  plumbing: { icon: 'droplet', label: 'Plumbing' },
  electrical: { icon: 'zap', label: 'Electrical' },
  furniture: { icon: 'hammer', label: 'Furniture' },
  internet: { icon: 'wifi', label: 'Internet' },
  other: { icon: 'wrench', label: 'Other' },
};
---

<Layout title="Dashboard — RÉSIVO" activeNav="dashboard">
  <PageHeader title={`Welcome, ${fullName}`} overline="Cité Universitaire Tlemcen" subtitle={subtitle}>
    {
      statusPill && (
        <Fragment slot="actions">
          <StatusPill kind={statusPill.kind} label={statusPill.label} />
        </Fragment>
      )
    }
  </PageHeader>

  <!-- ======================================================================
       State hero — changes with the application state
       ====================================================================== -->

  {/* Pending — amber tokens + the 3-step review tracker */}
  {
    isPending && (
      <section class="hero-card border border-pending-line bg-pending-bg p-4 sm:p-6">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-start">
          <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-input border border-pending-line bg-surface text-pending">
            <Icon name="clock" size={24} />
          </span>
          <div class="flex min-w-0 flex-1 flex-col gap-6">
            <div>
              <p class="overline text-pending">Registration under review</p>
              <h2 class="font-display text-h2 text-ink">Verification in progress</h2>
              <p class="measure mt-1 text-body text-ink-2">
                Your accommodation dossier is being processed by the Residence Administration. Once it is matched
                against the university admission roster, your room will be officially assigned.
              </p>
            </div>

            <Stepper steps={['Form submitted', 'Roster matching', 'Room handover']} current={1} />

            <div class="flex items-start gap-2 rounded-input border border-pending-line bg-surface p-3 sm:px-4">
              <Icon name="lock" size={16} class="mt-0.5 shrink-0 text-pending" />
              <p class="text-small font-normal text-ink-2">
                Service requests (maintenance and room transfer) unlock automatically upon room assignment.
              </p>
            </div>
          </div>
        </div>
      </section>
    )
  }

  {/* Rejected — danger tokens + the reason in a quoted block */}
  {
    isRejected && (
      <section class="hero-card border border-danger-line bg-danger-bg p-4 sm:p-6">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-start">
          <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-input border border-danger-line bg-surface text-danger">
            <Icon name="x-circle" size={24} />
          </span>
          <div class="flex min-w-0 flex-1 flex-col gap-4">
            <div>
              <p class="overline text-danger">Application rejected</p>
              <h2 class="font-display text-h2 text-ink">Registration could not be approved</h2>
              <p class="measure mt-1 text-body text-ink-2">
                Your application was reviewed by the housing admissions board with the following note:
              </p>
            </div>

            <blockquote class="rounded-input border border-danger-line bg-surface p-3 sm:p-4">
              <p class="break-words text-body font-medium text-danger">
                “{student?.rejection_reason || 'Official records could not be verified on the current year admissions roster.'}”
              </p>
            </blockquote>

            <div class="flex items-start gap-3 rounded-input border border-danger-line bg-surface p-3 sm:p-4">
              <Icon name="building" size={18} class="mt-0.5 shrink-0 text-danger" />
              <p class="measure text-small font-normal text-ink-2">
                If you believe this is an administrative discrepancy, please visit the Housing Bureau
                (Administration Bloc A) with your official student certificate.
              </p>
            </div>
          </div>
        </div>
      </section>
    )
  }

  {/* Active with a room — the assigned-quarters summary */}
  {
    isActive && room && (
      <section class="hero-card border border-ok-line bg-ok-bg p-4 sm:p-6">
        <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
          <div class="flex min-w-0 items-start gap-4">
            <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-input border border-ok-line bg-surface text-ok">
              <Icon name="building" size={24} />
            </span>
            <div class="min-w-0">
              <p class="overline text-ok">Officially assigned quarters</p>
              <h2 class="font-display text-h2 text-ink">
                Block {room.block} — Room {room.number}
              </h2>
              <p class="mt-0.5 text-small font-normal text-ink-2">Floor {room.floor} · Cité Universitaire Tlemcen</p>
            </div>
          </div>

          <dl class="grid shrink-0 grid-cols-2 gap-4 rounded-input border border-ok-line bg-surface p-3 sm:px-4">
            <div class="min-w-0">
              <dt class="overline">Card ID</dt>
              <dd class="tnum font-display text-h2 text-ink">{student?.card_id}</dd>
            </div>
            <div class="min-w-0">
              <dt class="overline">Study level</dt>
              <dd class="font-display text-h2 text-ink">{student?.study_level || 'L1'}</dd>
            </div>
          </dl>
        </div>
      </section>
    )
  }

  {/* Active without a room yet */}
  {
    isActive && !room && (
      <section class="hero-card border border-line bg-surface p-4 sm:p-6">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-start">
          <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-input border border-pending-line bg-pending-bg text-pending">
            <Icon name="clock" size={24} />
          </span>
          <div class="min-w-0">
            <p class="overline text-pending">Room assignment</p>
            <h2 class="font-display text-h2 text-ink">Allocation being finalized</h2>
            <p class="measure mt-1 text-body text-ink-2">
              Your resident status is active. Specific dormitory room allocation records are being finalized
              by the Housing Bureau.
            </p>
          </div>
        </div>
      </section>
    )
  }

  <!-- ======================================================================
       Digital resident pass — active students with an assigned room
       ====================================================================== -->
  {
    isActive && room && (
      <section class="mt-8 sm:mt-12" aria-labelledby="pass-heading">
        <p class="overline">Resident pass</p>
        <h2 id="pass-heading" class="font-display text-h2 text-ink">Digital resident pass</h2>
        <p class="measure mt-1 text-small font-normal text-muted">
          Present this pass at the residence desk for key collection and residency checks.
        </p>
        <ResidentPass
          class="mt-4"
          fullName={fullName}
          cardId={student?.card_id ?? ''}
          block={room.block}
          floor={room.floor}
          room={room.number}
          studyLevel={student?.study_level}
          university={student?.university}
        />
      </section>
    )
  }

  <!-- ======================================================================
       Resident services
       ====================================================================== -->
  <section class="mt-8 sm:mt-12" aria-labelledby="services-heading">
    <p class="overline">Services</p>
    <h2 id="services-heading" class="font-display text-h2 text-ink">Resident services</h2>

    <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {/* Maintenance requests */}
      {
        isActive ? (
          <a
            href="/dashboard/maintenance"
            class="card group flex flex-col justify-between gap-4 p-4 transition-colors hover:border-teal-600 sm:p-6"
          >
            <div>
              <span class="flex h-11 w-11 items-center justify-center rounded-input bg-teal-600/10 text-teal-600">
                <Icon name="wrench" size={22} />
              </span>
              <h3 class="mt-4 text-h3 text-ink transition-colors group-hover:text-teal-600">Maintenance requests</h3>
              <p class="mt-1 text-small font-normal text-muted">
                Report plumbing, electricity, furniture, heating, or internet issues with attached photos.
              </p>
            </div>
            <span class="flex items-center gap-1 text-small font-semibold text-teal-600">
              <span>Manage tickets</span>
              <Icon name="chevron-right" size={16} />
            </span>
          </a>
        ) : (
          <div class="card card-flat flex flex-col justify-between gap-4 p-4 sm:p-6">
            <div>
              <span class="flex h-11 w-11 items-center justify-center rounded-input bg-subtle text-muted">
                <Icon name="wrench" size={22} />
              </span>
              <div class="mt-4 flex flex-wrap items-center gap-2">
                <h3 class="text-h3 text-muted">Maintenance requests</h3>
                <StatusPill kind="neutral" icon="lock" label="Locked" size="sm" />
              </div>
              <p class="mt-1 text-small font-normal text-muted">
                Report plumbing, electricity, furniture, heating, or internet issues with attached photos.
              </p>
            </div>
            <span class="flex items-start gap-2 text-small font-normal text-muted">
              <Icon name="lock" size={16} class="mt-0.5 shrink-0" />
              <span>Locked until your registration is approved and a room is assigned.</span>
            </span>
          </div>
        )
      }

      {/* Room transfer */}
      {
        isActive ? (
          <a
            href="/dashboard/room-change"
            class="card group flex flex-col justify-between gap-4 p-4 transition-colors hover:border-teal-600 sm:p-6"
          >
            <div>
              <span class="flex h-11 w-11 items-center justify-center rounded-input bg-navy-800/10 text-navy-800">
                <Icon name="arrow-left-right" size={22} />
              </span>
              <h3 class="mt-4 text-h3 text-ink transition-colors group-hover:text-teal-600">Room transfer</h3>
              <p class="mt-1 text-small font-normal text-muted">
                Submit a formal request to transfer to a different room or floor within your residential block.
              </p>
            </div>
            <span class="flex items-center gap-1 text-small font-semibold text-teal-600">
              <span>Request transfer</span>
              <Icon name="chevron-right" size={16} />
            </span>
          </a>
        ) : (
          <div class="card card-flat flex flex-col justify-between gap-4 p-4 sm:p-6">
            <div>
              <span class="flex h-11 w-11 items-center justify-center rounded-input bg-subtle text-muted">
                <Icon name="arrow-left-right" size={22} />
              </span>
              <div class="mt-4 flex flex-wrap items-center gap-2">
                <h3 class="text-h3 text-muted">Room transfer</h3>
                <StatusPill kind="neutral" icon="lock" label="Locked" size="sm" />
              </div>
              <p class="mt-1 text-small font-normal text-muted">
                Submit a formal request to transfer to a different room or floor within your residential block.
              </p>
            </div>
            <span class="flex items-start gap-2 text-small font-normal text-muted">
              <Icon name="lock" size={16} class="mt-0.5 shrink-0" />
              <span>Locked until your registration is approved and you have checked in.</span>
            </span>
          </div>
        )
      }

      {/* Resident profile — always available */}
      <a
        href="/dashboard/profile"
        class="card group flex flex-col justify-between gap-4 p-4 transition-colors hover:border-teal-600 sm:p-6"
      >
        <div>
          <span class="flex h-11 w-11 items-center justify-center rounded-input bg-gold-500/15 text-navy-800">
            <Icon name="user" size={22} />
          </span>
          <h3 class="mt-4 text-h3 text-ink transition-colors group-hover:text-teal-600">Resident profile</h3>
          <p class="mt-1 text-small font-normal text-muted">
            Review academic records, civil status, and update your mobile phone and contact email.
          </p>
        </div>
        <span class="flex items-center gap-1 text-small font-semibold text-teal-600">
          <span>Edit profile info</span>
          <Icon name="chevron-right" size={16} />
        </span>
      </a>
    </div>
  </section>

  <!-- ======================================================================
       Recent activity — maintenance tickets + room-change requests
       ====================================================================== -->
  <section class="mt-8 sm:mt-12" aria-labelledby="activity-heading">
    <div class="flex flex-wrap items-end justify-between gap-2">
      <div>
        <p class="overline">Timeline</p>
        <h2 id="activity-heading" class="font-display text-h2 text-ink">Recent activity</h2>
      </div>
      {
        isActive && (
          <a
            href="/dashboard/maintenance"
            class="inline-flex min-h-11 items-center gap-1 text-small font-semibold text-teal-600 hover:underline"
          >
            <span>View all tickets</span>
            <Icon name="chevron-right" size={16} />
          </a>
        )
      }
    </div>

    {
      (!recentReports || recentReports.length === 0) && (!recentRoomChanges || recentRoomChanges.length === 0) ? (
        <EmptyState
          class="mt-4"
          icon="file-text"
          title="No requests submitted yet"
          message={
            isActive
              ? 'When you submit maintenance tickets or room change requests, they will appear here with live resolution status.'
              : 'Your activity timeline will activate once your registration is approved.'
          }
        />
      ) : (
        <ul class="mt-4 flex flex-col gap-3">
          {recentReports &&
            recentReports.map((r) => (
              <li class="card flex flex-col gap-3 p-4 sm:flex-row sm:items-center sm:justify-between sm:px-6">
                <div class="flex min-w-0 items-start gap-3">
                  <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-input bg-subtle text-teal-600">
                    <Icon name={CATEGORY[r.category]?.icon ?? 'wrench'} size={20} />
                  </span>
                  <div class="min-w-0">
                    <p class="overline">Maintenance · {CATEGORY[r.category]?.label ?? r.category}</p>
                    <p class="line-clamp-1 text-body font-semibold text-ink">{r.description}</p>
                    <time class="tnum block text-small font-normal text-muted" datetime={r.created_at}>
                      {new Date(r.created_at).toLocaleDateString()}
                    </time>
                  </div>
                </div>
                <StatusPill
                  kind={r.status === 'resolved' ? 'ok' : r.status === 'in_progress' ? 'progress' : 'pending'}
                  label={r.status === 'resolved' ? 'Resolved' : r.status === 'in_progress' ? 'In progress' : 'Pending triage'}
                  class="shrink-0 self-start sm:self-auto"
                />
              </li>
            ))}

          {recentRoomChanges &&
            recentRoomChanges.map((rc) => (
              <li class="card flex flex-col gap-3 p-4 sm:flex-row sm:items-center sm:justify-between sm:px-6">
                <div class="flex min-w-0 items-start gap-3">
                  <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-input bg-subtle text-navy-800">
                    <Icon name="arrow-left-right" size={20} />
                  </span>
                  <div class="min-w-0">
                    <p class="overline">Room transfer request</p>
                    <p class="line-clamp-1 text-body font-semibold text-ink">{rc.reason}</p>
                    <time class="tnum block text-small font-normal text-muted" datetime={rc.created_at}>
                      {new Date(rc.created_at).toLocaleDateString()}
                    </time>
                  </div>
                </div>
                <StatusPill
                  kind={rc.status === 'approved' ? 'ok' : rc.status === 'rejected' ? 'danger' : 'review'}
                  label={rc.status === 'approved' ? 'Approved' : rc.status === 'rejected' ? 'Rejected' : 'Under review'}
                  class="shrink-0 self-start sm:self-auto"
                />
              </li>
            ))}
        </ul>
      )
    }
  </section>
</Layout>
