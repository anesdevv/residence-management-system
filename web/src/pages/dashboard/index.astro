---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { createSupabaseServerClient } from '../../lib/supabase';

export const prerender = false;

const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);
const uid = Astro.locals.user!.id;

const [
  { data: student },
  { data: recentReports },
  { data: recentRoomChanges },
] = await Promise.all([
  supabase
    .from('students')
    .select('first_name, last_name, card_id, status, rejection_reason, room_id, university, faculty, study_level, rooms(block, floor, number)')
    .eq('id', uid)
    .single(),
  supabase
    .from('maintenance_reports')
    .select('id, category, description, status, created_at')
    .eq('student_id', uid)
    .order('created_at', { ascending: false })
    .limit(3),
  supabase
    .from('room_change_requests')
    .select('id, reason, status, created_at')
    .eq('student_id', uid)
    .order('created_at', { ascending: false })
    .limit(2),
]);

const rawRoom = student?.rooms;
const room = (Array.isArray(rawRoom) ? rawRoom[0] : rawRoom) as { block: string; floor: string | number; number: string } | null | undefined;
const isActive = student?.status === 'active';
const isPending = student?.status === 'pending';
const isRejected = student?.status === 'rejected';
const fullName = student ? `${student.first_name || 'Resident'}${student.last_name ? ` ${student.last_name}` : ''}` : 'Resident';
---

<Layout title="Dashboard — RÉSIVO" activeNav="dashboard">
  <!-- Header with Greeting & Academic Pill -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-line/60 pb-6">
    <div>
      <div class="mb-1.5 flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-amber-ink">
        <span class="inline-block h-2 w-2 rounded-full bg-amber"></span>
        <span>Cité Universitaire Tlemcen</span>
      </div>
      <h1 class="font-display text-2xl sm:text-3xl font-extrabold tracking-tight text-navy">
        Welcome, {fullName}
      </h1>
      <p class="mt-1 text-xs sm:text-sm text-muted">
        Resident Portal • {student?.faculty ? `${student.faculty} • ` : ''}{student?.university || 'Université de Tlemcen'}
      </p>
    </div>

    <!-- Student Status Chip -->
    <div class="flex items-center gap-2 self-start sm:self-auto">
      {isActive && (
        <span class="inline-flex items-center gap-2 rounded-full bg-emerald-50 border border-emerald-200 px-4 py-1.5 text-xs font-semibold text-emerald-800 shadow-xs">
          <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
          <span>Active Resident</span>
        </span>
      )}
      {isPending && (
        <span class="inline-flex items-center gap-2 rounded-full bg-amber/10 border border-amber/30 px-4 py-1.5 text-xs font-semibold text-amber-ink shadow-xs">
          <span class="h-2 w-2 rounded-full bg-amber animate-pulse"></span>
          <span>Pending Verification</span>
        </span>
      )}
      {isRejected && (
        <span class="inline-flex items-center gap-1.5 rounded-full bg-red-50 border border-red-200 px-4 py-1.5 text-xs font-semibold text-red-800 shadow-xs">
          <Icon name="x-circle" size={14} class="text-red-600" />
          <span>Application Rejected</span>
        </span>
      )}
    </div>
  </div>

  <!-- Primary Resident Status Overview Card -->
  <div class="mt-6">
    {isPending && (
      <div class="rounded-2xl border border-amber/30 bg-amber/5 p-6 sm:p-8 shadow-sm text-ink">
        <div class="flex items-start gap-4">
          <div class="rounded-xl bg-amber/20 p-3 text-amber-ink shrink-0">
            <Icon name="clock" size={26} />
          </div>
          <div class="space-y-4 flex-1">
            <div>
              <h2 class="font-display text-base sm:text-lg font-bold text-navy">Registration Under Review</h2>
              <p class="mt-1 text-xs sm:text-sm text-muted leading-relaxed max-w-2xl">
                Your accommodation dossier is currently being processed by the Residence Administration. Once verified against the university admission roster, your room will be officially assigned.
              </p>
            </div>

            <!-- Review Steps Visual Tracker -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-1 text-xs">
              <div class="flex items-center gap-2.5 rounded-xl bg-surface border border-line/70 p-3 shadow-xs">
                <Icon name="check-circle" size={18} class="text-emerald-600 shrink-0" />
                <div>
                  <span class="font-bold text-navy block">1. Form Submitted</span>
                  <span class="text-[11px] text-muted">Dossier received</span>
                </div>
              </div>
              <div class="flex items-center gap-2.5 rounded-xl bg-amber/15 border border-amber/30 p-3">
                <Icon name="clock" size={18} class="text-amber-ink shrink-0 animate-pulse" />
                <div>
                  <span class="font-bold text-amber-ink block">2. Roster Matching</span>
                  <span class="text-[11px] text-amber-ink/80">Verification in progress</span>
                </div>
              </div>
              <div class="flex items-center gap-2.5 rounded-xl bg-surface/60 border border-line/40 p-3 text-muted/60">
                <Icon name="lock" size={18} class="shrink-0" />
                <div>
                  <span class="font-bold block">3. Room Handover</span>
                  <span class="text-[11px]">Key collection desk</span>
                </div>
              </div>
            </div>

            <div class="inline-flex items-center gap-2 rounded-xl bg-canvas border border-line/60 px-3.5 py-2 text-xs font-semibold text-muted">
              <Icon name="lock" size={14} class="text-amber-ink shrink-0" />
              <span>Service requests (Maintenance &amp; Room Transfer) unlock automatically upon room assignment.</span>
            </div>
          </div>
        </div>
      </div>
    )}

    {isRejected && (
      <div class="rounded-2xl border border-red-200 bg-red-50 p-6 sm:p-8 shadow-sm text-red-950">
        <div class="flex items-start gap-4">
          <div class="rounded-xl bg-red-100 p-3 text-red-700 shrink-0">
            <Icon name="x-circle" size={26} />
          </div>
          <div class="space-y-3 flex-1">
            <h2 class="font-display text-base sm:text-lg font-bold text-red-950">Registration Could Not Be Approved</h2>
            <p class="text-xs sm:text-sm text-red-900 leading-relaxed">
              Your application was reviewed by the housing admissions board with the following note:
            </p>
            <div class="rounded-xl border border-red-200 bg-white p-3.5 text-xs sm:text-sm font-medium text-red-900 shadow-xs">
              "{student?.rejection_reason || 'Official records could not be verified on the current year admissions roster.'}"
            </div>
            <p class="text-xs text-red-800 pt-1">
              If you believe this is an administrative discrepancy, please visit the Housing Bureau (Administration Bloc A) with your official student certificate.
            </p>
          </div>
        </div>
      </div>
    )}

    {isActive && room && (
      <div class="rounded-2xl border border-line/70 bg-surface p-6 sm:p-8 shadow-sm relative overflow-hidden">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6 relative z-10">
          <div class="flex items-start gap-4">
            <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-navy text-white shrink-0 shadow-sm">
              <Icon name="building" size={26} />
            </div>
            <div>
              <div class="flex items-center gap-2">
                <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
                <span class="text-xs font-bold text-emerald-800 uppercase tracking-wider">Officially Assigned Quarters</span>
              </div>
              <h2 class="font-display text-xl sm:text-2xl font-bold text-navy mt-1">
                Block {room.block} — Room {room.number}
              </h2>
              <p class="text-xs sm:text-sm text-muted mt-0.5">
                Floor {room.floor} • Cité Universitaire Tlemcen
              </p>
            </div>
          </div>

          <div class="flex items-center gap-5 text-xs text-muted bg-canvas px-5 py-3 rounded-xl border border-line/70 self-start sm:self-auto">
            <div>
              <span class="text-muted/70 block text-[10px] uppercase font-bold tracking-wider">Student Card ID</span>
              <span class="font-bold text-navy text-sm tnum">{student?.card_id}</span>
            </div>
            <div class="h-7 w-[1px] bg-line"></div>
            <div>
              <span class="text-muted/70 block text-[10px] uppercase font-bold tracking-wider">Study Level</span>
              <span class="font-bold text-navy text-sm">{student?.study_level || 'L1'}</span>
            </div>
          </div>
        </div>
      </div>
    )}

    {isActive && !room && (
      <div class="rounded-2xl border border-line/70 bg-surface p-6 sm:p-8 shadow-sm">
        <div class="flex items-start gap-4">
          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-amber/15 text-amber-ink shrink-0">
            <Icon name="building" size={26} />
          </div>
          <div>
            <h2 class="font-display text-lg font-bold text-navy">Room Assignment Pending Update</h2>
            <p class="text-xs sm:text-sm text-muted mt-1 leading-relaxed">
              Your resident status is active. Specific dormitory room allocation records are being finalized by the Housing Bureau.
            </p>
          </div>
        </div>
      </div>
    )}
  </div>

  <!-- Resident Quick Service Cards -->
  <div class="mt-8 sm:mt-10">
    <div class="flex items-center justify-between mb-4">
      <h2 class="font-display text-lg font-bold text-navy">Resident Services</h2>
      <span class="text-xs text-muted font-medium">Quick Shortcuts</span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
      <!-- Maintenance Card -->
      {isActive ? (
        <a
          href="/dashboard/maintenance"
          class="group rounded-2xl border border-line/70 bg-surface p-6 shadow-sm transition hover:border-amber/70 hover:shadow-md flex flex-col justify-between"
        >
          <div>
            <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-amber/15 text-amber-ink group-hover:bg-navy group-hover:text-white transition-colors">
              <Icon name="wrench" size={22} />
            </div>
            <h3 class="mt-4 font-display font-bold text-navy text-base group-hover:text-amber-ink transition-colors">
              Maintenance Requests
            </h3>
            <p class="mt-1.5 text-xs text-muted leading-relaxed">
              Report plumbing, electricity, furniture, heating, or internet issues with attached photos.
            </p>
          </div>
          <div class="mt-5 pt-3 border-t border-line/50 flex items-center gap-1 text-xs font-semibold text-amber-ink">
            <span>Manage tickets</span>
            <Icon name="chevron-right" size={14} />
          </div>
        </a>
      ) : (
        <div class="rounded-2xl border border-line/50 bg-canvas/60 p-6 shadow-xs flex flex-col justify-between opacity-75 cursor-not-allowed">
          <div>
            <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-canvas border border-line/60 text-muted">
              <Icon name="wrench" size={22} />
            </div>
            <div class="mt-4 flex items-center gap-2">
              <h3 class="font-display font-bold text-muted text-base">Maintenance Requests</h3>
              <span class="rounded bg-line/50 px-2 py-0.5 text-[10px] font-bold text-muted uppercase">Locked</span>
            </div>
            <p class="mt-1.5 text-xs text-muted/80 leading-relaxed">
              Requires an active assigned room before filing repair tickets.
            </p>
          </div>
          <div class="mt-5 pt-3 border-t border-line/40 flex items-center gap-1.5 text-xs text-muted/70 font-medium">
            <Icon name="lock" size={14} />
            <span>Disabled pending approval</span>
          </div>
        </div>
      )}

      <!-- Room Change Card -->
      {isActive ? (
        <a
          href="/dashboard/room-change"
          class="group rounded-2xl border border-line/70 bg-surface p-6 shadow-sm transition hover:border-amber/70 hover:shadow-md flex flex-col justify-between"
        >
          <div>
            <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-blue-500/15 text-blue-700 group-hover:bg-navy group-hover:text-white transition-colors">
              <Icon name="swap" size={22} />
            </div>
            <h3 class="mt-4 font-display font-bold text-navy text-base group-hover:text-blue-700 transition-colors">
              Room Transfer
            </h3>
            <p class="mt-1.5 text-xs text-muted leading-relaxed">
              Submit a formal request to transfer to a different room or floor within your residential block.
            </p>
          </div>
          <div class="mt-5 pt-3 border-t border-line/50 flex items-center gap-1 text-xs font-semibold text-blue-700">
            <span>Request transfer</span>
            <Icon name="chevron-right" size={14} />
          </div>
        </a>
      ) : (
        <div class="rounded-2xl border border-line/50 bg-canvas/60 p-6 shadow-xs flex flex-col justify-between opacity-75 cursor-not-allowed">
          <div>
            <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-canvas border border-line/60 text-muted">
              <Icon name="swap" size={22} />
            </div>
            <div class="mt-4 flex items-center gap-2">
              <h3 class="font-display font-bold text-muted text-base">Room Transfer</h3>
              <span class="rounded bg-line/50 px-2 py-0.5 text-[10px] font-bold text-muted uppercase">Locked</span>
            </div>
            <p class="mt-1.5 text-xs text-muted/80 leading-relaxed">
              Available after official approval and initial room check-in.
            </p>
          </div>
          <div class="mt-5 pt-3 border-t border-line/40 flex items-center gap-1.5 text-xs text-muted/70 font-medium">
            <Icon name="lock" size={14} />
            <span>Disabled pending approval</span>
          </div>
        </div>
      )}

      <!-- Profile Card -->
      <a
        href="/dashboard/profile"
        class="group rounded-2xl border border-line/70 bg-surface p-6 shadow-sm transition hover:border-amber/70 hover:shadow-md flex flex-col justify-between"
      >
        <div>
          <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-canvas text-navy group-hover:bg-navy group-hover:text-white transition-colors">
            <Icon name="user" size={22} />
          </div>
          <h3 class="mt-4 font-display font-bold text-navy text-base group-hover:text-navy-2 transition-colors">
            Resident Profile
          </h3>
          <p class="mt-1.5 text-xs text-muted leading-relaxed">
            Review academic records, civil status, and update your mobile phone and contact email.
          </p>
        </div>
        <div class="mt-5 pt-3 border-t border-line/50 flex items-center gap-1 text-xs font-semibold text-navy group-hover:text-amber-ink transition-colors">
          <span>Edit profile info</span>
          <Icon name="chevron-right" size={14} />
        </div>
      </a>
    </div>
  </div>

  <!-- Activity & Tickets Stream -->
  <div class="mt-10 sm:mt-12 space-y-4">
    <div class="flex items-center justify-between">
      <h2 class="font-display text-lg font-bold text-navy">Recent Activity</h2>
      {isActive && (
        <a href="/dashboard/maintenance" class="text-xs font-semibold text-amber-ink hover:underline">
          View all tickets →
        </a>
      )}
    </div>

    {(!recentReports || recentReports.length === 0) && (!recentRoomChanges || recentRoomChanges.length === 0) ? (
      <div class="rounded-2xl border border-dashed border-line bg-surface p-8 sm:p-10 text-center text-muted">
        <Icon name="file-text" size={36} class="mx-auto text-muted/60 mb-3" />
        <p class="font-display text-sm font-semibold text-navy">No requests submitted yet</p>
        <p class="text-xs text-muted mt-1 max-w-sm mx-auto leading-relaxed">
          {isActive
            ? "When you submit maintenance tickets or room change requests, they will appear here with live resolution status."
            : "Your activity timeline will activate once your registration is approved."}
        </p>
      </div>
    ) : (
      <div class="space-y-3">
        {recentReports && recentReports.map((r) => (
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 rounded-2xl border border-line/70 bg-surface p-4 sm:p-5 shadow-xs">
            <div class="flex items-start sm:items-center gap-3.5">
              <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-amber/15 text-amber-ink shrink-0">
                <Icon name="wrench" size={20} />
              </div>
              <div>
                <span class="text-[11px] font-bold uppercase tracking-wider text-muted/80">Maintenance • {r.category}</span>
                <p class="text-sm font-semibold text-navy line-clamp-1">{r.description}</p>
                <span class="text-[11px] text-muted mt-0.5 block">{new Date(r.created_at).toLocaleDateString()}</span>
              </div>
            </div>
            <div>
              {r.status === 'resolved' ? (
                <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-50 border border-emerald-200 px-3 py-1 text-xs font-semibold text-emerald-800">
                  <Icon name="check-circle" size={13} /> Resolved
                </span>
              ) : r.status === 'in_progress' ? (
                <span class="inline-flex items-center gap-1.5 rounded-full bg-blue-50 border border-blue-200 px-3 py-1 text-xs font-semibold text-blue-800">
                  <Icon name="clock" size={13} /> In Progress
                </span>
              ) : (
                <span class="inline-flex items-center gap-1.5 rounded-full bg-amber/10 border border-amber/30 px-3 py-1 text-xs font-semibold text-amber-ink">
                  <Icon name="clock" size={13} /> Pending Triage
                </span>
              )}
            </div>
          </div>
        ))}

        {recentRoomChanges && recentRoomChanges.map((rc) => (
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 rounded-2xl border border-line/70 bg-surface p-4 sm:p-5 shadow-xs">
            <div class="flex items-start sm:items-center gap-3.5">
              <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-500/15 text-blue-700 shrink-0">
                <Icon name="swap" size={20} />
              </div>
              <div>
                <span class="text-[11px] font-bold uppercase tracking-wider text-muted/80">Room Transfer Request</span>
                <p class="text-sm font-semibold text-navy line-clamp-1">{rc.reason}</p>
                <span class="text-[11px] text-muted mt-0.5 block">{new Date(rc.created_at).toLocaleDateString()}</span>
              </div>
            </div>
            <div>
              {rc.status === 'approved' ? (
                <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-50 border border-emerald-200 px-3 py-1 text-xs font-semibold text-emerald-800">
                  <Icon name="check-circle" size={13} /> Approved
                </span>
              ) : rc.status === 'rejected' ? (
                <span class="inline-flex items-center gap-1.5 rounded-full bg-red-50 border border-red-200 px-3 py-1 text-xs font-semibold text-red-800">
                  <Icon name="x-circle" size={13} /> Rejected
                </span>
              ) : (
                <span class="inline-flex items-center gap-1.5 rounded-full bg-amber/10 border border-amber/30 px-3 py-1 text-xs font-semibold text-amber-ink">
                  <Icon name="clock" size={13} /> Under Review
                </span>
              )}
            </div>
          </div>
        ))}
      </div>
    )}
  </div>
</Layout>
