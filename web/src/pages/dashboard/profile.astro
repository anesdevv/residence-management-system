---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import PageHeader from '../../components/PageHeader.astro';
import StatusPill from '../../components/StatusPill.astro';
import KeyValue from '../../components/KeyValue.astro';
import InlineBanner from '../../components/InlineBanner.astro';
import BrandMark from '../../components/BrandMark.astro';
import { createSupabaseServerClient } from '../../lib/supabase';

export const prerender = false;

const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);
const uid = Astro.locals.user!.id;

const { data: s } = await supabase
  .from('students')
  .select('card_id, first_name, last_name, birth_date, gender, phone, email, university, faculty, study_level, wilaya, status')
  .eq('id', uid)
  .single();

const error = Astro.url.searchParams.get('error');
const updated = Astro.url.searchParams.get('updated');

const statusKind = s?.status === 'active' ? 'ok' : s?.status === 'rejected' ? 'danger' : 'pending';
---

<Layout title="Resident Profile — RÉSIVO" activeNav="profile">
  <PageHeader
    title="Resident profile & credentials"
    overline="Cité Universitaire Tlemcen"
    subtitle="Review your official academic enrollment details and keep your contact info up to date."
  >
    <Fragment slot="actions">
      <a href="/dashboard" class="btn btn-secondary">
        <Icon name="arrow-left" size={16} />
        <span>Back to dashboard</span>
      </a>
    </Fragment>
  </PageHeader>

  <!-- Feedback Alerts -->
  {updated && (
    <InlineBanner kind="success" title="Contact details updated!" class="mb-6">
      Your mobile phone number and email address have been saved successfully to the residence registry.
    </InlineBanner>
  )}

  {error && (
    <InlineBanner kind="error" title="Update failed" class="mb-6">
      {error}
    </InlineBanner>
  )}

  <div class="grid grid-cols-1 gap-6 lg:grid-cols-12 lg:items-start mb-8">
    <!-- Official Academic Resident File (Left / Top) -->
    <div class="flex flex-col gap-6 lg:col-span-7">
      <section class="card p-4 sm:p-6">
        <!-- Card Top Bar -->
        <div class="flex items-start justify-between border-b border-line pb-4 mb-6">
          <div class="flex items-center gap-3.5">
            <BrandMark variant="mark" size={40} />
            <div>
              <h2 class="card-title">Academic resident file</h2>
              <p class="text-small font-normal text-muted">Direction des Œuvres Universitaires · DOU Tlemcen</p>
            </div>
          </div>

          <StatusPill kind={statusKind} />
        </div>

        <!-- Student Data Grid -->
        <KeyValue
          columns={2}
          rows={[
            { label: 'Student card ID', value: s?.card_id || '—', tnum: true, mono: true },
            { label: 'Full name', value: `${s?.first_name || ''} ${s?.last_name || ''}`.trim() || '—' },
            { label: 'Date of birth', value: s?.birth_date || '—', tnum: true },
            { label: 'Gender', value: s?.gender === 'female' ? 'Female' : 'Male' },
            { label: 'Wilaya of origin', value: s?.wilaya || '—' },
            { label: 'Study level', value: s?.study_level || '—' },
            { label: 'University', value: s?.university || '—' },
            { label: 'Faculty', value: s?.faculty || '—' },
          ]}
        />
      </section>

      <!-- Institutional Notice -->
      <InlineBanner kind="info" title="Academic record changes" icon="info">
        Matriculation number, faculty, birth date, and civil records are synchronized with university admission registers. To request formal corrections, present your official student card at the housing administration bureau.
      </InlineBanner>
    </div>

    <!-- Contact Info Form (Right / Bottom) -->
    <div class="flex flex-col gap-6 lg:col-span-5">
      <section class="card p-4 sm:p-6">
        <header class="border-b border-line pb-4 mb-6">
          <div class="flex items-center gap-3">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-input bg-subtle text-teal-600">
              <Icon name="mail" size={20} />
            </span>
            <div>
              <h2 class="card-title">Contact coordinates</h2>
              <p class="text-small font-normal text-muted mt-0.5">Editable residence communication channels</p>
            </div>
          </div>
        </header>

        <form method="POST" action="/api/profile" class="flex flex-col gap-4">
          <div class="flex flex-col gap-2">
            <label class="label" for="phone">
              Mobile phone number <span class="text-danger" aria-hidden="true">*</span>
            </label>
            <input
              class="input tnum"
              type="tel"
              name="phone"
              id="phone"
              required
              autocomplete="tel"
              value={s?.phone ?? ''}
              placeholder="e.g. 0555123456"
            />
            <p class="field-hint">Used for urgent facility and security notices.</p>
          </div>

          <div class="flex flex-col gap-2">
            <label class="label" for="email">
              Contact email address <span class="text-danger" aria-hidden="true">*</span>
            </label>
            <input
              class="input"
              type="email"
              name="email"
              id="email"
              required
              autocomplete="email"
              value={s?.email ?? ''}
              placeholder="e.g. resident@univ-tlemcen.dz"
            />
            <p class="field-hint">Housing allocations and maintenance triage updates will be delivered here.</p>
          </div>

          <div class="pt-2">
            <button class="btn btn-primary w-full min-h-[44px]" type="submit">
              <Icon name="check-circle" size={18} />
              <span>Update contact details</span>
            </button>
          </div>
        </form>
      </section>

      <!-- Account Security Card -->
      <section class="card p-4 sm:p-6">
        <div class="flex items-start gap-3">
          <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-input bg-subtle text-teal-600">
            <Icon name="lock" size={20} />
          </span>
          <div class="flex flex-col gap-1">
            <h2 class="card-title">Account security</h2>
            <p class="text-small font-normal text-muted">
              Your account is authenticated via your matriculation card ID. If you suspect unauthorized access, contact the Cité Universitaire IT desk immediately.
            </p>
          </div>
        </div>
      </section>
    </div>
  </div>
</Layout>
