---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { createSupabaseServerClient } from '../../lib/supabase';

export const prerender = false;

const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);
const uid = Astro.locals.user!.id;

const { data: s } = await supabase
  .from('students')
  .select('card_id, first_name, last_name, birth_date, gender, phone, email, university, faculty, study_level, wilaya, status')
  .eq('id', uid)
  .single();

const error = Astro.url.searchParams.get('error');
const updated = Astro.url.searchParams.get('updated');
---

<Layout title="Resident Profile — Residence Tlemcen" activeNav="profile">
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 border-b border-slate-200 pb-5">
    <div>
      <div class="flex items-center gap-2">
        <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-slate-900">
          Resident Profile & Credentials
        </h1>
      </div>
      <p class="mt-1 text-xs sm:text-sm text-slate-500">
        Review your official academic enrollment details and manage your contact information.
      </p>
    </div>

    <a
      href="/dashboard"
      class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-600 hover:text-slate-900 bg-white border border-slate-200 px-3 py-1.5 rounded-lg shadow-xs transition self-start sm:self-auto"
    >
      <Icon name="arrow-left" size={14} />
      <span>Back to Dashboard</span>
    </a>
  </div>

  <!-- Feedback Alerts -->
  {updated && (
    <div class="mt-6 flex items-start gap-3 rounded-xl border border-emerald-200 bg-emerald-50 p-4 text-emerald-900">
      <Icon name="check-circle" size={20} class="text-emerald-700 shrink-0 mt-0.5" />
      <div class="text-xs sm:text-sm">
        <span class="font-bold">Contact Details Updated!</span>
        <p class="mt-0.5 text-emerald-800">Your phone number and email address have been saved successfully.</p>
      </div>
    </div>
  )}

  {error && (
    <div class="mt-6 flex items-start gap-3 rounded-xl border border-red-200 bg-red-50 p-4 text-red-900">
      <Icon name="alert-circle" size={20} class="text-red-700 shrink-0 mt-0.5" />
      <div class="text-xs sm:text-sm">
        <span class="font-bold">Update Failed</span>
        <p class="mt-0.5 text-red-800">{error}</p>
      </div>
    </div>
  )}

  <div class="mt-6 grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Official Academic ID Card Visual -->
    <div class="lg:col-span-2 space-y-4">
      <div class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-8 shadow-xs">
        <div class="flex items-center justify-between border-b border-slate-100 pb-4 mb-6">
          <div class="flex items-center gap-3">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-slate-900 text-white shadow-xs">
              <Icon name="crest" size={20} />
            </div>
            <div>
              <h2 class="text-base font-bold text-slate-900">Academic Resident Card</h2>
              <span class="text-xs text-slate-400">Direction des Œuvres Universitaires — Tlemcen</span>
            </div>
          </div>
          <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-700 uppercase tracking-wider">
            {s?.status ?? 'Pending'}
          </span>
        </div>

        <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
          <div class="rounded-lg bg-slate-50/80 p-3.5 border border-slate-100">
            <dt class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Student Card ID</dt>
            <dd class="mt-1 font-bold text-slate-900 text-base tnum">{s?.card_id}</dd>
          </div>

          <div class="rounded-lg bg-slate-50/80 p-3.5 border border-slate-100">
            <dt class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Full Name</dt>
            <dd class="mt-1 font-bold text-slate-900 text-base">{s?.first_name} {s?.last_name}</dd>
          </div>

          <div class="rounded-lg bg-slate-50/80 p-3.5 border border-slate-100">
            <dt class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">University</dt>
            <dd class="mt-1 font-semibold text-slate-800">{s?.university}</dd>
          </div>

          <div class="rounded-lg bg-slate-50/80 p-3.5 border border-slate-100">
            <dt class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Faculty / Department</dt>
            <dd class="mt-1 font-semibold text-slate-800">{s?.faculty}</dd>
          </div>

          <div class="rounded-lg bg-slate-50/80 p-3.5 border border-slate-100">
            <dt class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Study Level</dt>
            <dd class="mt-1 font-semibold text-slate-800">{s?.study_level}</dd>
          </div>

          <div class="rounded-lg bg-slate-50/80 p-3.5 border border-slate-100">
            <dt class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Gender</dt>
            <dd class="mt-1 font-semibold text-slate-800 capitalize">{s?.gender}</dd>
          </div>

          <div class="rounded-lg bg-slate-50/80 p-3.5 border border-slate-100">
            <dt class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Date of Birth</dt>
            <dd class="mt-1 font-semibold text-slate-800 tnum">{s?.birth_date}</dd>
          </div>

          <div class="rounded-lg bg-slate-50/80 p-3.5 border border-slate-100">
            <dt class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Wilaya of Origin</dt>
            <dd class="mt-1 font-semibold text-slate-800">{s?.wilaya}</dd>
          </div>
        </dl>

        <p class="mt-5 text-[11px] text-slate-400">
          Note: To update academic credentials, name, or matriculation status, present supporting official documentation to the campus registry.
        </p>
      </div>
    </div>

    <!-- Editable Contact Form -->
    <div class="space-y-4">
      <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-xs">
        <div class="border-b border-slate-100 pb-3 mb-4">
          <h2 class="text-base font-bold text-slate-900">Contact Information</h2>
          <p class="text-xs text-slate-500">Keep your mobile phone and email up to date for emergency notices.</p>
        </div>

        <form method="POST" action="/api/profile" class="space-y-4">
          <div>
            <label for="phone" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
              Mobile Phone <span class="text-red-500">*</span>
            </label>
            <div class="relative">
              <input
                type="tel"
                name="phone"
                id="phone"
                value={s?.phone ?? ''}
                required
                class="w-full rounded-lg border border-slate-300 p-2.5 text-sm text-slate-900 focus:border-blue-600 focus:ring-2 focus:ring-blue-600/20 focus:outline-none transition tnum"
              />
            </div>
          </div>

          <div>
            <label for="email" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
              Email Address (Optional)
            </label>
            <div class="relative">
              <input
                type="email"
                name="email"
                id="email"
                value={s?.email ?? ''}
                placeholder="name@univ-tlemcen.dz"
                class="w-full rounded-lg border border-slate-300 p-2.5 text-sm text-slate-900 focus:border-blue-600 focus:ring-2 focus:ring-blue-600/20 focus:outline-none transition"
              />
            </div>
          </div>

          <div class="pt-2">
            <button
              type="submit"
              class="w-full inline-flex items-center justify-center gap-2 rounded-lg bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white shadow-xs hover:bg-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-600 focus:ring-offset-2 transition cursor-pointer"
            >
              <Icon name="check-circle" size={16} />
              <span>Save Contact Details</span>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</Layout>
