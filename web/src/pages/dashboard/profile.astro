---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import PageHeader from '../../components/PageHeader.astro';
import StatusPill from '../../components/StatusPill.astro';
import KeyValue from '../../components/KeyValue.astro';
import InlineBanner from '../../components/InlineBanner.astro';
import BrandMark from '../../components/BrandMark.astro';
import { createSupabaseServerClient } from '../../lib/supabase';

import { localizePath, t, type SupportedLocale } from '../../lib/i18n';

export const prerender = false;
const locale: SupportedLocale = Astro.locals.locale || 'en';

const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);
const uid = Astro.locals.user!.id;

let s: any = null;
let queryError: string | null = null;

try {
  const { data } = await supabase
    .from('students')
    .select('card_id, first_name, last_name, birth_date, phone, email, university, faculty, study_level, wilaya, status')
    .eq('id', uid)
    .single();
  s = data;
} catch (err: any) {
  queryError = err?.message || 'The server is taking too long to respond. Check your connection and try again.';
}

const error = Astro.url.searchParams.get('error');
const updated = Astro.url.searchParams.get('updated');

const statusKind = s?.status === 'active' ? 'ok' : s?.status === 'rejected' ? 'danger' : 'pending';
---

<Layout title={locale === 'fr' ? 'Profil Résident — RÉSIVO' : 'Resident Profile — RÉSIVO'} activeNav="profile">
  <PageHeader
    title="Resident profile & credentials"
    overline="Cité Universitaire Tlemcen"
    subtitle="Review your official academic enrollment details and keep your contact info up to date."
  >
    <Fragment slot="actions">
      <a href={localizePath(locale, '/dashboard')} class="btn btn-secondary">
        <Icon name="arrow-left" size={16} />
        <span>Back to dashboard</span>
      </a>
    </Fragment>
  </PageHeader>

  <!-- Feedback Alerts -->
  {updated && (
    <InlineBanner kind="success" title={t(locale, 'profile.phone_updated')} class="mb-6">
      {t(locale, 'profile.phone_updated')}
    </InlineBanner>
  )}

  {queryError && (
    <InlineBanner kind="error" title="Connection error" class="mb-6">
      {queryError}
    </InlineBanner>
  )}

  {error && (
    <InlineBanner kind="error" title="Update failed" class="mb-6">
      {error}
    </InlineBanner>
  )}

  <div class="grid grid-cols-1 gap-6 lg:grid-cols-12 lg:items-start mb-8">
    <!-- Official Academic Resident File (Left / Top) -->
    <div class="flex flex-col gap-6 lg:col-span-7">
      <section class="card p-4 sm:p-6">
        <!-- Card Top Bar -->
        <div class="flex items-start justify-between border-b border-line pb-4 mb-6">
          <div class="flex items-center gap-3.5">
            <BrandMark variant="mark" size={40} />
            <div>
              <h2 class="card-title">{t(locale, 'profile.academic_file_title')}</h2>
              <p class="text-small font-normal text-muted">{t(locale, 'profile.academic_file_subtitle')}</p>
            </div>
          </div>

          <StatusPill kind={statusKind} />
        </div>

        <!-- Student Data Grid -->
        <KeyValue
          columns={2}
          rows={[
            { label: t(locale, 'fields.card_id'), value: s?.card_id || '—', tnum: true, mono: true },
            { label: t(locale, 'fields.full_name'), value: `${s?.first_name || ''} ${s?.last_name || ''}`.trim() || '—' },
            { label: t(locale, 'fields.birth_date'), value: s?.birth_date || '—', tnum: true },
            { label: t(locale, 'fields.wilaya'), value: s?.wilaya || '—' },
            { label: t(locale, 'fields.study_level'), value: s?.study_level || '—' },
            { label: t(locale, 'fields.university'), value: s?.university || '—' },
            { label: t(locale, 'fields.faculty'), value: s?.faculty || '—' },
          ]}
        />
      </section>

      <!-- Institutional Notice -->
      <InlineBanner kind="info" title={t(locale, 'profile.academic_notice_title')} icon="info">
        {t(locale, 'profile.academic_notice_desc')}
      </InlineBanner>
    </div>

    <!-- Contact Info Form (Right / Bottom) -->
    <div class="flex flex-col gap-6 lg:col-span-5">
      <section class="card p-4 sm:p-6">
        <header class="border-b border-line pb-4 mb-6">
          <div class="flex items-center gap-3">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-input bg-subtle text-teal-600">
              <Icon name="mail" size={20} />
            </span>
            <div>
              <h2 class="card-title">{t(locale, 'profile.contact_coordinates_title')}</h2>
              <p class="text-small font-normal text-muted mt-0.5">{t(locale, 'profile.contact_coordinates_subtitle')}</p>
            </div>
          </div>
        </header>

        <form method="POST" action="/api/profile" class="flex flex-col gap-4">
          <div class="flex flex-col gap-2">
            <label class="label" for="phone">
              {t(locale, 'fields.phone')} <span class="text-danger" aria-hidden="true">*</span>
            </label>
            <input
              class="input tnum"
              type="tel"
              name="phone"
              id="phone"
              required
              autocomplete="tel"
              value={s?.phone ?? ''}
              placeholder="e.g. 0555123456"
            />
            <p class="field-hint">{t(locale, 'profile.phone_hint')}</p>
          </div>

          <div class="flex flex-col gap-2">
            <div class="flex items-center justify-between">
              <label class="label" for="email">
                {t(locale, 'profile.contact_email_label')}
              </label>
              <span class="inline-flex items-center gap-1 text-xs font-semibold text-teal-700 bg-teal-50 border border-teal-200 rounded px-2 py-0.5">
                <Icon name="check-circle" size={12} />
                <span>{t(locale, 'profile.verified_email_pill')}</span>
              </span>
            </div>
            <input
              class="input bg-subtle text-ink-2 cursor-not-allowed"
              type="email"
              name="email"
              id="email"
              readonly
              value={s?.email ?? ''}
              placeholder="e.g. resident@univ-tlemcen.dz"
            />
            <div class="flex items-center justify-between pt-1">
              <p class="field-hint">Housing allocations and maintenance updates are delivered here.</p>
              <a href="/account/add-email" class="link text-small font-medium shrink-0 ml-2">Change email →</a>
            </div>
          </div>

          <div class="pt-2">
            <button class="btn btn-primary w-full min-h-[44px]" type="submit">
              <Icon name="check-circle" size={18} />
              <span>{t(locale, 'profile.save_phone_btn')}</span>
            </button>
          </div>
        </form>
      </section>

      <!-- Account Security Card -->
      <section class="card p-4 sm:p-6">
        <div class="flex items-start gap-3">
          <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-input bg-subtle text-teal-600">
            <Icon name="lock" size={20} />
          </span>
          <div class="flex flex-col gap-1">
            <h2 class="card-title">Account security</h2>
            <p class="text-small font-normal text-muted">
              Your account is authenticated via your matriculation card ID or verified email. If you suspect unauthorized access, contact the Cité Universitaire IT desk immediately.
            </p>
          </div>
        </div>
      </section>
    </div>
  </div>
</Layout>
