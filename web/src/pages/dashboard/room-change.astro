---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { createSupabaseServerClient } from '../../lib/supabase';

export const prerender = false;

const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);
const uid = Astro.locals.user!.id;

const { data: student } = await supabase
  .from('students')
  .select('gender, status, room_id, rooms(block, floor, number)')
  .eq('id', uid)
  .single();

const isActive = student?.status === 'active' && !!student?.room_id;

const { data: rooms } = isActive
  ? await supabase
      .from('rooms')
      .select('id, block, floor, number, capacity, gender')
      .eq('gender', student?.gender ?? 'male')
      .order('block')
      .order('number')
  : { data: [] };

const { data: requests } = await supabase
  .from('room_change_requests')
  .select('id, reason, status, decision_note, preferred_room_id, created_at, rooms:preferred_room_id(block, floor, number)')
  .eq('student_id', uid)
  .order('created_at', { ascending: false });

const error = Astro.url.searchParams.get('error');
const created = Astro.url.searchParams.get('created');
const rawCurrentRoom = student?.rooms;
const currentRoom = (Array.isArray(rawCurrentRoom) ? rawCurrentRoom[0] : rawCurrentRoom) as { block: string; floor: string | number; number: string } | null | undefined;
---

<Layout title="Room Transfer Requests — Residence Tlemcen" activeNav="room-change">
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 border-b border-slate-200 pb-5">
    <div>
      <div class="flex items-center gap-2">
        <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-slate-900">
          Room Transfer Requests
        </h1>
      </div>
      <p class="mt-1 text-xs sm:text-sm text-slate-500">
        Apply for room reassignment or transfer between residential blocks.
      </p>
    </div>

    <a
      href="/dashboard"
      class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-600 hover:text-slate-900 bg-white border border-slate-200 px-3 py-1.5 rounded-lg shadow-xs transition self-start sm:self-auto"
    >
      <Icon name="arrow-left" size={14} />
      <span>Back to Dashboard</span>
    </a>
  </div>

  <!-- Feedback Alerts -->
  {created && (
    <div class="mt-6 flex items-start gap-3 rounded-xl border border-emerald-200 bg-emerald-50 p-4 text-emerald-900">
      <Icon name="check-circle" size={20} class="text-emerald-700 shrink-0 mt-0.5" />
      <div class="text-xs sm:text-sm">
        <span class="font-bold">Transfer Request Submitted!</span>
        <p class="mt-0.5 text-emerald-800">Your room-change request has been submitted to the housing administration for review.</p>
      </div>
    </div>
  )}

  {error && (
    <div class="mt-6 flex items-start gap-3 rounded-xl border border-red-200 bg-red-50 p-4 text-red-900">
      <Icon name="alert-circle" size={20} class="text-red-700 shrink-0 mt-0.5" />
      <div class="text-xs sm:text-sm">
        <span class="font-bold">Unable to Process Request</span>
        <p class="mt-0.5 text-red-800">{error}</p>
      </div>
    </div>
  )}

  <!-- Locked State or Application Form -->
  {!isActive ? (
    <div class="mt-6 rounded-xl border border-amber-300 bg-amber-50/80 p-5 sm:p-6 text-amber-950 shadow-xs">
      <div class="flex items-start gap-3.5">
        <div class="rounded-lg bg-amber-100 p-2 text-amber-700 shrink-0">
          <Icon name="lock" size={22} />
        </div>
        <div>
          <h2 class="text-base font-bold text-amber-950">Room-Change Submissions Locked</h2>
          <p class="mt-1 text-xs sm:text-sm text-amber-900 leading-relaxed">
            Your account status is <span class="font-bold uppercase tracking-wider">{student?.status ?? 'pending'}</span>.
            Room transfer requests can only be filed by approved residents currently occupying an allocated dormitory room.
          </p>
        </div>
      </div>
    </div>
  ) : (
    <div class="mt-6 space-y-6">
      <!-- Current Room Info Bar -->
      {currentRoom && (
        <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-xs flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-blue-50 text-blue-700">
              <Icon name="building" size={20} />
            </div>
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Current Assigned Room</span>
              <p class="text-sm font-bold text-slate-900">Block {currentRoom.block} — Room {currentRoom.number} (Floor {currentRoom.floor})</p>
            </div>
          </div>
          <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-slate-100 text-slate-700">Active Occupant</span>
        </div>
      )}

      <!-- Submission Card -->
      <div class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-8 shadow-xs">
        <div class="border-b border-slate-100 pb-4 mb-6">
          <h2 class="text-base font-bold text-slate-900">Submit a Room Transfer Request</h2>
          <p class="text-xs text-slate-500">Provide an objective justification (medical, study schedule, floor proximity).</p>
        </div>

        <form method="POST" action="/api/room-change" class="space-y-6">
          <div>
            <label for="reason" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
              Reason for Transfer Request <span class="text-red-500">*</span>
            </label>
            <textarea
              name="reason"
              id="reason"
              required
              rows="3"
              placeholder="Provide a detailed explanation for requesting a room change..."
              class="w-full rounded-lg border border-slate-300 p-3 text-sm text-slate-900 placeholder:text-slate-400 focus:border-blue-600 focus:ring-2 focus:ring-blue-600/20 focus:outline-none transition"
            ></textarea>
          </div>

          <div>
            <label for="preferred_room_id" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
              Preferred Room (Optional)
            </label>
            <select
              name="preferred_room_id"
              id="preferred_room_id"
              class="w-full rounded-lg border border-slate-300 p-2.5 text-sm text-slate-900 focus:border-blue-600 focus:ring-2 focus:ring-blue-600/20 focus:outline-none transition bg-white"
            >
              <option value="">No preference (Assign any available room in my block)</option>
              {(rooms ?? []).map((r) => (
                <option value={r.id}>
                  Block {r.block} — Room {r.number} (Floor {r.floor}, Capacity {r.capacity})
                </option>
              ))}
            </select>
            <span class="mt-1 block text-[11px] text-slate-400">
              Only rooms matching your residential block gender ({student?.gender}) are listed.
            </span>
          </div>

          <div class="pt-2">
            <button
              type="submit"
              class="inline-flex items-center justify-center gap-2 rounded-lg bg-slate-900 px-6 py-2.5 text-sm font-semibold text-white shadow-xs hover:bg-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-600 focus:ring-offset-2 transition cursor-pointer"
            >
              <Icon name="check-circle" size={16} />
              <span>Submit Transfer Request</span>
            </button>
          </div>
        </form>
      </div>
    </div>
  )}

  <!-- Request History -->
  <div class="mt-10 space-y-4">
    <div class="flex items-center justify-between">
      <h2 class="text-lg font-bold text-slate-900">Your Transfer Requests</h2>
      <span class="text-xs text-slate-400 font-medium">({requests?.length ?? 0} total requests)</span>
    </div>

    {(!requests || requests.length === 0) ? (
      <div class="rounded-xl border border-dashed border-slate-300 bg-white p-8 text-center text-slate-400">
        <Icon name="bed" size={32} class="mx-auto text-slate-300 mb-2" />
        <p class="text-sm font-medium text-slate-600">No transfer requests submitted</p>
        <p class="text-xs text-slate-400 mt-1">When you apply for a room transfer, status updates will appear here.</p>
      </div>
    ) : (
      <div class="space-y-4">
        {requests.map((r) => {
          const pref = Array.isArray(r.rooms) ? r.rooms[0] : r.rooms;
          return (
            <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-xs">
              <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 border-b border-slate-100 pb-3">
                <div class="flex items-center gap-2.5">
                  <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-slate-100 text-slate-700">
                    <Icon name="bed" size={16} />
                  </div>
                  <div>
                    <span class="font-bold text-sm text-slate-900">Room Transfer Request</span>
                    {pref ? (
                      <span class="text-xs text-slate-500 ml-2">Requested: Block {pref.block} — Room {pref.number}</span>
                    ) : (
                      <span class="text-xs text-slate-400 ml-2">No room preference specified</span>
                    )}
                  </div>
                </div>

                <div>
                  {r.status === 'approved' ? (
                    <span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 border border-emerald-200 px-3 py-1 text-xs font-semibold text-emerald-800">
                      <Icon name="check-circle" size={14} class="text-emerald-600" /> Approved
                    </span>
                  ) : r.status === 'rejected' ? (
                    <span class="inline-flex items-center gap-1 rounded-full bg-red-50 border border-red-200 px-3 py-1 text-xs font-semibold text-red-800">
                      <Icon name="x-circle" size={14} class="text-red-600" /> Rejected
                    </span>
                  ) : (
                    <span class="inline-flex items-center gap-1 rounded-full bg-amber-50 border border-amber-200 px-3 py-1 text-xs font-semibold text-amber-800">
                      <Icon name="clock" size={14} class="text-amber-600" /> Under Review
                    </span>
                  )}
                </div>
              </div>

              <div class="mt-3">
                <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider block mb-1">Stated Reason:</span>
                <p class="text-sm text-slate-700 leading-relaxed">{r.reason}</p>
              </div>

              {r.decision_note && (
                <div class="mt-3.5 rounded-lg border border-blue-200 bg-blue-50/60 p-3 text-xs text-blue-950">
                  <span class="font-bold uppercase tracking-wider text-blue-900 block text-[10px] mb-0.5">Administration Decision Note:</span>
                  <p class="font-medium">{r.decision_note}</p>
                </div>
              )}

              <div class="mt-3 pt-3 border-t border-slate-50 text-[11px] text-slate-400">
                Submitted on {new Date(r.created_at).toLocaleDateString()}
              </div>
            </div>
          );
        })}
      </div>
    )}
  </div>
</Layout>
