---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import PageHeader from '../../components/PageHeader.astro';
import StatusPill from '../../components/StatusPill.astro';
import InlineBanner from '../../components/InlineBanner.astro';
import EmptyState from '../../components/EmptyState.astro';
import { createSupabaseServerClient } from '../../lib/supabase';

import { t, formatDate, formatFloor, type SupportedLocale } from '../../lib/i18n';

export const prerender = false;
const locale: SupportedLocale = Astro.locals.locale || 'en';

const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);
const uid = Astro.locals.user!.id;

let student: any = null;
let requests: any[] = [];
let rawRooms: any[] = [];
let queryError: string | null = null;

try {
  const [stuRes, reqRes] = await Promise.all([
    supabase
      .from('students')
      .select('status, room_id, rooms(block, floor, number)')
      .eq('id', uid)
      .single(),
    supabase
      .from('room_change_requests')
      .select('id, reason, status, decision_note, preferred_room_id, created_at, rooms:preferred_room_id(block, floor, number)')
      .eq('student_id', uid)
      .order('created_at', { ascending: false }),
  ]);
  student = stuRes.data;
  requests = reqRes.data ?? [];

  if (student?.status === 'active' && Boolean(student?.room_id)) {
    const { data: roomsData } = await supabase
      .from('rooms')
      .select('id, block, floor, number, capacity')
      .order('block')
      .order('number');
    rawRooms = roomsData ?? [];
  }
} catch (err: any) {
  queryError = err?.message || 'The server is taking too long to respond. Check your connection and try again.';
}

const isActive = student?.status === 'active' && !!student?.room_id;
const hasPendingRequest = (requests ?? []).some((r: any) => r.status === 'pending');

const rooms = (rawRooms ?? []).filter((r: any) => r.id !== student?.room_id);

const error = Astro.url.searchParams.get('error');
const created = Astro.url.searchParams.get('created');
const rawCurrentRoom = student?.rooms;
const currentRoom = (Array.isArray(rawCurrentRoom) ? rawCurrentRoom[0] : rawCurrentRoom) as { block: string; floor: string | number; number: string } | null | undefined;

const motives = [
  {
    title: t(locale, 'room_change.motive_academic_title'),
    desc: t(locale, 'room_change.motive_academic_desc'),
    icon: 'file-text',
    text: t(locale, 'room_change.motive_academic_text'),
  },
  {
    title: t(locale, 'room_change.motive_health_title'),
    desc: t(locale, 'room_change.motive_health_desc'),
    icon: 'shield-check',
    text: t(locale, 'room_change.motive_health_text'),
  },
  {
    title: t(locale, 'room_change.motive_roommate_title'),
    desc: t(locale, 'room_change.motive_roommate_desc'),
    icon: 'arrow-left-right',
    text: t(locale, 'room_change.motive_roommate_text'),
  },
];
---

<Layout title={locale === 'fr' ? 'Changement de Chambre | RÉSIVO' : 'Room Transfer Portal | RÉSIVO'} activeNav="room-change">
  <PageHeader
    title={t(locale, 'room_change.portal_title')}
    subtitle={t(locale, 'room_change.portal_subtitle')}
  />

  <!-- Feedback Alerts -->
  {created && (
    <InlineBanner kind="success" title={t(locale, 'room_change.submitted_alert_title')} class="mb-6">
      {t(locale, 'room_change.submitted_alert_desc')}
    </InlineBanner>
  )}

  {queryError && (
    <InlineBanner kind="error" title={t(locale, 'errors.connection_error')} class="mb-6">
      {queryError}
    </InlineBanner>
  )}

  {error && (
    <InlineBanner kind="error" title={t(locale, 'common.error')} class="mb-6">
      {error}
    </InlineBanner>
  )}

  <!-- Locked State or Application Form -->
  {!isActive ? (
    <InlineBanner kind="warning" title={t(locale, 'room_change.locked_title')} icon="lock" class="mb-8">
      {locale === 'fr'
        ? `Le statut de votre dossier est ${student?.status ?? 'en attente'}. Les demandes de mutation de chambre ne peuvent être déposées que par des résidents admis occupant déjà une chambre universitaire.`
        : `Your account status is ${student?.status ?? 'pending'}. Room transfer requests can only be filed by approved residents who currently occupy an allocated dormitory room.`}
    </InlineBanner>
  ) : (
    <div class="flex flex-col gap-6 mb-8 max-w-3xl">
      <!-- Current Room Inline Summary Strip -->
      {currentRoom && (
        <div class="flex flex-wrap items-center justify-between gap-3 p-3.5 sm:px-5 rounded-card border border-line bg-surface">
          <div class="flex items-center gap-2.5 text-small">
            <span class="flex h-7 w-7 items-center justify-center rounded-input bg-teal-600/10 text-teal-600">
              <Icon name="building" size={15} />
            </span>
            <span class="text-muted">{t(locale, 'room_change.current_room_overline')} :</span>
            <strong class="font-semibold text-ink tnum">
              {t(locale, 'dashboard.block_room', { block: currentRoom.block, room: currentRoom.number })}
            </strong>
            <span class="text-muted">({formatFloor(currentRoom.floor, locale)})</span>
          </div>
          <StatusPill kind="ok" label={t(locale, 'room_change.current_occupant_pill')} size="sm" />
        </div>
      )}

      <!-- Submission Card or Pending Review Notice -->
      {hasPendingRequest ? (
        <InlineBanner kind="info" title={t(locale, 'room_change.petition_under_review_title')} icon="clock">
          {t(locale, 'room_change.petition_under_review_desc')}
        </InlineBanner>
      ) : (
        <section class="card p-4 sm:p-6">
          <header class="border-b border-line pb-4 mb-6">
            <h2 class="card-title">{t(locale, 'room_change.file_relocation_title')}</h2>
            <p class="text-small font-normal text-muted mt-1">{t(locale, 'room_change.file_relocation_desc')}</p>
          </header>

          <form method="POST" action="/api/room-change" class="flex flex-col gap-6">
            <!-- Motive Quick Selector Buttons (Zero emojis, authored icons, equal-height) -->
            <div class="flex flex-col gap-2">
              <span class="label">{t(locale, 'room_change.select_motive_label')}</span>
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-3" id="motivePills">
                {motives.map((m) => (
                  <button
                    type="button"
                    data-motive={m.text}
                    aria-pressed="false"
                    class="motive-pill text-start p-3.5 rounded-input border border-line bg-subtle hover:bg-canvas transition-colors cursor-pointer flex flex-col justify-between gap-2 min-h-[96px] h-full"
                  >
                    <div class="flex flex-col gap-1">
                      <div class="flex items-center gap-2">
                        <Icon name={m.icon} size={16} class="text-teal-600 shrink-0" />
                        <span class="font-display text-small font-semibold text-ink">{m.title}</span>
                      </div>
                      <span class="text-small text-muted leading-relaxed">{m.desc}</span>
                    </div>
                  </button>
                ))}
              </div>
            </div>

            <!-- Stated Reason Textarea -->
            <div class="flex flex-col gap-2">
              <label for="reason" class="label">{t(locale, 'room_change.justification_label')} <span class="text-danger" aria-hidden="true">*</span></label>
              <textarea
                name="reason"
                id="reason"
                required
                rows="3"
                placeholder={t(locale, 'room_change.justification_placeholder')}
                class="input min-h-[96px]"
              ></textarea>
            </div>

            <!-- Preferred Room Selector -->
            <div class="flex flex-col gap-2">
              <label for="preferred_room_id" class="label">{t(locale, 'room_change.preferred_room_label')}</label>
              <select
                name="preferred_room_id"
                id="preferred_room_id"
                class="input min-h-[44px]"
              >
                <option value="">{t(locale, 'room_change.no_preference_option')}</option>
                {(rooms ?? []).map((r) => (
                  <option value={r.id}>
                    {t(locale, 'room_change.room_option_format', { block: r.block, number: r.number, floor: formatFloor(r.floor, locale), capacity: r.capacity })}
                  </option>
                ))}
              </select>
            </div>

            <!-- Submit Button -->
            <div>
              <button type="submit" class="btn btn-primary min-h-[44px] whitespace-nowrap">
                <Icon name="check-circle" size={18} />
                <span>{t(locale, 'room_change.submit_btn')}</span>
              </button>
            </div>
          </form>
        </section>
      )}
    </div>
  )}

  <!-- Request History Docket -->
  <div class="flex flex-col gap-4">
    <div class="flex items-center justify-between border-b border-line pb-4">
      <h2 class="font-display text-h2 text-ink">{t(locale, 'room_change.history_heading')}</h2>
      <p class="text-small text-muted">
        {requests?.length === 1
          ? t(locale, 'room_change.total_requests', { count: requests.length })
          : t(locale, 'room_change.total_requests_plural', { count: requests?.length ?? 0 })}
      </p>
    </div>

    {(!requests || requests.length === 0) ? (
      <EmptyState
        icon="arrow-left-right"
        title={t(locale, 'room_change.empty_title')}
        message={t(locale, 'room_change.empty_desc')}
      />
    ) : (
      <div class="flex flex-col gap-4">
        {requests.map((r) => {
          const pref = Array.isArray(r.rooms) ? r.rooms[0] : r.rooms;
          const statusKind = r.status === 'approved' ? 'ok' : r.status === 'rejected' ? 'danger' : 'review';
          return (
            <article class="card p-4 sm:p-6">
              <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 border-b border-line pb-4">
                <div class="flex items-center gap-3">
                  <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-input bg-subtle text-teal-600">
                    <Icon name="arrow-left-right" size={20} />
                  </span>
                  <div>
                    <div class="flex items-center gap-2">
                      <h3 class="font-display text-h3 text-ink">{t(locale, 'room_change.petition_card_title')}</h3>
                      <span class="text-small font-normal text-muted tnum" dir="ltr">#TR-{r.id.slice(0, 8)}</span>
                    </div>
                    {pref ? (
                      <p class="text-small font-medium text-teal-600 mt-0.5">
                        {t(locale, 'room_change.petition_target_format', { block: pref.block, number: pref.number, floor: formatFloor(pref.floor, locale) })}
                      </p>
                    ) : (
                      <p class="text-small font-normal text-muted mt-0.5">
                        {t(locale, 'room_change.petition_open_assignment')}
                      </p>
                    )}
                  </div>
                </div>

                <div>
                  <StatusPill kind={statusKind} label={r.status === 'approved' ? t(locale, 'status.approved') : r.status === 'rejected' ? t(locale, 'status.rejected') : t(locale, 'status.under_review')} />
                </div>
              </div>

              <!-- Stated Reason -->
              <div class="mt-4">
                <span class="block text-small font-semibold text-muted mb-1">{t(locale, 'room_change.reason_label')}</span>
                <p class="text-body text-ink leading-relaxed">{r.reason}</p>
              </div>

              <!-- Administration Decision Note -->
              {r.decision_note && (
                <div class="mt-4 rounded-input border border-line bg-subtle p-3.5">
                  <span class="block text-small font-semibold text-muted mb-1">{t(locale, 'room_change.decision_note_label')}</span>
                  <p class="text-small font-normal text-ink leading-relaxed">{r.decision_note}</p>
                </div>
              )}

              <div class="mt-4 pt-3 border-t border-line text-small font-normal text-muted">
                {t(locale, 'room_change.submitted_on', { date: formatDate(locale, r.created_at) })}
              </div>
            </article>
          );
        })}
      </div>
    )}
  </div>

  <!-- Client-side Motive Fill Script -->
  <script>
    const motivePills = document.querySelectorAll('.motive-pill');
    const reasonTextarea = document.getElementById('reason') as HTMLTextAreaElement | null;

    if (reasonTextarea) {
      motivePills.forEach((pill) => {
        pill.addEventListener('click', () => {
          motivePills.forEach((p) => {
            p.classList.remove('border-teal-600', 'bg-teal-600/5', 'ring-1', 'ring-teal-600');
            p.setAttribute('aria-pressed', 'false');
          });
          pill.classList.add('border-teal-600', 'bg-teal-600/5', 'ring-1', 'ring-teal-600');
          pill.setAttribute('aria-pressed', 'true');
          const motiveText = pill.getAttribute('data-motive');
          if (motiveText) {
            reasonTextarea.value = motiveText;
            reasonTextarea.focus();
          }
        });
      });
    }
  </script>
</Layout>
