---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import PageHeader from '../../components/PageHeader.astro';
import StatusPill from '../../components/StatusPill.astro';
import InlineBanner from '../../components/InlineBanner.astro';
import EmptyState from '../../components/EmptyState.astro';
import { createSupabaseServerClient } from '../../lib/supabase';

export const prerender = false;

const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);
const uid = Astro.locals.user!.id;

const [{ data: student }, { data: requests }] = await Promise.all([
  supabase
    .from('students')
    .select('gender, status, room_id, rooms(block, floor, number)')
    .eq('id', uid)
    .single(),
  supabase
    .from('room_change_requests')
    .select('id, reason, status, decision_note, preferred_room_id, created_at, rooms:preferred_room_id(block, floor, number)')
    .eq('student_id', uid)
    .order('created_at', { ascending: false }),
]);

const isActive = student?.status === 'active' && !!student?.room_id;
const hasPendingRequest = (requests ?? []).some((r: any) => r.status === 'pending');

const { data: rawRooms } = isActive
  ? await supabase
      .from('rooms')
      .select('id, block, floor, number, capacity, gender')
      .eq('gender', student?.gender ?? 'male')
      .order('block')
      .order('number')
  : { data: [] };

const rooms = (rawRooms ?? []).filter((r: any) => r.id !== student?.room_id);

const error = Astro.url.searchParams.get('error');
const created = Astro.url.searchParams.get('created');
const rawCurrentRoom = student?.rooms;
const currentRoom = (Array.isArray(rawCurrentRoom) ? rawCurrentRoom[0] : rawCurrentRoom) as { block: string; floor: string | number; number: string } | null | undefined;

const motives = [
  {
    title: 'Academic needs',
    desc: 'Study environment / quiet wing',
    icon: 'file-text',
    text: 'Academic Schedule & Study Hours (Requires quieter floor for exam preparation)',
  },
  {
    title: 'Health & accessibility',
    desc: 'Floor level / physical mobility',
    icon: 'shield-check',
    text: 'Medical / Physical Accessibility (Requires lower floor or proximity to entrance)',
  },
  {
    title: 'Roommate & location',
    desc: 'Study partner proximity',
    icon: 'arrow-left-right',
    text: 'Proximity to Department Facilities & Study Partners',
  },
];
---

<Layout title="Room Transfer Portal — RÉSIVO" activeNav="room-change">
  <PageHeader
    title="Room transfer portal"
    overline="Cité Universitaire Tlemcen"
    subtitle="Apply for room reassignment or transfer within your designated dormitory block."
  >
    <Fragment slot="actions">
      <a href="/dashboard" class="btn btn-secondary">
        <Icon name="arrow-left" size={16} />
        <span>Back to dashboard</span>
      </a>
    </Fragment>
  </PageHeader>

  <!-- Feedback Alerts -->
  {created && (
    <InlineBanner kind="success" title="Transfer request submitted!" class="mb-6">
      Your transfer application has been filed in the administrative docket. Housing officers will review bed availability and update your petition here.
    </InlineBanner>
  )}

  {error && (
    <InlineBanner kind="error" title="Unable to process request" class="mb-6">
      {error}
    </InlineBanner>
  )}

  <!-- Locked State or Application Form -->
  {!isActive ? (
    <InlineBanner kind="warning" title="Room relocation portal locked" icon="lock" class="mb-8">
      Your account status is <strong class="uppercase">{student?.status ?? 'pending'}</strong>.
      Room transfer requests can only be filed by approved residents who currently occupy an allocated dormitory room.
    </InlineBanner>
  ) : (
    <div class="flex flex-col gap-6 mb-8">
      <!-- Current Room Info Bar -->
      {currentRoom && (
        <section class="card p-4 sm:p-6">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div class="flex items-center gap-3.5">
              <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-input bg-subtle text-teal-600">
                <Icon name="building" size={24} />
              </span>
              <div>
                <span class="overline">Current room assignment</span>
                <p class="font-display text-h2 text-ink mt-0.5">
                  Block {currentRoom.block} — Room {currentRoom.number}
                </p>
                <p class="text-small font-normal text-muted">
                  Floor {currentRoom.floor} · Designated for {student?.gender === 'female' ? 'Female' : 'Male'} Residents
                </p>
              </div>
            </div>
            <div>
              <StatusPill kind="ok" label="Current occupant" />
            </div>
          </div>
        </section>
      )}

      <!-- Submission Card or Pending Review Notice -->
      {hasPendingRequest ? (
        <InlineBanner kind="info" title="Transfer petition under review" icon="clock">
          You currently have an active room relocation petition undergoing administrative review. Additional transfer requests cannot be submitted until your pending request is reviewed.
        </InlineBanner>
      ) : (
        <section class="card p-4 sm:p-6">
          <header class="border-b border-line pb-4 mb-6">
            <h2 class="card-title">File a relocation request</h2>
            <p class="text-small font-normal text-muted mt-1">All requests are reviewed based on space availability and administrative eligibility.</p>
          </header>

          <form method="POST" action="/api/room-change" class="flex flex-col gap-6">
            <!-- Motive Quick Selector Buttons (Zero emojis, authored icons) -->
            <div class="flex flex-col gap-2">
              <span class="label">Select primary motive</span>
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-3" id="motivePills">
                {motives.map((m) => (
                  <button
                    type="button"
                    data-motive={m.text}
                    class="motive-pill text-left p-3.5 rounded-card border border-line bg-subtle hover:bg-canvas transition cursor-pointer flex flex-col gap-1 min-h-[88px]"
                  >
                    <div class="flex items-center gap-2">
                      <Icon name={m.icon} size={16} class="text-teal-600 shrink-0" />
                      <span class="font-display text-small font-semibold text-ink">{m.title}</span>
                    </div>
                    <span class="text-small text-muted">{m.desc}</span>
                  </button>
                ))}
              </div>
            </div>

            <!-- Stated Reason Textarea -->
            <div class="flex flex-col gap-2">
              <label for="reason" class="label">Detailed justification <span class="text-danger" aria-hidden="true">*</span></label>
              <textarea
                name="reason"
                id="reason"
                required
                rows="3"
                placeholder="Provide a comprehensive explanation for your transfer request (e.g. Preparing Master thesis requiring quiet wing, medical documentation on file, etc.)..."
                class="input min-h-[96px]"
              ></textarea>
            </div>

            <!-- Preferred Room Selector -->
            <div class="flex flex-col gap-2">
              <label for="preferred_room_id" class="label">Preferred room (optional)</label>
              <select
                name="preferred_room_id"
                id="preferred_room_id"
                class="input min-h-[44px]"
              >
                <option value="">No preference (Assign any available room in my block)</option>
                {(rooms ?? []).map((r) => (
                  <option value={r.id}>
                    Block {r.block} — Room {r.number} (Floor {r.floor}, Capacity: {r.capacity} beds)
                  </option>
                ))}
              </select>
              <p class="field-hint">
                Only rooms matching your residential block gender ({student?.gender === 'female' ? 'Female' : 'Male'}) are listed.
              </p>
            </div>

            <!-- Submit Button -->
            <div>
              <button type="submit" class="btn btn-primary min-h-[44px]">
                <Icon name="check-circle" size={18} />
                <span>Submit relocation request</span>
              </button>
            </div>
          </form>
        </section>
      )}
    </div>
  )}

  <!-- Request History Docket -->
  <div class="flex flex-col gap-4">
    <div class="flex items-center justify-between border-b border-line pb-4">
      <h2 class="font-display text-h2 text-ink">Your relocation requests</h2>
      <p class="text-small text-muted">{requests?.length ?? 0} total request{requests?.length === 1 ? '' : 's'}</p>
    </div>

    {(!requests || requests.length === 0) ? (
      <EmptyState
        icon="arrow-left-right"
        title="No transfer requests submitted"
        message="When you apply for a room change, the status of your petition will appear here."
      />
    ) : (
      <div class="flex flex-col gap-4">
        {requests.map((r) => {
          const pref = Array.isArray(r.rooms) ? r.rooms[0] : r.rooms;
          const statusKind = r.status === 'approved' ? 'ok' : r.status === 'rejected' ? 'danger' : 'review';
          return (
            <article class="card p-4 sm:p-6">
              <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 border-b border-line pb-4">
                <div class="flex items-center gap-3">
                  <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-input bg-subtle text-teal-600">
                    <Icon name="arrow-left-right" size={20} />
                  </span>
                  <div>
                    <div class="flex items-center gap-2">
                      <h3 class="font-display text-h3 text-ink">Room transfer petition</h3>
                      <span class="text-small font-normal text-muted tnum">#TR-{r.id.slice(0, 8)}</span>
                    </div>
                    {pref ? (
                      <p class="text-small font-medium text-teal-600 mt-0.5">
                        Requested target: Block {pref.block} — Room {pref.number} (Floor {pref.floor})
                      </p>
                    ) : (
                      <p class="text-small font-normal text-muted mt-0.5">No specific room requested (Open assignment)</p>
                    )}
                  </div>
                </div>

                <div>
                  <StatusPill kind={statusKind} label={r.status === 'approved' ? 'Approved' : r.status === 'rejected' ? 'Rejected' : 'Under review'} />
                </div>
              </div>

              <!-- Stated Reason -->
              <div class="mt-4">
                <span class="overline block text-muted mb-1">Stated justification</span>
                <p class="text-body text-ink leading-relaxed">{r.reason}</p>
              </div>

              <!-- Administration Decision Note -->
              {r.decision_note && (
                <div class="mt-4 rounded-card border border-line bg-subtle p-3.5">
                  <span class="overline block text-muted mb-1">Housing administration decision</span>
                  <p class="text-small font-normal text-ink leading-relaxed">{r.decision_note}</p>
                </div>
              )}

              <div class="mt-4 pt-3 border-t border-line text-small font-normal text-muted">
                Submitted on {new Date(r.created_at).toLocaleDateString()}
              </div>
            </article>
          );
        })}
      </div>
    )}
  </div>

  <!-- Client-side Motive Fill Script -->
  <script>
    const motivePills = document.querySelectorAll('.motive-pill');
    const reasonTextarea = document.getElementById('reason') as HTMLTextAreaElement | null;

    if (reasonTextarea) {
      motivePills.forEach((pill) => {
        pill.addEventListener('click', () => {
          const motiveText = pill.getAttribute('data-motive');
          if (motiveText) {
            reasonTextarea.value = motiveText;
            reasonTextarea.focus();
          }
        });
      });
    }
  </script>
</Layout>
