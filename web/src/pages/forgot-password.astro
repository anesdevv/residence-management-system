---
/**
 * RÉSIVO — forgot password (Phase 4).
 * Accepts card ID or email, requests OTP recovery code and link, supports OTP input & resend cooldown.
 */
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import BrandMark from '../components/BrandMark.astro';
import InlineBanner from '../components/InlineBanner.astro';
import PageHeader from '../components/PageHeader.astro';
import OtpInput from '../components/OtpInput.astro';
import ResendButton from '../components/ResendButton.astro';
import { maskEmail } from '../lib/validation';
import { localizePath, t, type SupportedLocale } from '../lib/i18n';

export const prerender = false;
const locale: SupportedLocale = Astro.locals.locale || 'en';

const error = Astro.url.searchParams.get('error');
const sent = Astro.url.searchParams.get('sent');
const identifier = Astro.url.searchParams.get('identifier') || '';
const cookieEmail = Astro.cookies.get('resivo_pending_email')?.value || '';
const targetEmail = identifier.includes('@') ? identifier : cookieEmail;
const maskedTarget = targetEmail ? maskEmail(targetEmail) : '';
---

<Layout title={locale === 'fr' ? 'Mot de Passe Oublié — RÉSIVO' : 'Forgot Password — RÉSIVO'} activeNav="login">
  <div class="mx-auto flex w-full max-w-md flex-col gap-6 py-6 sm:py-8">
    <div class="card p-6 sm:p-8">
      <div class="mb-6 flex justify-center">
        <BrandMark variant="mark" size={48} />
      </div>

      <PageHeader
        title={t(locale, 'auth.forgot_title')}
        overline={t(locale, 'auth.forgot_overline')}
        subtitle={t(locale, 'auth.forgot_subtitle')}
      />

      {
        error && (
          <InlineBanner kind="error" title={t(locale, 'common.error')} class="mb-4">
            {error}
          </InlineBanner>
        )
      }

      {
        sent ? (
          <div>
            <InlineBanner kind="info" title={t(locale, 'auth.forgot_sent_title')} class="mb-6">
              {t(locale, 'auth.forgot_sent_desc')}
            </InlineBanner>

            {maskedTarget && (
              <div class="mb-6 rounded-card border border-line bg-subtle p-3 text-center">
                <span class="text-xs font-medium text-muted uppercase tracking-wider block">{t(locale, 'auth.forgot_target_email')}</span>
                <span class="font-mono text-small font-bold text-navy-900">{maskedTarget}</span>
              </div>
            )}

            <form method="POST" action="/api/auth/verify-code" class="flex flex-col gap-6">
              <input type="hidden" name="email" value={targetEmail} />
              <input type="hidden" name="type" value="recovery" />

              <div class="flex flex-col gap-2">
                <label class="label text-center" for="token">
                  {locale === 'fr' ? 'Code de récupération à 6 chiffres' : '6-digit recovery code'}{' '}
                  <span class="text-danger" aria-hidden="true">*</span>
                </label>
                <OtpInput length={6} name="token" id="token" required />
                <p class="field-hint text-center">
                  {locale === 'fr'
                    ? 'Saisissez le code numérique reçu par e-mail. Vérifiez vos spams si besoin.'
                    : 'Enter the numeric code from your recovery email. Check spam if not received.'}
                </p>
              </div>

              <button class="btn btn-primary w-full" type="submit">
                <Icon name="check-circle" size={18} />
                <span>{locale === 'fr' ? 'Valider le code et continuer' : 'Verify code & continue'}</span>
              </button>
            </form>

            <div class="mt-6 border-t border-line pt-6">
              <ResendButton
                endpoint="/api/auth/resend-code"
                identifierKey="email"
                identifierValue={targetEmail}
                flow="recovery"
              />
            </div>

            <div class="mt-6 border-t border-line pt-4 text-center">
              <a class="link text-small" href={localizePath(locale, '/forgot-password')}>
                ← {locale === 'fr' ? 'Utiliser un autre identifiant' : 'Try a different card ID or email'}
              </a>
            </div>
          </div>
        ) : (
          <form method="POST" action="/api/auth/request-password-reset" class="flex flex-col gap-4">
            <div class="flex flex-col gap-2">
              <label class="label" for="identifier">{t(locale, 'auth.login_card_or_email')} <span class="text-danger" aria-hidden="true">*</span></label>
              <input
                class="input tnum"
                type="text"
                name="identifier"
                id="identifier"
                required
                autocomplete="username"
                placeholder={t(locale, 'auth.login_card_or_email_placeholder')}
              />
              <p class="field-hint">
                {locale === 'fr'
                  ? 'Saisissez soit votre N° de carte étudiant, soit votre adresse e-mail universitaire.'
                  : 'Enter either your matriculation card number or your personal university email address.'}
              </p>
            </div>

            <button class="btn btn-primary w-full mt-2" type="submit">
              <Icon name="mail" size={18} />
              <span>{t(locale, 'auth.forgot_btn')}</span>
            </button>
          </form>
        )
      }

      <div class="mt-6 flex flex-col gap-2 border-t border-line pt-6 text-center">
        <p class="text-small font-normal text-muted">
          {locale === 'fr' ? 'Vous vous souvenez de votre mot de passe\u00A0?' : 'Remember your password?'}{' '}
          <a class="link font-semibold" href={localizePath(locale, '/login')}>{t(locale, 'auth.sign_in')}</a>
        </p>
      </div>
    </div>

    <p class="text-center text-small font-normal text-muted">
      Direction des Œuvres Universitaires · Cité Universitaire Tlemcen
    </p>
  </div>
</Layout>
