---
/**
 * RÉSIVO — resident registration (docs/DESIGN.md §8, plan Phase 4).
 * Multi-section form on cards: academic enrollment, identity & civil status,
 * contact, portal security. Every field name/id/required/autocomplete and the
 * POST target are exactly as before — the API expects the same field names.
 */
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import BrandMark from '../components/BrandMark.astro';
import InlineBanner from '../components/InlineBanner.astro';
import PageHeader from '../components/PageHeader.astro';

export const prerender = false;
const error = Astro.url.searchParams.get('error');
const levels = ['L1', 'L2', 'L3', 'M1', 'M2', 'Doctorat'];

const panelItems = [
  {
    icon: 'shield-check',
    title: 'Roster cross-verification',
    copy: 'Automated validation against official university enrollment lists.',
  },
  {
    icon: 'wrench',
    title: 'Maintenance triage with photos',
    copy: 'Submit repair reports with photo attachments once assigned.',
  },
  {
    icon: 'arrow-left-right',
    title: 'Room relocation portal',
    copy: 'Request room swaps and floor preference adjustments online.',
  },
  {
    icon: 'building',
    title: 'Cité Universitaire · Tlemcen',
    copy: 'Direction des Œuvres Universitaires (DOU).',
  },
];
---

<Layout title="Resident Registration — RÉSIVO" activeNav="register">
  <div class="flex flex-col gap-6">
    <PageHeader
      title="New resident registration"
      overline="DOU Tlemcen · Official admissions file"
      subtitle="Complete your accommodation application with your official university matriculation data. Your student card ID will be verified against the university roster prior to room allocation."
    />

    {
      error && (
        <InlineBanner kind="error" title="Application error">
          {error}
        </InlineBanner>
      )
    }

    <div class="grid gap-6 lg:grid-cols-12 lg:items-start">
      <form method="POST" action="/api/register" class="flex flex-col gap-6 lg:col-span-8">
        <!-- 1 · Academic enrollment -->
        <section class="card p-4 sm:p-6">
          <header class="flex items-start gap-3 border-b border-line pb-4">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-input bg-subtle text-teal-600">
              <Icon name="file-spreadsheet" size={20} />
            </span>
            <div class="min-w-0">
              <h2 class="card-title">Academic enrollment details</h2>
              <p class="mt-0.5 text-small font-normal text-muted">
                University registration records as listed on your student card
              </p>
            </div>
          </header>

          <div class="grid grid-cols-1 gap-6 pt-4 sm:grid-cols-2">
            <div class="flex flex-col gap-2 sm:col-span-2">
              <label class="label" for="card_id">Student card ID (Carte d'étudiant) <span class="text-danger" aria-hidden="true">*</span></label>
              <input
                class="input tnum"
                type="text"
                name="card_id"
                id="card_id"
                required
                autocomplete="username"
                placeholder="e.g. 202338012345"
              />
              <p class="field-hint">
                Must match the exact matriculation ID on your physical university student card.
              </p>
            </div>

            <div class="flex flex-col gap-2">
              <label class="label" for="university">University <span class="text-danger" aria-hidden="true">*</span></label>
              <input
                class="input"
                type="text"
                name="university"
                id="university"
                required
                placeholder="e.g. Université Abou Bekr Belkaïd"
              />
            </div>

            <div class="flex flex-col gap-2">
              <label class="label" for="faculty">Faculty / Department <span class="text-danger" aria-hidden="true">*</span></label>
              <input
                class="input"
                type="text"
                name="faculty"
                id="faculty"
                required
                placeholder="e.g. Faculté des Sciences"
              />
            </div>

            <div class="flex flex-col gap-2 sm:col-span-2">
              <label class="label" for="study_level">Study level (Niveau d'études) <span class="text-danger" aria-hidden="true">*</span></label>
              <select class="select" name="study_level" id="study_level" required>
                {levels.map((l) => <option value={l}>{l}</option>)}
              </select>
            </div>
          </div>
        </section>

        <!-- 2 · Personal identity -->
        <section class="card p-4 sm:p-6">
          <header class="flex items-start gap-3 border-b border-line pb-4">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-input bg-subtle text-teal-600">
              <Icon name="user" size={20} />
            </span>
            <div class="min-w-0">
              <h2 class="card-title">Personal identity &amp; civil status</h2>
              <p class="mt-0.5 text-small font-normal text-muted">
                Used for dormitory block allocation and emergency records
              </p>
            </div>
          </header>

          <div class="grid grid-cols-1 gap-6 pt-4 sm:grid-cols-2">
            <div class="flex flex-col gap-2">
              <label class="label" for="first_name">First name (Prénom) <span class="text-danger" aria-hidden="true">*</span></label>
              <input
                class="input"
                type="text"
                name="first_name"
                id="first_name"
                required
                autocomplete="given-name"
                placeholder="e.g. Mohamed"
              />
            </div>

            <div class="flex flex-col gap-2">
              <label class="label" for="last_name">Last name (Nom) <span class="text-danger" aria-hidden="true">*</span></label>
              <input
                class="input"
                type="text"
                name="last_name"
                id="last_name"
                required
                autocomplete="family-name"
                placeholder="e.g. Benali"
              />
            </div>

            <div class="flex flex-col gap-2">
              <label class="label" for="birth_date">Date of birth <span class="text-danger" aria-hidden="true">*</span></label>
              <input class="input tnum" type="date" name="birth_date" id="birth_date" required />
            </div>

            <div class="flex flex-col gap-2">
              <label class="label" for="gender">Gender (for block assignment) <span class="text-danger" aria-hidden="true">*</span></label>
              <select class="select" name="gender" id="gender" required>
                <option value="male">Male (Bloc Garçons)</option>
                <option value="female">Female (Bloc Filles)</option>
              </select>
            </div>

            <div class="flex flex-col gap-2 sm:col-span-2">
              <label class="label" for="wilaya">Wilaya of origin <span class="text-danger" aria-hidden="true">*</span></label>
              <input
                class="input"
                type="text"
                name="wilaya"
                id="wilaya"
                required
                placeholder="e.g. Oran, Sidi Bel Abbès, Mostaganem..."
              />
            </div>
          </div>
        </section>

        <!-- 3 · Contact -->
        <section class="card p-4 sm:p-6">
          <header class="flex items-start gap-3 border-b border-line pb-4">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-input bg-subtle text-teal-600">
              <Icon name="phone" size={20} />
            </span>
            <div class="min-w-0">
              <h2 class="card-title">Contact</h2>
              <p class="mt-0.5 text-small font-normal text-muted">Used to notify you upon room assignment.</p>
            </div>
          </header>

          <div class="grid grid-cols-1 gap-6 pt-4 sm:grid-cols-2">
            <div class="flex flex-col gap-2">
              <label class="label" for="phone">Mobile phone <span class="text-danger" aria-hidden="true">*</span></label>
              <input
                class="input tnum"
                type="tel"
                name="phone"
                id="phone"
                required
                autocomplete="tel"
                placeholder="05 / 06 / 07..."
              />
            </div>

            <div class="flex flex-col gap-2">
              <label class="label" for="email">Email address (optional)</label>
              <input
                class="input"
                type="email"
                name="email"
                id="email"
                autocomplete="email"
                placeholder="student@univ-tlemcen.dz"
              />
            </div>
          </div>
        </section>

        <!-- 4 · Portal security -->
        <section class="card p-4 sm:p-6">
          <header class="flex items-start gap-3 border-b border-line pb-4">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-input bg-subtle text-teal-600">
              <Icon name="lock" size={20} />
            </span>
            <div class="min-w-0">
              <h2 class="card-title">Portal security</h2>
              <p class="mt-0.5 text-small font-normal text-muted">Used to sign in to the student portal.</p>
            </div>
          </header>

          <div class="flex flex-col gap-4 pt-4">
            <div class="flex flex-col gap-2">
              <label class="label" for="password">Portal password <span class="text-danger" aria-hidden="true">*</span></label>
              <input
                class="input"
                type="password"
                name="password"
                id="password"
                required
                autocomplete="new-password"
                minlength="8"
                placeholder="Minimum 8 characters"
              />
              <p class="field-hint">Must be at least 8 characters long. Keep this password safe.</p>
            </div>

            <div class="flex flex-col gap-2" role="group" aria-labelledby="pw-meter-caption">
              <div class="flex items-center justify-between gap-3">
                <span class="field-hint" id="pw-meter-caption">Password strength</span>
                <span class="text-small font-semibold text-ink-2" id="pw-meter-label" aria-live="polite">Not set</span>
              </div>
              <div class="flex gap-1" aria-hidden="true">
                <span class="h-1 flex-1 rounded-pill bg-subtle" data-pw-segment></span>
                <span class="h-1 flex-1 rounded-pill bg-subtle" data-pw-segment></span>
                <span class="h-1 flex-1 rounded-pill bg-subtle" data-pw-segment></span>
                <span class="h-1 flex-1 rounded-pill bg-subtle" data-pw-segment></span>
              </div>
              <p class="visually-hidden">
                Strength is reported as weak, fair, good or strong. It updates as you type.
              </p>
            </div>
          </div>
        </section>

        <!-- Submit -->
        <div class="card flex flex-col gap-4 p-4 sm:flex-row sm:items-center sm:justify-between sm:p-6">
          <a class="link text-small font-semibold" href="/login">Already registered? Sign in here →</a>
          <button class="btn btn-primary w-full sm:w-auto" type="submit">
            <Icon name="check-circle" size={18} />
            <span>Submit registration dossier</span>
          </button>
        </div>
      </form>

      <!-- Institutional side panel -->
      <aside class="rounded-hero bg-navy-900 p-6 text-on-dark lg:sticky lg:top-8 lg:col-span-4">
        <div class="flex items-center gap-3">
          <BrandMark variant="mark" tone="white" size={36} />
          <div>
            <span class="block font-display text-h2 text-surface">RÉSIVO</span>
            <span class="block text-small font-normal text-on-dark-2">Cité Universitaire · DOU Tlemcen</span>
          </div>
        </div>

        <div class="mt-6 flex flex-col gap-2">
          <h2 class="font-display text-h2 text-surface">Official university housing dossier</h2>
          <p class="text-small font-normal text-on-dark-2">
            Your official registration application for accommodation at Cité Universitaire Tlemcen.
          </p>
        </div>

        <ul class="mt-6 flex flex-col gap-3">
          {
            panelItems.map((item) => (
              <li class="flex items-start gap-3 rounded-card border border-navy-700 bg-navy-800 p-3">
                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-input bg-navy-900 text-gold-300">
                  <Icon name={item.icon} size={16} />
                </span>
                <div class="min-w-0">
                  <span class="block text-h3 text-surface">{item.title}</span>
                  <span class="mt-0.5 block text-small font-normal text-on-dark-2">{item.copy}</span>
                </div>
              </li>
            ))
          }
        </ul>

        <div
          class="mt-6 flex flex-wrap items-center justify-between gap-2 border-t border-navy-700 pt-4 text-small font-normal text-on-dark-2"
        >
          <span>Direction des Œuvres Universitaires</span>
          <span class="font-medium text-on-dark">Tlemcen, Algérie</span>
        </div>
      </aside>
    </div>
  </div>

  <!-- Password strength meter — reads the existing #password value, no dependency. -->
  <script is:inline>
    (function () {
      var input = document.getElementById('password');
      var label = document.getElementById('pw-meter-label');
      var segments = document.querySelectorAll('[data-pw-segment]');
      if (!input || !label || !segments.length) return;

      /* Token names only — the colours are resolved from :root once, at load. */
      var LEVELS = [
        { text: 'Weak', token: '--status-danger' },
        { text: 'Fair', token: '--status-pending' },
        { text: 'Good', token: '--status-progress' },
        { text: 'Strong', token: '--status-ok' },
      ];
      var rootStyle = getComputedStyle(document.documentElement);
      var TONES = LEVELS.map(function (level) {
        return { text: level.text, color: rootStyle.getPropertyValue(level.token).trim() };
      });

      function score(value) {
        var points = 0;
        if (value.length >= 8) points += 1;
        if (/[a-z]/.test(value) && /[A-Z]/.test(value)) points += 1;
        if (/\d/.test(value)) points += 1;
        if (/[^A-Za-z0-9]/.test(value) || value.length >= 12) points += 1;
        return points;
      }

      function render() {
        var points = input.value ? score(input.value) : 0;
        var level = points > 0 ? TONES[points - 1] : null;

        for (var i = 0; i < segments.length; i += 1) {
          segments[i].style.backgroundColor = level && i < points ? level.color : '';
        }
        label.textContent = level ? level.text : 'Not set';
        label.style.color = level ? level.color : '';
      }

      input.addEventListener('input', render);
      render();
    })();
  </script>
</Layout>
