---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';

export const prerender = false;
const error = Astro.url.searchParams.get('error');
const levels = ['L1', 'L2', 'L3', 'M1', 'M2', 'Doctorat'];
---

<Layout title="Resident Registration — Residence Tlemcen" activeNav="register">
  <div class="mx-auto max-w-3xl py-4 sm:py-8 lg:py-10">
    <div class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-10 shadow-xs">
      <!-- Title & Institutional Context -->
      <div class="border-b border-slate-100 pb-6">
        <div class="flex items-center gap-2 mb-3">
          <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-blue-50 text-blue-700">
            <Icon name="crest" size={18} />
          </div>
          <span class="text-xs font-semibold text-blue-900 tracking-wide">DOU Tlemcen • Official Admissions File</span>
        </div>

        <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-slate-900">
          New Resident Registration
        </h1>
        <p class="mt-2 text-xs sm:text-sm text-slate-500 leading-relaxed max-w-2xl">
          Complete your accommodation application with your official university matriculation data. Your student card ID will be verified against the university's official admissions roster prior to room allocation.
        </p>

        <!-- Visual Multi-Step Track -->
        <div class="mt-6 grid grid-cols-3 gap-2 sm:gap-4 text-center">
          <div class="rounded-xl bg-slate-50 border border-slate-200/80 p-2.5 sm:p-3">
            <span class="text-[11px] font-bold text-blue-600 uppercase tracking-wider block">Step 1</span>
            <span class="text-xs font-semibold text-slate-800">Academic Info</span>
          </div>
          <div class="rounded-xl bg-slate-50 border border-slate-200/80 p-2.5 sm:p-3">
            <span class="text-[11px] font-bold text-blue-600 uppercase tracking-wider block">Step 2</span>
            <span class="text-xs font-semibold text-slate-800">Civil Identity</span>
          </div>
          <div class="rounded-xl bg-slate-50 border border-slate-200/80 p-2.5 sm:p-3">
            <span class="text-[11px] font-bold text-blue-600 uppercase tracking-wider block">Step 3</span>
            <span class="text-xs font-semibold text-slate-800">Credentials</span>
          </div>
        </div>
      </div>

      <!-- Error Banner -->
      {error && (
        <div class="mt-6 flex items-start gap-3 rounded-xl border border-red-200 bg-red-50 p-4 text-red-950">
          <Icon name="alert-circle" size={20} class="text-red-700 shrink-0 mt-0.5" />
          <div class="text-xs sm:text-sm">
            <span class="font-bold">Application Error</span>
            <p class="mt-0.5 text-red-800 leading-relaxed">{error}</p>
          </div>
        </div>
      )}

      <form method="POST" action="/api/register" class="mt-8 space-y-8">
        <!-- Section 1: Academic Information -->
        <div class="space-y-4">
          <div>
            <h2 class="text-base font-bold text-slate-900 flex items-center gap-2">
              <span class="flex h-6 w-6 items-center justify-center rounded-full bg-slate-900 text-white text-xs font-bold">1</span>
              <span>Academic Enrollment Details</span>
            </h2>
            <p class="text-xs text-slate-400 mt-0.5 pl-8">University registration records as listed on your student badge</p>
          </div>

          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 pt-2">
            <div class="sm:col-span-2">
              <label for="card_id" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
                Student Card ID (Carte d'étudiant) <span class="text-red-500">*</span>
              </label>
              <input
                name="card_id"
                id="card_id"
                required
                autocomplete="username"
                placeholder="e.g. 202338012345"
                class="w-full min-h-[44px] rounded-xl border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 placeholder:text-slate-400 focus:border-blue-600 focus:ring-2 focus:ring-blue-600/20 focus:outline-none transition tnum"
              />
              <span class="mt-1.5 block text-[11px] text-slate-400">Must match the exact 12-digit matriculation ID on your physical university student card.</span>
            </div>

            <div>
              <label for="university" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
                University <span class="text-red-500">*</span>
              </label>
              <input
                name="university"
                id="university"
                required
                placeholder="e.g. Université Abou Bekr Belkaïd"
                class="w-full min-h-[44px] rounded-xl border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 placeholder:text-slate-400 focus:border-blue-600 focus:ring-2 focus:ring-blue-600/20 focus:outline-none transition"
              />
            </div>

            <div>
              <label for="faculty" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
                Faculty / Department <span class="text-red-500">*</span>
              </label>
              <input
                name="faculty"
                id="faculty"
                required
                placeholder="e.g. Faculté des Sciences"
                class="w-full min-h-[44px] rounded-xl border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 placeholder:text-slate-400 focus:border-blue-600 focus:ring-2 focus:ring-blue-600/20 focus:outline-none transition"
              />
            </div>

            <div class="sm:col-span-2">
              <label for="study_level" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
                Study Level (Niveau d'études) <span class="text-red-500">*</span>
              </label>
              <select
                name="study_level"
                id="study_level"
                required
                class="w-full min-h-[44px] rounded-xl border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 focus:border-blue-600 focus:ring-2 focus:ring-blue-600/20 focus:outline-none transition bg-white"
              >
                {levels.map((l) => <option value={l}>{l}</option>)}
              </select>
            </div>
          </div>
        </div>

        <!-- Section 2: Personal Identity -->
        <div class="space-y-4 pt-4 border-t border-slate-100">
          <div>
            <h2 class="text-base font-bold text-slate-900 flex items-center gap-2">
              <span class="flex h-6 w-6 items-center justify-center rounded-full bg-slate-900 text-white text-xs font-bold">2</span>
              <span>Personal Identity & Civil Status</span>
            </h2>
            <p class="text-xs text-slate-400 mt-0.5 pl-8">Used for dormitory block allocation and emergency records</p>
          </div>

          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 pt-2">
            <div>
              <label for="first_name" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
                First Name (Prénom) <span class="text-red-500">*</span>
              </label>
              <input
                name="first_name"
                id="first_name"
                required
                autocomplete="given-name"
                placeholder="e.g. Mohamed"
                class="w-full min-h-[44px] rounded-xl border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 placeholder:text-slate-400 focus:border-blue-600 focus:ring-2 focus:ring-blue-600/20 focus:outline-none transition"
              />
            </div>

            <div>
              <label for="last_name" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
                Last Name (Nom) <span class="text-red-500">*</span>
              </label>
              <input
                name="last_name"
                id="last_name"
                required
                autocomplete="family-name"
                placeholder="e.g. Benali"
                class="w-full min-h-[44px] rounded-xl border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 placeholder:text-slate-400 focus:border-blue-600 focus:ring-2 focus:ring-blue-600/20 focus:outline-none transition"
              />
            </div>

            <div>
              <label for="birth_date" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
                Date of Birth <span class="text-red-500">*</span>
              </label>
              <input
                type="date"
                name="birth_date"
                id="birth_date"
                required
                class="w-full min-h-[44px] rounded-xl border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 focus:border-blue-600 focus:ring-2 focus:ring-blue-600/20 focus:outline-none transition bg-white tnum"
              />
            </div>

            <div>
              <label for="gender" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
                Gender (for block assignment) <span class="text-red-500">*</span>
              </label>
              <select
                name="gender"
                id="gender"
                required
                class="w-full min-h-[44px] rounded-xl border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 focus:border-blue-600 focus:ring-2 focus:ring-blue-600/20 focus:outline-none transition bg-white"
              >
                <option value="male">Male (Bloc Garçons)</option>
                <option value="female">Female (Bloc Filles)</option>
              </select>
            </div>

            <div class="sm:col-span-2">
              <label for="wilaya" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
                Wilaya of Origin <span class="text-red-500">*</span>
              </label>
              <input
                name="wilaya"
                id="wilaya"
                required
                placeholder="e.g. Oran, Sidi Bel Abbès, Mostaganem..."
                class="w-full min-h-[44px] rounded-xl border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 placeholder:text-slate-400 focus:border-blue-600 focus:ring-2 focus:ring-blue-600/20 focus:outline-none transition"
              />
            </div>
          </div>
        </div>

        <!-- Section 3: Contact & Security Credentials -->
        <div class="space-y-4 pt-4 border-t border-slate-100">
          <div>
            <h2 class="text-base font-bold text-slate-900 flex items-center gap-2">
              <span class="flex h-6 w-6 items-center justify-center rounded-full bg-slate-900 text-white text-xs font-bold">3</span>
              <span>Contact & Portal Password</span>
            </h2>
            <p class="text-xs text-slate-400 mt-0.5 pl-8">Used to notify you upon room handover and log in to the system</p>
          </div>

          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 pt-2">
            <div>
              <label for="phone" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
                Mobile Phone <span class="text-red-500">*</span>
              </label>
              <input
                type="tel"
                name="phone"
                id="phone"
                required
                autocomplete="tel"
                placeholder="05 / 06 / 07..."
                class="w-full min-h-[44px] rounded-xl border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 placeholder:text-slate-400 focus:border-blue-600 focus:ring-2 focus:ring-blue-600/20 focus:outline-none transition tnum"
              />
            </div>

            <div>
              <label for="email" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
                Email Address (Optional)
              </label>
              <input
                type="email"
                name="email"
                id="email"
                autocomplete="email"
                placeholder="student@univ-tlemcen.dz"
                class="w-full min-h-[44px] rounded-xl border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 placeholder:text-slate-400 focus:border-blue-600 focus:ring-2 focus:ring-blue-600/20 focus:outline-none transition"
              />
            </div>

            <div class="sm:col-span-2">
              <label for="password" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
                Portal Password <span class="text-red-500">*</span>
              </label>
              <input
                type="password"
                name="password"
                id="password"
                required
                autocomplete="new-password"
                minlength="8"
                placeholder="Minimum 8 characters"
                class="w-full min-h-[44px] rounded-xl border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 placeholder:text-slate-400 focus:border-blue-600 focus:ring-2 focus:ring-blue-600/20 focus:outline-none transition"
              />
              <span class="mt-1.5 block text-[11px] text-slate-400">Must be at least 8 characters long. Keep this password safe.</span>
            </div>
          </div>
        </div>

        <!-- Submit Controls -->
        <div class="border-t border-slate-100 pt-6 flex flex-col sm:flex-row items-center justify-between gap-4">
          <a href="/login" class="text-xs font-semibold text-slate-500 hover:text-blue-600 transition">
            Already registered? Sign in here →
          </a>
          <button
            type="submit"
            class="w-full sm:w-auto min-h-[48px] inline-flex items-center justify-center gap-2 rounded-xl bg-slate-900 px-8 py-3 text-sm font-semibold text-white shadow-xs hover:bg-blue-600 active:scale-[0.99] focus:outline-none focus:ring-2 focus:ring-blue-600 focus:ring-offset-2 transition cursor-pointer"
          >
            <Icon name="check-circle" size={18} />
            <span>Submit Registration Dossier</span>
          </button>
        </div>
      </form>
    </div>
  </div>
</Layout>
