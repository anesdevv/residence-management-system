---
/**
 * RÉSIVO — resident registration (docs/DESIGN.md §8, plan Phase 4).
 * Multi-section form on cards: academic enrollment, identity & civil status,
 * contact, portal security. Every field name/id/required/autocomplete and the
 * POST target are exactly as before — the API expects the same field names.
 */
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import BrandMark from '../components/BrandMark.astro';
import InlineBanner from '../components/InlineBanner.astro';
import PageHeader from '../components/PageHeader.astro';
import Turnstile from '../components/Turnstile.astro';
import { createSupabaseServerClient } from '../lib/supabase';
import { getResidencePublic, isRegistrationOpen, residenceHeaderLabel } from '../lib/residence';

import { localizePath, t, type SupportedLocale } from '../lib/i18n';

export const prerender = false;
const locale: SupportedLocale = Astro.locals.locale || 'en';
Astro.response.headers.set('Cache-Control', 'no-store, no-cache, must-revalidate, max-age=0');
const error = Astro.url.searchParams.get('error');
const levels = ['L1', 'L2', 'L3', 'M1', 'M2', 'Doctorat'];

const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);
const residence = await getResidencePublic(supabase);
const registrationClosed = residence.loaded && !isRegistrationOpen(residence);
const residenceTypeHeader = residenceHeaderLabel(locale, residence);

const panelItems = [
  {
    icon: 'shield-check',
    title: t(locale, 'auth.panel_roster_title'),
    copy: t(locale, 'auth.panel_roster_desc'),
  },
  {
    icon: 'wrench',
    title: t(locale, 'auth.panel_maintenance_title'),
    copy: t(locale, 'auth.panel_maintenance_desc'),
  },
  {
    icon: 'arrow-left-right',
    title: t(locale, 'auth.panel_transfer_title'),
    copy: t(locale, 'auth.panel_transfer_desc'),
  },
  {
    icon: 'building',
    title: t(locale, 'auth.panel_institution_title'),
    copy: t(locale, 'auth.panel_institution_desc'),
  },
];
---

<Layout title={locale === 'fr' ? 'Inscription Résident — RÉSIVO' : 'Resident Registration — RÉSIVO'} activeNav="register">
  <div class="flex flex-col gap-6">
    <PageHeader
      title={isRegistrationOpen(residence) ? residenceTypeHeader : t(locale, 'auth.register_title')}
      overline={residence.residenceName}
      subtitle={t(locale, 'auth.register_subtitle')}
    />

    {
      registrationClosed && (
        <InlineBanner kind="warning" title={t(locale, 'auth.registration_closed_title')} icon="lock">
          {t(locale, 'auth.registration_closed_desc')}
        </InlineBanner>
      )
    }

    {
      error && (
        <InlineBanner kind="error" title={t(locale, 'common.error')}>
          {error}
        </InlineBanner>
      )
    }

    <div class="grid gap-6 lg:grid-cols-12 lg:items-start">
      <form method="POST" action="/api/register" id="register-form" data-locale={locale} class="lg:col-span-8">
        <fieldset disabled={registrationClosed} class="flex flex-col gap-6 disabled:opacity-60">
        <!-- 1 · Academic enrollment -->
        <section class="card p-4 sm:p-6">
          <header class="flex items-start gap-3 border-b border-line pb-4">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-input bg-subtle text-teal-600">
              <Icon name="file-spreadsheet" size={20} />
            </span>
            <div class="min-w-0">
              <h2 class="card-title">{t(locale, 'auth.academic_details_title')}</h2>
              <p class="mt-0.5 text-small font-normal text-muted">
                {t(locale, 'auth.academic_details_desc')}
              </p>
            </div>
          </header>

          <div class="grid grid-cols-1 gap-5 pt-4 sm:grid-cols-2">
            <div class="flex flex-col gap-2 sm:col-span-2">
              <label class="label" for="card_id">{t(locale, 'auth.card_id_label')} <span class="text-danger" aria-hidden="true">*</span></label>
              <input
                class="input tnum"
                type="text"
                name="card_id"
                id="card_id"
                required
                autocomplete="username"
                dir="ltr"
                placeholder={t(locale, 'auth.login_card_id_placeholder')}
              />
              <p class="field-hint">
                {t(locale, 'auth.card_id_hint')}
              </p>
            </div>

            <div class="flex flex-col gap-2">
              <label class="label" for="university">{t(locale, 'fields.university')} <span class="text-danger" aria-hidden="true">*</span></label>
              <input
                class="input"
                type="text"
                name="university"
                id="university"
                required
                placeholder={t(locale, 'auth.university_placeholder')}
              />
            </div>

            <div class="flex flex-col gap-2">
              <label class="label" for="faculty">{t(locale, 'fields.faculty')} <span class="text-danger" aria-hidden="true">*</span></label>
              <input
                class="input"
                type="text"
                name="faculty"
                id="faculty"
                required
                placeholder={t(locale, 'auth.faculty_placeholder')}
              />
            </div>

            <div class="flex flex-col gap-2 sm:col-span-2">
              <label class="label" for="study_level">{t(locale, 'auth.study_level_label')} <span class="text-danger" aria-hidden="true">*</span></label>
              <select class="select" name="study_level" id="study_level" required>
                {levels.map((l) => <option value={l}>{l}</option>)}
              </select>
            </div>
          </div>
        </section>

        <!-- 2 · Personal identity -->
        <section class="card p-4 sm:p-6">
          <header class="flex items-start gap-3 border-b border-line pb-4">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-input bg-subtle text-teal-600">
              <Icon name="user" size={20} />
            </span>
            <div class="min-w-0">
              <h2 class="card-title">{t(locale, 'auth.personal_identity_title')}</h2>
              <p class="mt-0.5 text-small font-normal text-muted">
                {t(locale, 'auth.register_identity_hint')}
              </p>
            </div>
          </header>

          <div class="grid grid-cols-1 gap-5 pt-4 sm:grid-cols-2">
            <div class="flex flex-col gap-2">
              <label class="label" for="first_name">{t(locale, 'auth.first_name_label')} <span class="text-danger" aria-hidden="true">*</span></label>
              <input
                class="input"
                type="text"
                name="first_name"
                id="first_name"
                required
                autocomplete="given-name"
                placeholder={t(locale, 'auth.first_name_placeholder')}
              />
            </div>

            <div class="flex flex-col gap-2">
              <label class="label" for="last_name">{t(locale, 'auth.last_name_label')} <span class="text-danger" aria-hidden="true">*</span></label>
              <input
                class="input"
                type="text"
                name="last_name"
                id="last_name"
                required
                autocomplete="family-name"
                placeholder={t(locale, 'auth.last_name_placeholder')}
              />
            </div>

            <div class="flex flex-col gap-2">
              <label class="label" for="birth_date">{t(locale, 'fields.birth_date')} <span class="text-danger" aria-hidden="true">*</span></label>
              <input class="input tnum" type="date" name="birth_date" id="birth_date" dir="ltr" required />
            </div>

            <div class="flex flex-col gap-2">
              <label class="label" for="wilaya">{t(locale, 'auth.wilaya_label')} <span class="text-danger" aria-hidden="true">*</span></label>
              <input
                class="input"
                type="text"
                name="wilaya"
                id="wilaya"
                required
                placeholder={t(locale, 'auth.wilaya_placeholder')}
              />
            </div>
          </div>
        </section>

        <!-- 3 · Contact -->
        <section class="card p-4 sm:p-6">
          <header class="flex items-start gap-3 border-b border-line pb-4">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-input bg-subtle text-teal-600">
              <Icon name="phone" size={20} />
            </span>
            <div class="min-w-0">
              <h2 class="card-title">{t(locale, 'auth.contact_section_title')}</h2>
              <p class="mt-0.5 text-small font-normal text-muted">{t(locale, 'auth.contact_section_desc')}</p>
            </div>
          </header>

          <div class="grid grid-cols-1 gap-5 pt-4">
            <div class="flex flex-col gap-2">
              <label class="label" for="phone">{t(locale, 'auth.phone_label')} <span class="text-danger" aria-hidden="true">*</span></label>
              <input
                class="input tnum"
                type="tel"
                name="phone"
                id="phone"
                required
                autocomplete="tel"
                dir="ltr"
                placeholder="05 / 06 / 07..."
              />
              <p class="field-hint">{t(locale, 'auth.phone_hint')}</p>
            </div>
          </div>
        </section>

        <!-- 4 · Contact email & portal security -->
        <section class="card p-4 sm:p-6">
          <header class="flex items-start gap-3 border-b border-line pb-4">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-input bg-subtle text-teal-600">
              <Icon name="lock" size={20} />
            </span>
            <div class="min-w-0">
              <h2 class="card-title">{t(locale, 'auth.register_security_title')}</h2>
              <p class="mt-0.5 text-small font-normal text-muted">{t(locale, 'auth.register_security_desc')}</p>
            </div>
          </header>

          <div class="grid grid-cols-1 gap-5 pt-4 sm:grid-cols-2">
            <div class="flex flex-col gap-2">
              <label class="label" for="email">{t(locale, 'fields.contact_email')} <span class="text-danger" aria-hidden="true">*</span></label>
              <input
                class="input"
                type="email"
                name="email"
                id="email"
                required
                autocomplete="email"
                inputmode="email"
                maxlength="254"
                dir="ltr"
                placeholder="student@univ-tlemcen.dz"
              />
              <p class="field-hint">{t(locale, 'auth.email_hint')}</p>
            </div>

            <div class="flex flex-col gap-2">
              <label class="label" for="confirm_email">{t(locale, 'fields.confirm_email')} <span class="text-danger" aria-hidden="true">*</span></label>
              <input
                class="input"
                type="email"
                name="confirm_email"
                id="confirm_email"
                required
                autocomplete="email"
                inputmode="email"
                maxlength="254"
                dir="ltr"
                placeholder="student@univ-tlemcen.dz"
              />
            </div>

            <p id="email-match-error" class="field-error hidden sm:col-span-2" role="alert"></p>

            <div class="flex flex-col gap-2 sm:col-span-2">
              <label class="label" for="password">{t(locale, 'auth.portal_password_label')} <span class="text-danger" aria-hidden="true">*</span></label>
              <input
                class="input"
                type="password"
                name="password"
                id="password"
                required
                autocomplete="new-password"
                minlength="8"
                dir="ltr"
                placeholder="Minimum 8 characters"
              />
              <p class="field-hint">{t(locale, 'auth.portal_password_hint')}</p>
            </div>

            <div class="flex flex-col gap-2 sm:col-span-2" role="group" aria-labelledby="pw-meter-caption">
              <div class="flex items-center justify-between gap-3">
                <span class="field-hint" id="pw-meter-caption">{t(locale, 'auth.password_strength')}</span>
                <span
                  class="text-small font-semibold text-ink-2"
                  id="pw-meter-label"
                  aria-live="polite"
                  data-pw-not-set={t(locale, 'auth.pw_not_set')}
                  data-pw-weak={t(locale, 'auth.pw_weak')}
                  data-pw-fair={t(locale, 'auth.pw_fair')}
                  data-pw-good={t(locale, 'auth.pw_good')}
                  data-pw-strong={t(locale, 'auth.pw_strong')}
                >
                  {t(locale, 'auth.pw_not_set')}
                </span>
              </div>
              <div class="flex gap-1" aria-hidden="true">
                <span class="h-1 flex-1 rounded-pill bg-subtle" data-pw-segment></span>
                <span class="h-1 flex-1 rounded-pill bg-subtle" data-pw-segment></span>
                <span class="h-1 flex-1 rounded-pill bg-subtle" data-pw-segment></span>
                <span class="h-1 flex-1 rounded-pill bg-subtle" data-pw-segment></span>
              </div>
              <p class="visually-hidden">
                {t(locale, 'auth.password_strength_hint')}
              </p>
            </div>
          </div>
        </section>

        <!-- Submit -->
        <div class="card flex flex-col gap-4 p-4 sm:p-6">
          <div class="flex justify-center sm:justify-start">
            <Turnstile action="register" />
          </div>
          <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between border-t border-line pt-4">
            <a class="link text-small font-semibold" href={localizePath(locale, '/login')}>{t(locale, 'auth.register_have_account')} {t(locale, 'auth.sign_in')} →</a>
            <button class="btn btn-primary w-full sm:w-auto min-h-[44px]" type="submit" disabled={registrationClosed}>
              <Icon name="check-circle" size={18} />
              <span>{t(locale, 'auth.register_submit_btn')}</span>
            </button>
          </div>
        </div>
        </fieldset>
      </form>

      <!-- Institutional side panel -->
      <aside class="rounded-hero bg-navy-900 p-5 sm:p-6 text-on-dark lg:sticky lg:top-8 lg:col-span-4">
        <div class="flex items-center gap-3">
          <BrandMark variant="mark" tone="white" size={36} />
          <div>
            <span class="block font-display text-h2 text-surface">RÉSIVO</span>
            <span class="block text-small font-normal text-on-dark-2">Cité Universitaire · DOU Tlemcen</span>
          </div>
        </div>

        <div class="mt-6 flex flex-col gap-2">
          <h2 class="font-display text-h2 text-surface">{t(locale, 'auth.panel_dossier_title')}</h2>
          <p class="text-small font-normal text-on-dark-2">
            {t(locale, 'auth.panel_dossier_desc')}
          </p>
        </div>

        <ul class="mt-6 flex flex-col gap-3">
          {
            panelItems.map((item) => (
              <li class="flex items-start gap-3 rounded-card border border-navy-700 bg-navy-800 p-3">
                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-input bg-navy-900 text-gold-300">
                  <Icon name={item.icon} size={16} />
                </span>
                <div class="min-w-0">
                  <span class="block text-h3 text-surface">{item.title}</span>
                  <span class="mt-0.5 block text-small font-normal text-on-dark-2">{item.copy}</span>
                </div>
              </li>
            ))
          }
        </ul>

        <div
          class="mt-6 flex flex-wrap items-center justify-between gap-2 border-t border-navy-700 pt-4 text-small font-normal text-on-dark-2"
        >
          <span>Direction des Œuvres Universitaires</span>
          <span class="font-medium text-on-dark">Tlemcen, Algérie</span>
        </div>
      </aside>
    </div>
  </div>

  <!-- Password strength meter — reads the existing #password value, no dependency. -->
  <script is:inline>
    (function () {
      var input = document.getElementById('password');
      var label = document.getElementById('pw-meter-label');
      var segments = document.querySelectorAll('[data-pw-segment]');
      if (!input || !label || !segments.length) return;

      var textNotSet = label.getAttribute('data-pw-not-set') || 'Not set';
      var textWeak = label.getAttribute('data-pw-weak') || 'Weak';
      var textFair = label.getAttribute('data-pw-fair') || 'Fair';
      var textGood = label.getAttribute('data-pw-good') || 'Good';
      var textStrong = label.getAttribute('data-pw-strong') || 'Strong';

      /* Token names only — the colours are resolved from :root once, at load. */
      var LEVELS = [
        { text: textWeak, token: '--status-danger' },
        { text: textFair, token: '--status-pending' },
        { text: textGood, token: '--status-progress' },
        { text: textStrong, token: '--status-ok' },
      ];
      var rootStyle = getComputedStyle(document.documentElement);
      var TONES = LEVELS.map(function (level) {
        return { text: level.text, color: rootStyle.getPropertyValue(level.token).trim() };
      });

      function score(value) {
        var points = 0;
        if (value.length >= 8) points += 1;
        if (/[a-z]/.test(value) && /[A-Z]/.test(value)) points += 1;
        if (/\d/.test(value)) points += 1;
        if (/[^A-Za-z0-9]/.test(value) || value.length >= 12) points += 1;
        return points;
      }

      function render() {
        var points = input.value ? score(input.value) : 0;
        var level = points > 0 ? TONES[points - 1] : null;

        for (var i = 0; i < segments.length; i += 1) {
          segments[i].style.backgroundColor = level && i < points ? level.color : '';
        }
        label.textContent = level ? level.text : textNotSet;
        label.style.color = level ? level.color : '';
      }

      input.addEventListener('input', render);
      render();
    })();
  </script>

  <script>
    import { attachEmailConfirmValidation } from '../lib/email-form-client';
    import type { SupportedLocale } from '../lib/i18n';

    const form = document.getElementById('register-form') as HTMLFormElement | null;
    const emailInput = document.getElementById('email') as HTMLInputElement | null;
    const confirmInput = document.getElementById('confirm_email') as HTMLInputElement | null;
    const errorEl = document.getElementById('email-match-error');
    const locale = ((form?.getAttribute('data-locale') || 'en') as SupportedLocale);

    if (form && emailInput && confirmInput) {
      attachEmailConfirmValidation({ form, emailInput, confirmInput, errorEl, locale });
    }
  </script>
</Layout>
