---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';

export const prerender = false;
const error = Astro.url.searchParams.get('error');
const levels = ['L1', 'L2', 'L3', 'M1', 'M2', 'Doctorat'];
---

<Layout title="Resident Registration — RÉSIVO" activeNav="register">
  <div class="mx-auto max-w-7xl py-4 sm:py-8 lg:py-10">
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 items-start">
      <!-- Left Column: Registration Form Container -->
      <div class="lg:col-span-8 flex flex-col justify-between">
        <div class="rounded-2xl border border-line/70 bg-surface p-6 sm:p-10 shadow-sm">
          <!-- Title & Institutional Context -->
          <div class="border-b border-line/50 pb-6">
            <div class="mb-3 inline-flex items-center gap-2 rounded-full bg-canvas px-3 py-1 text-xs font-semibold text-amber-ink">
              <span class="inline-block h-1.5 w-1.5 rounded-full bg-amber"></span>
              <span>DOU Tlemcen • Official Admissions File</span>
            </div>

            <h1 class="font-display text-2xl sm:text-3xl font-extrabold tracking-tight text-navy">
              New Resident Registration
            </h1>
            <p class="mt-2 text-xs sm:text-sm text-muted leading-relaxed max-w-2xl">
              Complete your accommodation application with your official university matriculation data. Your student card ID will be verified against the university roster prior to room allocation.
            </p>

            <!-- Visual Multi-Step Track -->
            <div class="mt-6 grid grid-cols-3 gap-2 sm:gap-4 text-center">
              <div class="rounded-xl bg-canvas border border-line/60 p-2.5 sm:p-3">
                <span class="text-[11px] font-bold text-amber-ink uppercase tracking-wider block">Step 1</span>
                <span class="text-xs font-semibold text-ink">Academic Info</span>
              </div>
              <div class="rounded-xl bg-canvas border border-line/60 p-2.5 sm:p-3">
                <span class="text-[11px] font-bold text-amber-ink uppercase tracking-wider block">Step 2</span>
                <span class="text-xs font-semibold text-ink">Civil Identity</span>
              </div>
              <div class="rounded-xl bg-canvas border border-line/60 p-2.5 sm:p-3">
                <span class="text-[11px] font-bold text-amber-ink uppercase tracking-wider block">Step 3</span>
                <span class="text-xs font-semibold text-ink">Credentials</span>
              </div>
            </div>
          </div>

          <!-- Error Banner -->
          {error && (
            <div class="mt-6 flex items-start gap-3 rounded-xl border border-red-200 bg-red-50 p-4 text-red-950">
              <Icon name="alert-circle" size={20} class="text-red-700 shrink-0 mt-0.5" />
              <div class="text-xs sm:text-sm">
                <span class="font-bold">Application Error</span>
                <p class="mt-0.5 text-red-800 leading-relaxed">{error}</p>
              </div>
            </div>
          )}

          <form method="POST" action="/api/register" class="mt-8 space-y-8">
            <!-- Section 1: Academic Information -->
            <div class="space-y-4">
              <div>
                <h2 class="font-display text-base font-bold text-navy flex items-center gap-2">
                  <span class="flex h-6 w-6 items-center justify-center rounded-full bg-navy text-white text-xs font-bold">1</span>
                  <span>Academic Enrollment Details</span>
                </h2>
                <p class="text-xs text-muted mt-0.5 pl-8">University registration records as listed on your student card</p>
              </div>

              <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 pt-2">
                <div class="sm:col-span-2">
                  <label for="card_id" class="block text-xs font-bold uppercase tracking-wider text-navy mb-1.5">
                    Student Card ID (Carte d'étudiant) <span class="text-red-500">*</span>
                  </label>
                  <input
                    type="text"
                    name="card_id"
                    id="card_id"
                    required
                    autocomplete="username"
                    placeholder="e.g. 202338012345"
                    class="w-full min-h-[44px] rounded-xl border border-line bg-canvas/40 px-3.5 py-2.5 text-sm text-ink placeholder:text-muted/60 focus:border-navy focus:bg-surface focus:ring-2 focus:ring-navy/15 focus:outline-none transition tnum"
                  />
                  <span class="mt-1.5 block text-[11px] text-muted">Must match the exact matriculation ID on your physical university student card.</span>
                </div>

                <div>
                  <label for="university" class="block text-xs font-bold uppercase tracking-wider text-navy mb-1.5">
                    University <span class="text-red-500">*</span>
                  </label>
                  <input
                    type="text"
                    name="university"
                    id="university"
                    required
                    placeholder="e.g. Université Abou Bekr Belkaïd"
                    class="w-full min-h-[44px] rounded-xl border border-line bg-canvas/40 px-3.5 py-2.5 text-sm text-ink placeholder:text-muted/60 focus:border-navy focus:bg-surface focus:ring-2 focus:ring-navy/15 focus:outline-none transition"
                  />
                </div>

                <div>
                  <label for="faculty" class="block text-xs font-bold uppercase tracking-wider text-navy mb-1.5">
                    Faculty / Department <span class="text-red-500">*</span>
                  </label>
                  <input
                    type="text"
                    name="faculty"
                    id="faculty"
                    required
                    placeholder="e.g. Faculté des Sciences"
                    class="w-full min-h-[44px] rounded-xl border border-line bg-canvas/40 px-3.5 py-2.5 text-sm text-ink placeholder:text-muted/60 focus:border-navy focus:bg-surface focus:ring-2 focus:ring-navy/15 focus:outline-none transition"
                  />
                </div>

                <div class="sm:col-span-2">
                  <label for="study_level" class="block text-xs font-bold uppercase tracking-wider text-navy mb-1.5">
                    Study Level (Niveau d'études) <span class="text-red-500">*</span>
                  </label>
                  <select
                    name="study_level"
                    id="study_level"
                    required
                    class="w-full min-h-[44px] rounded-xl border border-line bg-canvas/40 px-3.5 py-2.5 text-sm text-ink focus:border-navy focus:bg-surface focus:ring-2 focus:ring-navy/15 focus:outline-none transition"
                  >
                    {levels.map((l) => <option value={l}>{l}</option>)}
                  </select>
                </div>
              </div>
            </div>

            <!-- Section 2: Personal Identity -->
            <div class="space-y-4 pt-4 border-t border-line/50">
              <div>
                <h2 class="font-display text-base font-bold text-navy flex items-center gap-2">
                  <span class="flex h-6 w-6 items-center justify-center rounded-full bg-navy text-white text-xs font-bold">2</span>
                  <span>Personal Identity &amp; Civil Status</span>
                </h2>
                <p class="text-xs text-muted mt-0.5 pl-8">Used for dormitory block allocation and emergency records</p>
              </div>

              <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 pt-2">
                <div>
                  <label for="first_name" class="block text-xs font-bold uppercase tracking-wider text-navy mb-1.5">
                    First Name (Prénom) <span class="text-red-500">*</span>
                  </label>
                  <input
                    type="text"
                    name="first_name"
                    id="first_name"
                    required
                    autocomplete="given-name"
                    placeholder="e.g. Mohamed"
                    class="w-full min-h-[44px] rounded-xl border border-line bg-canvas/40 px-3.5 py-2.5 text-sm text-ink placeholder:text-muted/60 focus:border-navy focus:bg-surface focus:ring-2 focus:ring-navy/15 focus:outline-none transition"
                  />
                </div>

                <div>
                  <label for="last_name" class="block text-xs font-bold uppercase tracking-wider text-navy mb-1.5">
                    Last Name (Nom) <span class="text-red-500">*</span>
                  </label>
                  <input
                    type="text"
                    name="last_name"
                    id="last_name"
                    required
                    autocomplete="family-name"
                    placeholder="e.g. Benali"
                    class="w-full min-h-[44px] rounded-xl border border-line bg-canvas/40 px-3.5 py-2.5 text-sm text-ink placeholder:text-muted/60 focus:border-navy focus:bg-surface focus:ring-2 focus:ring-navy/15 focus:outline-none transition"
                  />
                </div>

                <div>
                  <label for="birth_date" class="block text-xs font-bold uppercase tracking-wider text-navy mb-1.5">
                    Date of Birth <span class="text-red-500">*</span>
                  </label>
                  <input
                    type="date"
                    name="birth_date"
                    id="birth_date"
                    required
                    class="w-full min-h-[44px] rounded-xl border border-line bg-canvas/40 px-3.5 py-2.5 text-sm text-ink focus:border-navy focus:bg-surface focus:ring-2 focus:ring-navy/15 focus:outline-none transition tnum"
                  />
                </div>

                <div>
                  <label for="gender" class="block text-xs font-bold uppercase tracking-wider text-navy mb-1.5">
                    Gender (for block assignment) <span class="text-red-500">*</span>
                  </label>
                  <select
                    name="gender"
                    id="gender"
                    required
                    class="w-full min-h-[44px] rounded-xl border border-line bg-canvas/40 px-3.5 py-2.5 text-sm text-ink focus:border-navy focus:bg-surface focus:ring-2 focus:ring-navy/15 focus:outline-none transition"
                  >
                    <option value="male">Male (Bloc Garçons)</option>
                    <option value="female">Female (Bloc Filles)</option>
                  </select>
                </div>

                <div class="sm:col-span-2">
                  <label for="wilaya" class="block text-xs font-bold uppercase tracking-wider text-navy mb-1.5">
                    Wilaya of Origin <span class="text-red-500">*</span>
                  </label>
                  <input
                    type="text"
                    name="wilaya"
                    id="wilaya"
                    required
                    placeholder="e.g. Oran, Sidi Bel Abbès, Mostaganem..."
                    class="w-full min-h-[44px] rounded-xl border border-line bg-canvas/40 px-3.5 py-2.5 text-sm text-ink placeholder:text-muted/60 focus:border-navy focus:bg-surface focus:ring-2 focus:ring-navy/15 focus:outline-none transition"
                  />
                </div>
              </div>
            </div>

            <!-- Section 3: Contact & Security Credentials -->
            <div class="space-y-4 pt-4 border-t border-line/50">
              <div>
                <h2 class="font-display text-base font-bold text-navy flex items-center gap-2">
                  <span class="flex h-6 w-6 items-center justify-center rounded-full bg-navy text-white text-xs font-bold">3</span>
                  <span>Contact &amp; Portal Password</span>
                </h2>
                <p class="text-xs text-muted mt-0.5 pl-8">Used to notify you upon room assignment and access the portal</p>
              </div>

              <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 pt-2">
                <div>
                  <label for="phone" class="block text-xs font-bold uppercase tracking-wider text-navy mb-1.5">
                    Mobile Phone <span class="text-red-500">*</span>
                  </label>
                  <input
                    type="tel"
                    name="phone"
                    id="phone"
                    required
                    autocomplete="tel"
                    placeholder="05 / 06 / 07..."
                    class="w-full min-h-[44px] rounded-xl border border-line bg-canvas/40 px-3.5 py-2.5 text-sm text-ink placeholder:text-muted/60 focus:border-navy focus:bg-surface focus:ring-2 focus:ring-navy/15 focus:outline-none transition tnum"
                  />
                </div>

                <div>
                  <label for="email" class="block text-xs font-bold uppercase tracking-wider text-navy mb-1.5">
                    Email Address (Optional)
                  </label>
                  <input
                    type="email"
                    name="email"
                    id="email"
                    autocomplete="email"
                    placeholder="student@univ-tlemcen.dz"
                    class="w-full min-h-[44px] rounded-xl border border-line bg-canvas/40 px-3.5 py-2.5 text-sm text-ink placeholder:text-muted/60 focus:border-navy focus:bg-surface focus:ring-2 focus:ring-navy/15 focus:outline-none transition"
                  />
                </div>

                <div class="sm:col-span-2">
                  <label for="password" class="block text-xs font-bold uppercase tracking-wider text-navy mb-1.5">
                    Portal Password <span class="text-red-500">*</span>
                  </label>
                  <input
                    type="password"
                    name="password"
                    id="password"
                    required
                    autocomplete="new-password"
                    minlength="8"
                    placeholder="Minimum 8 characters"
                    class="w-full min-h-[44px] rounded-xl border border-line bg-canvas/40 px-3.5 py-2.5 text-sm text-ink placeholder:text-muted/60 focus:border-navy focus:bg-surface focus:ring-2 focus:ring-navy/15 focus:outline-none transition"
                  />
                  <span class="mt-1.5 block text-[11px] text-muted">Must be at least 8 characters long. Keep this password safe.</span>
                </div>
              </div>
            </div>

            <!-- Submit Controls -->
            <div class="border-t border-line/60 pt-6 flex flex-col sm:flex-row items-center justify-between gap-4">
              <a href="/login" class="text-xs font-semibold text-muted hover:text-amber-ink transition">
                Already registered? Sign in here →
              </a>
              <button
                type="submit"
                class="w-full sm:w-auto min-h-[48px] inline-flex items-center justify-center gap-2 rounded-xl bg-navy px-8 py-3 text-sm font-semibold text-white shadow-sm hover:bg-navy-2 active:scale-[0.99] focus:outline-none focus:ring-2 focus:ring-navy focus:ring-offset-2 transition cursor-pointer"
              >
                <Icon name="check-circle" size={18} />
                <span>Submit Registration Dossier</span>
              </button>
            </div>
          </form>
        </div>
      </div>

      <!-- Right Column: Navy Hero Panel (Sticky on Desktop) -->
      <div class="lg:col-span-4 rounded-2xl bg-navy text-white p-6 sm:p-8 shadow-md flex flex-col justify-between relative overflow-hidden lg:sticky lg:top-8">
        <div class="absolute -right-16 -top-16 h-64 w-64 rounded-full bg-navy-2/60 blur-3xl pointer-events-none"></div>
        <div class="absolute -left-16 -bottom-16 h-64 w-64 rounded-full bg-amber/10 blur-3xl pointer-events-none"></div>

        <div class="relative z-10 space-y-6">
          <div class="flex items-center gap-3">
            <img src="/resivo-logo.svg" alt="RÉSIVO" class="h-11 w-11 object-contain" width="44" height="44" />
            <div>
              <span class="block font-display text-lg font-extrabold leading-tight tracking-tight text-white">RÉSIVO</span>
              <span class="block text-xs text-white/70 font-medium">Cité Universitaire • DOU Tlemcen</span>
            </div>
          </div>

          <div class="space-y-2 pt-1">
            <h2 class="font-display text-lg font-bold tracking-tight text-white leading-snug">
              Official University Housing Dossier
            </h2>
            <p class="text-xs text-white/75 leading-relaxed">
              Your official registration application for accommodation at Cité Universitaire Tlemcen.
            </p>
          </div>

          <!-- Feature Highlights -->
          <div class="space-y-3 pt-2">
            <div class="flex items-start gap-3 rounded-xl bg-white/5 p-3 border border-white/10">
              <div class="rounded-lg bg-amber/20 text-amber p-1.5 shrink-0">
                <Icon name="shield" size={16} />
              </div>
              <div>
                <span class="block text-xs font-semibold text-white">Roster Cross-Verification</span>
                <span class="block text-[11px] text-white/70 mt-0.5">Automated validation against official university enrollment lists.</span>
              </div>
            </div>

            <div class="flex items-start gap-3 rounded-xl bg-white/5 p-3 border border-white/10">
              <div class="rounded-lg bg-emerald-500/20 text-emerald-300 p-1.5 shrink-0">
                <Icon name="wrench" size={16} />
              </div>
              <div>
                <span class="block text-xs font-semibold text-white">Maintenance Triage with Photos</span>
                <span class="block text-[11px] text-white/70 mt-0.5">Submit repair reports with photo attachments once assigned.</span>
              </div>
            </div>

            <div class="flex items-start gap-3 rounded-xl bg-white/5 p-3 border border-white/10">
              <div class="rounded-lg bg-blue-500/20 text-blue-300 p-1.5 shrink-0">
                <Icon name="swap" size={16} />
              </div>
              <div>
                <span class="block text-xs font-semibold text-white">Room Relocation Portal</span>
                <span class="block text-[11px] text-white/70 mt-0.5">Request room swaps and floor preference adjustments online.</span>
              </div>
            </div>

            <div class="flex items-start gap-3 rounded-xl bg-white/5 p-3 border border-white/10">
              <div class="rounded-lg bg-indigo-500/20 text-indigo-300 p-1.5 shrink-0">
                <Icon name="building" size={16} />
              </div>
              <div>
                <span class="block text-xs font-semibold text-white">Cité Universitaire • Tlemcen</span>
                <span class="block text-[11px] text-white/70 mt-0.5">Direction des Œuvres Universitaires (DOU).</span>
              </div>
            </div>
          </div>
        </div>

        <div class="relative z-10 pt-6 mt-6 border-t border-white/10 flex items-center justify-between text-[11px] text-white/60">
          <span>Direction des Œuvres Universitaires</span>
          <span class="font-medium text-white/80">Tlemcen, Algérie</span>
        </div>
      </div>
    </div>
  </div>
</Layout>
