---
/**
 * RÉSIVO — add contact email for existing students without an email.
 * Saves directly via update_my_contact without codes or verification.
 */
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import BrandMark from '../../components/BrandMark.astro';
import InlineBanner from '../../components/InlineBanner.astro';
import PageHeader from '../../components/PageHeader.astro';
import { localizePath, t, type SupportedLocale } from '../../lib/i18n';

export const prerender = false;
const locale: SupportedLocale = Astro.locals.locale || 'en';

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect(localizePath(locale, '/login'));
}

const error = Astro.url.searchParams.get('error');
---

<Layout title={locale === 'fr' ? 'Ajouter un E-mail de Contact — RÉSIVO' : 'Add Contact Email — RÉSIVO'}>
  <div class="mx-auto flex w-full max-w-md flex-col gap-6 py-6 sm:py-8">
    <div class="card p-6 sm:p-8">
      <div class="mb-6 flex justify-center">
        <BrandMark variant="mark" size={48} />
      </div>

      <PageHeader
        title={t(locale, 'auth.add_email_title')}
        overline={t(locale, 'auth.add_email_overline')}
        subtitle={t(locale, 'auth.add_email_subtitle')}
      />

      <InlineBanner kind="warning" title={t(locale, 'auth.add_email_required_title')} class="mb-4">
        {t(locale, 'auth.add_email_required_desc')}
      </InlineBanner>

      {
        error && (
          <InlineBanner kind="error" title={t(locale, 'common.error')} class="mb-4">
            {error}
          </InlineBanner>
        )
      }

      <form method="POST" action="/api/account/add-email" id="add-email-form" data-locale={locale} class="flex flex-col gap-4">
        <div class="flex flex-col gap-2">
          <label class="label" for="email">
            {t(locale, 'fields.contact_email')} <span class="text-danger" aria-hidden="true">*</span>
          </label>
          <input
            class="input"
            type="email"
            name="email"
            id="email"
            required
            autocomplete="email"
            inputmode="email"
            maxlength="254"
            placeholder="student@univ-tlemcen.dz"
          />
          <p class="field-hint">{t(locale, 'auth.email_hint')}</p>
        </div>

        <div class="flex flex-col gap-2">
          <label class="label" for="confirm_email">
            {t(locale, 'fields.confirm_email')} <span class="text-danger" aria-hidden="true">*</span>
          </label>
          <input
            class="input"
            type="email"
            name="confirm_email"
            id="confirm_email"
            required
            autocomplete="email"
            inputmode="email"
            maxlength="254"
            placeholder="student@univ-tlemcen.dz"
          />
        </div>

        <p id="email-match-error" class="field-error hidden" role="alert"></p>

        <button class="btn btn-primary w-full mt-2" type="submit">
          <Icon name="check-circle" size={18} />
          <span>{t(locale, 'auth.add_email_btn')}</span>
        </button>
      </form>

      <div class="mt-6 flex flex-col gap-2 border-t border-line pt-6 text-center">
        <p class="text-small font-normal text-muted">
          <a class="link font-semibold" href="/logout">{t(locale, 'nav.sign_out')}</a>
        </p>
      </div>
    </div>

    <p class="text-center text-small font-normal text-muted">
      Direction des Œuvres Universitaires · Cité Universitaire Tlemcen
    </p>
  </div>

  <script>
    import { attachEmailConfirmValidation } from '../../lib/email-form-client';
    import type { SupportedLocale } from '../../lib/i18n';

    const form = document.getElementById('add-email-form') as HTMLFormElement | null;
    const emailInput = document.getElementById('email') as HTMLInputElement | null;
    const confirmInput = document.getElementById('confirm_email') as HTMLInputElement | null;
    const errorEl = document.getElementById('email-match-error');
    const locale = ((form?.getAttribute('data-locale') || 'en') as SupportedLocale);

    if (form && emailInput && confirmInput) {
      attachEmailConfirmValidation({ form, emailInput, confirmInput, errorEl, locale });
    }
  </script>
</Layout>
