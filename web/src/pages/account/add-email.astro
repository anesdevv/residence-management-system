---
/**
 * RÉSIVO — link verified real email (Phase 4).
 * Gating flow for existing accounts with synthetic emails (@students.residence.local).
 */
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import BrandMark from '../../components/BrandMark.astro';
import InlineBanner from '../../components/InlineBanner.astro';
import PageHeader from '../../components/PageHeader.astro';
import OtpInput from '../../components/OtpInput.astro';
import ResendButton from '../../components/ResendButton.astro';
import { maskEmail } from '../../lib/validation';

export const prerender = false;

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/login');
}

const currentEmail = user.email ?? '';
const hasFakeEmail = currentEmail.endsWith('@students.residence.local');

const error = Astro.url.searchParams.get('error');
const codeSent = Astro.url.searchParams.get('code_sent');
const pendingEmail = Astro.url.searchParams.get('email') || Astro.cookies.get('resivo_pending_email')?.value || '';
const maskedPending = pendingEmail ? maskEmail(pendingEmail) : '';
---

<Layout title="Link Verified Email — RÉSIVO" activeNav="">
  <div class="mx-auto flex w-full max-w-md flex-col gap-6 py-6 sm:py-8">
    <div class="card p-6 sm:p-8">
      <div class="mb-6 flex justify-center">
        <BrandMark variant="mark" size={48} />
      </div>

      <PageHeader
        title="Link verified email"
        overline="Account security update"
        subtitle="To safeguard your dormitory account and receive housing notifications, please register a real verified email address."
      />

      {
        hasFakeEmail && !codeSent && (
          <InlineBanner kind="warning" title="Action required" class="mb-4">
            Your resident file currently uses a temporary matriculation address. Linking a verified email is required to access your dashboard, receive room assignments, and recover your password.
          </InlineBanner>
        )
      }

      {
        error && (
          <InlineBanner kind="error" title="Email verification failed" class="mb-4">
            {error}
          </InlineBanner>
        )
      }

      {
        codeSent ? (
          <div>
            <InlineBanner kind="info" title="Verification code sent" class="mb-6">
              A 6-digit confirmation code has been dispatched to your new email address.
            </InlineBanner>

            {maskedPending && (
              <div class="mb-6 rounded-card border border-line bg-subtle p-3 text-center">
                <span class="text-xs font-medium text-muted uppercase tracking-wider block">Target address</span>
                <span class="font-mono text-small font-bold text-navy-900">{maskedPending}</span>
              </div>
            )}

            <form method="POST" action="/api/auth/verify-code" class="flex flex-col gap-6">
              <input type="hidden" name="email" value={pendingEmail} />
              <input type="hidden" name="type" value="email_change" />

              <div class="flex flex-col gap-2">
                <label class="label text-center" for="token">
                  6-digit verification code <span class="text-danger" aria-hidden="true">*</span>
                </label>
                <OtpInput length={6} name="token" id="token" required />
                <p class="field-hint text-center">
                  Enter the code from the verification email. Check your spam folder if necessary.
                </p>
              </div>

              <button class="btn btn-primary w-full" type="submit">
                <Icon name="check-circle" size={18} />
                <span>Confirm email &amp; enter portal</span>
              </button>
            </form>

            <div class="mt-6 border-t border-line pt-6">
              <ResendButton
                endpoint="/api/auth/resend-code"
                identifierKey="email"
                identifierValue={pendingEmail}
                flow="email_change"
              />
            </div>

            <div class="mt-6 border-t border-line pt-4 text-center">
              <a class="link text-small" href="/account/add-email">
                ← Change target email address
              </a>
            </div>
          </div>
        ) : (
          <form method="POST" action="/api/account/add-email" class="flex flex-col gap-4">
            <div class="flex flex-col gap-2">
              <label class="label" for="email">
                Personal or university email <span class="text-danger" aria-hidden="true">*</span>
              </label>
              <input
                class="input"
                type="email"
                name="email"
                id="email"
                required
                autocomplete="email"
                placeholder="e.g. resident@univ-tlemcen.dz"
              />
              <p class="field-hint">A 6-digit verification code will be sent to confirm this address.</p>
            </div>

            <div class="flex flex-col gap-2">
              <label class="label" for="confirm_email">
                Confirm email address <span class="text-danger" aria-hidden="true">*</span>
              </label>
              <input
                class="input"
                type="email"
                name="confirm_email"
                id="confirm_email"
                required
                autocomplete="email"
                placeholder="e.g. resident@univ-tlemcen.dz"
              />
            </div>

            <button class="btn btn-primary w-full mt-2" type="submit">
              <Icon name="mail" size={18} />
              <span>Send verification code</span>
            </button>
          </form>
        )
      }

      <div class="mt-6 flex flex-col gap-2 border-t border-line pt-6 text-center">
        <form method="POST" action="/api/logout">
          <button type="submit" class="link text-small text-muted hover:text-danger">
            Sign out of this account
          </button>
        </form>
      </div>
    </div>

    <p class="text-center text-small font-normal text-muted">
      Direction des Œuvres Universitaires · Cité Universitaire Tlemcen
    </p>
  </div>

  <script is:inline>
    (function () {
      var email = document.getElementById('email');
      var confirm = document.getElementById('confirm_email');
      if (!email || !confirm) return;

      function check() {
        if (confirm.value && email.value.toLowerCase() !== confirm.value.toLowerCase()) {
          confirm.setCustomValidity('Email addresses do not match.');
        } else {
          confirm.setCustomValidity('');
        }
      }

      email.addEventListener('input', check);
      confirm.addEventListener('input', check);
    })();
  </script>
</Layout>
