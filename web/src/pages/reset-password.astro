---
/**
 * RÉSIVO — reset password (Phase 4).
 * Accessible after verifying a recovery OTP code or clicking a recovery link.
 */
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import BrandMark from '../components/BrandMark.astro';
import InlineBanner from '../components/InlineBanner.astro';
import PageHeader from '../components/PageHeader.astro';
import { localizePath, t, type SupportedLocale } from '../lib/i18n';

export const prerender = false;
const locale: SupportedLocale = Astro.locals.locale || 'en';
const error = Astro.url.searchParams.get('error');
---

<Layout title={locale === 'fr' ? 'Réinitialisation du Mot de Passe — RÉSIVO' : 'Reset Password — RÉSIVO'} activeNav="login">
  <div class="mx-auto flex w-full max-w-md flex-col gap-6 py-6 sm:py-8">
    <div class="card p-6 sm:p-8">
      <div class="mb-6 flex justify-center">
        <BrandMark variant="mark" size={48} />
      </div>

      <PageHeader
        title={t(locale, 'auth.reset_title')}
        overline={t(locale, 'auth.reset_overline')}
        subtitle={t(locale, 'auth.reset_subtitle')}
      />

      {
        error && (
          <InlineBanner kind="error" title={t(locale, 'common.error')} class="mb-4">
            {error}
          </InlineBanner>
        )
      }

      <form method="POST" action="/api/auth/reset-password" class="flex flex-col gap-4">
        <div class="flex flex-col gap-2">
          <label class="label" for="password">
            {t(locale, 'fields.new_password')} <span class="text-danger" aria-hidden="true">*</span>
          </label>
          <input
            class="input"
            type="password"
            name="password"
            id="password"
            required
            autocomplete="new-password"
            minlength="8"
            placeholder={locale === 'fr' ? 'Au moins 8 caractères' : 'Minimum 8 characters'}
          />
          <p class="field-hint">
            {locale === 'fr' ? 'Doit comporter au moins 8 caractères.' : 'Must contain at least 8 characters.'}
          </p>
        </div>

        <div class="flex flex-col gap-2" role="group" aria-labelledby="pw-meter-caption">
          <div class="flex items-center justify-between gap-3">
            <span class="field-hint" id="pw-meter-caption">
              {locale === 'fr' ? 'Robustesse du mot de passe' : 'Password strength'}
            </span>
            <span class="text-small font-semibold text-ink-2" id="pw-meter-label" aria-live="polite">
              {locale === 'fr' ? 'Non défini' : 'Not set'}
            </span>
          </div>
          <div class="flex gap-1" aria-hidden="true">
            <span class="h-1 flex-1 rounded-pill bg-subtle" data-pw-segment></span>
            <span class="h-1 flex-1 rounded-pill bg-subtle" data-pw-segment></span>
            <span class="h-1 flex-1 rounded-pill bg-subtle" data-pw-segment></span>
            <span class="h-1 flex-1 rounded-pill bg-subtle" data-pw-segment></span>
          </div>
        </div>

        <div class="flex flex-col gap-2">
          <label class="label" for="confirm_password">
            {t(locale, 'fields.confirm_password')} <span class="text-danger" aria-hidden="true">*</span>
          </label>
          <input
            class="input"
            type="password"
            name="confirm_password"
            id="confirm_password"
            required
            autocomplete="new-password"
            minlength="8"
            placeholder={locale === 'fr' ? 'Répétez le mot de passe' : 'Repeat new password'}
          />
        </div>

        <button class="btn btn-primary w-full mt-2" type="submit">
          <Icon name="check-circle" size={18} />
          <span>{t(locale, 'auth.reset_btn')}</span>
        </button>
      </form>

      <div class="mt-6 flex flex-col gap-2 border-t border-line pt-6 text-center">
        <p class="text-small font-normal text-muted">
          {locale === 'fr' ? 'Vous avez retrouvé votre mot de passe\u00A0?' : 'Remembered your existing password?'}{' '}
          <a class="link font-semibold" href={localizePath(locale, '/login')}>{t(locale, 'auth.sign_in')}</a>
        </p>
      </div>
    </div>

    <p class="text-center text-small font-normal text-muted">
      Direction des Œuvres Universitaires · Cité Universitaire Tlemcen
    </p>
  </div>

  <script is:inline>
    (function () {
      var pwInput = document.getElementById('password');
      var confirmInput = document.getElementById('confirm_password');
      var label = document.getElementById('pw-meter-label');
      var segments = document.querySelectorAll('[data-pw-segment]');

      var LEVELS = [
        { text: 'Weak', token: '--status-danger' },
        { text: 'Fair', token: '--status-pending' },
        { text: 'Good', token: '--status-progress' },
        { text: 'Strong', token: '--status-ok' },
      ];
      var rootStyle = getComputedStyle(document.documentElement);
      var TONES = LEVELS.map(function (level) {
        return { text: level.text, color: rootStyle.getPropertyValue(level.token).trim() };
      });

      function score(val) {
        var points = 0;
        if (val.length >= 8) points += 1;
        if (/[a-z]/.test(val) && /[A-Z]/.test(val)) points += 1;
        if (/\d/.test(val)) points += 1;
        if (/[^A-Za-z0-9]/.test(val) || val.length >= 12) points += 1;
        return points;
      }

      function render() {
        if (!pwInput || !label) return;
        var points = pwInput.value ? score(pwInput.value) : 0;
        var level = points > 0 ? TONES[points - 1] : null;

        for (var i = 0; i < segments.length; i += 1) {
          segments[i].style.backgroundColor = level && i < points ? level.color : '';
        }
        label.textContent = level ? level.text : 'Not set';
        label.style.color = level ? level.color : '';
      }

      function validateConfirm() {
        if (!pwInput || !confirmInput) return;
        if (confirmInput.value && pwInput.value !== confirmInput.value) {
          confirmInput.setCustomValidity('Passwords do not match.');
        } else {
          confirmInput.setCustomValidity('');
        }
      }

      if (pwInput) pwInput.addEventListener('input', function () {
        render();
        validateConfirm();
      });
      if (confirmInput) confirmInput.addEventListener('input', validateConfirm);
      render();
    })();
  </script>
</Layout>
