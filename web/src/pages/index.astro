---
/**
 * RÉSIVO — landing (docs/DESIGN.md §8, plan Phase 4).
 * Brand-gradient hero (the only gradient surface here besides the primary CTA),
 * the real 4-step intake lifecycle and the services the portal actually offers.
 * Visual layer only: no data, no invented figures, no imagery.
 * Elevated craft with calm institutional breathing room and strict tabular figures.
 */
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import BrandMark from '../components/BrandMark.astro';
import { localizePath, t, type SupportedLocale } from '../lib/i18n';

const locale: SupportedLocale = Astro.locals.locale || 'en';

/* The real lifecycle: Register › Verification › Room assigned › Living in residence. */
const steps = [
  {
    label: t(locale, 'landing.step_1_title'),
    icon: 'id-card',
    copy: t(locale, 'landing.step_1_desc'),
  },
  {
    label: t(locale, 'landing.step_2_title'),
    icon: 'user-check',
    copy: t(locale, 'landing.step_2_desc'),
  },
  {
    label: t(locale, 'landing.step_3_title'),
    icon: 'bed',
    copy: t(locale, 'landing.step_3_desc'),
  },
  {
    label: t(locale, 'landing.step_4_title'),
    icon: 'home',
    copy: t(locale, 'landing.step_4_desc'),
  },
];

/* What a resident actually does in the portal — application status, room, tickets, transfers. */
const services = [
  {
    title: t(locale, 'landing.service_status_title'),
    icon: 'clock',
    copy: t(locale, 'landing.service_status_desc'),
  },
  {
    title: t(locale, 'landing.service_room_title'),
    icon: 'bed',
    copy: t(locale, 'landing.service_room_desc'),
  },
  {
    title: t(locale, 'landing.service_maintenance_title'),
    icon: 'wrench',
    copy: t(locale, 'landing.service_maintenance_desc'),
  },
  {
    title: t(locale, 'landing.service_transfers_title'),
    icon: 'arrow-left-right',
    copy: t(locale, 'landing.service_transfers_desc'),
  },
];
---

<Layout
  title={locale === 'fr' ? 'RÉSIVO : Portail Officiel d’Hébergement Étudiant' : 'RÉSIVO: Official Student Housing Portal'}
  activeNav="home"
>
  <!-- Hero: institutional navy surface with structured asymmetric split -->
  <section
    class="relative overflow-hidden rounded-hero border border-navy-700 bg-navy-900 px-5 py-8 sm:px-10 sm:py-14 lg:py-16 shadow-e1"
    style="background-image: var(--grad-brand);"
  >
    <!-- Deep legibility plate ensuring AA contrast on dark gradient -->
    <span class="absolute inset-0 bg-navy-900/85" aria-hidden="true"></span>

    <!-- Micro-texture coordinate grid -->
    <svg
      class="pointer-events-none absolute inset-0 h-full w-full opacity-[0.04] text-surface"
      xmlns="http://www.w3.org/2000/svg"
      width="100%"
      height="100%"
      aria-hidden="true"
    >
      <defs>
        <pattern id="hero-grid" width="40" height="40" patternUnits="userSpaceOnUse">
          <path d="M0 40h40M40 0v40" stroke="currentColor" stroke-width="0.5" stroke-dasharray="1 7" />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#hero-grid)" />
    </svg>

    <!-- Top hairline highlight -->
    <div class="absolute inset-x-0 top-0 h-px bg-white/15" aria-hidden="true"></div>

    <div class="relative grid gap-8 lg:grid-cols-12 lg:items-center">
      <!-- Left Column: Hero Narrative & Primary Direct Actions -->
      <div class="flex flex-col gap-6 lg:col-span-7">
        <div class="flex flex-col gap-4">
          <BrandMark variant="mark" tone="white" size={28} class="shrink-0" />

          <h1 class="measure font-display text-h1 text-surface sm:text-display tracking-tight leading-tight">
            {t(locale, 'landing.hero_title')}
          </h1>
          <p class="measure text-body text-on-dark leading-relaxed">
            {t(locale, 'landing.hero_desc')}
          </p>
        </div>

        <div class="flex flex-col gap-3 sm:flex-row sm:items-center pt-1">
          <a class="btn btn-gradient whitespace-nowrap" href={localizePath(locale, '/register')}>
            <Icon name="user" size={18} />
            <span>{t(locale, 'landing.hero_register_cta')}</span>
          </a>
          <a
            class="btn border border-on-dark-2/40 bg-transparent text-surface hover:bg-navy-800 hover:border-on-dark transition-colors whitespace-nowrap"
            href={localizePath(locale, '/login')}
          >
            <Icon name="log-in" size={18} />
            <span>{t(locale, 'landing.hero_signin_cta')}</span>
          </a>
        </div>

        <p class="text-small font-medium text-on-dark-2">
          {t(locale, 'landing.hero_overline')}, DOU Tlemcen
        </p>
      </div>

      <!-- Right Column: 2026/2027 Official Intake Panel -->
      <div class="lg:col-span-5">
        <div class="relative overflow-hidden rounded-card border border-navy-700 bg-navy-800 p-5 sm:p-6 text-on-dark shadow-e1">
          <!-- Academic Session Header -->
          <div class="flex items-center justify-between gap-2 border-b border-navy-700 pb-3">
            <span class="text-small font-semibold text-on-dark">
              {locale === 'fr' ? 'Session Universitaire 2026/2027' : 'Academic Session 2026/2027'}
            </span>
            <span class="rounded-pill border border-teal-500/40 bg-navy-900 px-2.5 py-0.5 text-small font-semibold text-teal-500">
              {locale === 'fr' ? 'Ouvert' : 'Active'}
            </span>
          </div>

          <!-- Key Intake Facts (Hairline-divided rows, no nested cards) -->
          <ul class="mt-2 flex flex-col divide-y divide-navy-700">
            <li class="flex items-start gap-3 py-3 first:pt-2 last:pb-0">
              <Icon name="id-card" size={18} class="mt-0.5 shrink-0 text-teal-500" />
              <div class="min-w-0">
                <p class="text-small font-semibold text-surface">{locale === 'fr' ? 'Admissibilité & Contrôle' : 'Eligibility & Verification'}</p>
                <p class="text-small text-on-dark-2 mt-0.5 leading-normal">
                  {locale === 'fr' ? 'Validation automatique avec le fichier central de l’Université de Tlemcen.' : 'Synchronized with official University of Tlemcen registration records.'}
                </p>
              </div>
            </li>

            <li class="flex items-start gap-3 py-3 first:pt-2 last:pb-0">
              <Icon name="bed" size={18} class="mt-0.5 shrink-0 text-gold-300" />
              <div class="min-w-0">
                <p class="text-small font-semibold text-surface">{locale === 'fr' ? 'Attribution des Pavillons' : 'Quarter Allocation'}</p>
                <p class="text-small text-on-dark-2 mt-0.5 leading-normal">
                  {locale === 'fr' ? 'Pavillons A, B et C attribués dès confirmation du dossier administratif.' : 'Blocks A, B, and C assigned immediately upon admission clearance.'}
                </p>
              </div>
            </li>

            <li class="flex items-start gap-3 py-3 first:pt-2 last:pb-0">
              <Icon name="shield-check" size={18} class="mt-0.5 shrink-0 text-teal-500" />
              <div class="min-w-0">
                <p class="text-small font-semibold text-surface">{locale === 'fr' ? 'Badge Résident Numérique' : 'Digital Resident Pass'}</p>
                <p class="text-small text-on-dark-2 mt-0.5 leading-normal">
                  {locale === 'fr' ? 'Pass officiel avec QR sécurisé délivré pour l’accès au campus.' : 'Official credential generated for residence desk access and room keys.'}
                </p>
              </div>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- How it works: the four stages of the intake lifecycle -->
  <section class="mt-14 sm:mt-16">
    <div class="flex flex-col gap-1.5">
      <h2 class="font-display text-h1 sm:text-display text-ink tracking-tight">{t(locale, 'landing.steps_title')}</h2>
      <p class="measure text-small font-normal text-muted leading-relaxed">
        {t(locale, 'landing.steps_desc')}
      </p>
    </div>

    <ol class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        steps.map((step, index) => (
          <li class="card group flex flex-col justify-between gap-4 p-5 sm:p-6 transition-[border-color,box-shadow] duration-200 hover:border-teal-600 h-full">
            <div class="flex flex-col gap-3">
              <div class="flex items-center justify-between">
                <span class="flex h-10 w-10 items-center justify-center rounded-input border border-line bg-subtle text-teal-600">
                  <Icon name={step.icon} size={18} />
                </span>
                <span class="tnum text-small font-semibold text-teal-600 border border-teal-600/20 bg-teal-600/10 px-2 py-0.5 rounded-input">
                  0{index + 1}
                </span>
              </div>
              <h3 class="text-h3 font-semibold text-ink mt-1">{step.label}</h3>
            </div>
            <p class="text-small font-normal text-muted leading-relaxed">{step.copy}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- What you can do: the services that exist in the portal today -->
  <section class="mt-14 sm:mt-16">
    <div class="flex flex-col gap-1.5">
      <h2 class="font-display text-h1 sm:text-display text-ink tracking-tight">{t(locale, 'landing.services_title')}</h2>
      <p class="measure text-small font-normal text-muted leading-relaxed">
        {t(locale, 'landing.services_desc')}
      </p>
    </div>

    <div class="mt-6 grid gap-5 sm:grid-cols-2">
      {
        services.map((service) => (
          <article class="card group flex flex-col gap-4 p-5 sm:p-6 transition-[border-color,box-shadow] duration-200 hover:border-teal-600">
            <span class="flex h-11 w-11 items-center justify-center rounded-input border border-line bg-subtle text-teal-600">
              <Icon name={service.icon} size={20} />
            </span>
            <div>
              <h3 class="text-h3 font-semibold text-ink">{service.title}</h3>
              <p class="measure mt-1.5 text-small font-normal text-muted leading-relaxed">{service.copy}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Trust band: intake policy and the institution that runs it -->
  <section class="relative overflow-hidden mt-14 sm:mt-16 rounded-hero border border-navy-700 bg-navy-900 p-6 sm:p-10 text-on-dark shadow-e1">
    <!-- Inset hairline border -->
    <div class="pointer-events-none absolute inset-2 rounded-card border border-white/5" aria-hidden="true"></div>

    <div class="relative flex flex-col gap-5">
      <span class="flex h-12 w-12 items-center justify-center rounded-card border border-navy-700 bg-navy-800 text-gold-300">
        <Icon name="shield-check" size={24} />
      </span>

      <div class="flex flex-col gap-2">
        <h2 class="font-display text-h1 sm:text-h2 text-surface font-semibold tracking-tight">
          {locale === 'fr' ? 'Règlement d’admission & justificatifs d’identité' : 'Intake policy & identification requirement'}
        </h2>
        <p class="measure text-body font-normal text-on-dark leading-relaxed">
          {locale === 'fr'
            ? 'L’hébergement est strictement réservé aux étudiants régulièrement inscrits figurant sur la liste officielle de l’université pour l’année académique en cours. Les dossiers non confirmés demeurent en attente jusqu’à validation par la Direction des Œuvres Universitaires (DOU) de Tlemcen.'
            : 'Accommodation is strictly reserved for actively matriculated university students appearing on the official university admission roster for the current academic year. Unmatched registrations remain pending until physical verification by the administration of Direction des Œuvres Universitaires (DOU) Tlemcen.'}
        </p>
      </div>

      <div class="mt-2 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between border-t border-navy-700 pt-5 text-small text-on-dark-2">
        <p class="flex items-center gap-2">
          <Icon name="map-pin" size={16} class="text-gold-300 shrink-0" />
          <span>Direction des Œuvres Universitaires, Cité Universitaire, Tlemcen</span>
        </p>
        <p class="tnum flex items-center gap-2 text-small text-on-dark font-medium">
          <Icon name="phone" size={14} class="text-teal-500 shrink-0" />
          <span dir="ltr">{t(locale, 'landing.hotline')}</span>
        </p>
      </div>
    </div>
  </section>
  <style>
    h1,
    h2 {
      overflow-wrap: break-word;
      min-width: 0;
      text-wrap: balance;
    }
  </style>
</Layout>
