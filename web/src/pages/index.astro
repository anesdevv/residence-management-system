---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
---

<Layout title="Residence Tlemcen — Official Student Housing Portal" activeNav="home">
  <!-- Hero Section -->
  <section class="py-6 sm:py-10">
    <div class="rounded-2xl border border-slate-200/90 bg-white p-6 sm:p-10 shadow-xs">
      <div class="max-w-2xl space-y-4">
        <div class="inline-flex items-center gap-2 rounded-full border border-blue-200 bg-blue-50/80 px-3 py-1 text-xs font-semibold text-blue-800">
          <Icon name="crest" size={14} class="text-blue-700" />
          <span>Official University Housing Portal • DOU Tlemcen</span>
        </div>

        <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900 leading-tight">
          University Residence — Tlemcen
        </h1>

        <p class="text-base sm:text-lg text-slate-600 leading-relaxed">
          Welcome to Cité Universitaire Tlemcen. Register your official student card ID, monitor application approval in real-time, view assigned room details, and submit campus living requests.
        </p>

        <div class="pt-2 flex flex-wrap items-center gap-3">
          <a
            href="/register"
            class="inline-flex items-center gap-2 rounded-lg bg-slate-900 px-5 py-3 text-sm font-semibold text-white shadow-xs hover:bg-blue-600 transition"
          >
            <Icon name="user" size={18} />
            <span>Register as a resident</span>
            <Icon name="arrow-right" size={16} />
          </a>
          <a
            href="/login"
            class="inline-flex items-center gap-2 rounded-lg border border-slate-300 bg-white px-5 py-3 text-sm font-semibold text-slate-700 hover:bg-slate-50 transition"
          >
            <Icon name="login" size={18} />
            <span>Sign in to dashboard</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Key Services Overview Grid -->
  <section class="mt-8 space-y-4">
    <div class="flex items-center justify-between">
      <h2 class="text-xl font-bold tracking-tight text-slate-900">Department Housing Services</h2>
      <span class="text-xs font-medium text-slate-500">Residence Administration & Living Services</span>
    </div>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
      <!-- Card 1 -->
      <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-xs transition hover:border-slate-300">
        <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-blue-50 text-blue-700">
          <Icon name="building" size={20} />
        </div>
        <h3 class="mt-4 font-semibold text-slate-900 text-base">Verified Room Allocation</h3>
        <p class="mt-2 text-xs text-slate-500 leading-relaxed">
          Allocations are cross-referenced with official university admission rosters. Residential blocks are designated with strict capacity limits.
        </p>
      </div>

      <!-- Card 2 -->
      <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-xs transition hover:border-slate-300">
        <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-emerald-50 text-emerald-700">
          <Icon name="wrench" size={20} />
        </div>
        <h3 class="mt-4 font-semibold text-slate-900 text-base">24/7 Facility Maintenance</h3>
        <p class="mt-2 text-xs text-slate-500 leading-relaxed">
          Report plumbing, electrical, furniture, or connectivity issues directly through your dashboard with fault photos. Track triage in real-time.
        </p>
      </div>

      <!-- Card 3 -->
      <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-xs transition hover:border-slate-300">
        <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-amber-50 text-amber-700">
          <Icon name="bed" size={20} />
        </div>
        <h3 class="mt-4 font-semibold text-slate-900 text-base">Room Transfer Requests</h3>
        <p class="mt-2 text-xs text-slate-500 leading-relaxed">
          Active residents may apply for room changes based on preferred blocks and medical or academic justifications, reviewed by housing officers.
        </p>
      </div>
    </div>
  </section>

  <!-- Intake Workflow Progression -->
  <section class="mt-10 rounded-xl border border-slate-200 bg-white p-6 shadow-xs">
    <h2 class="text-base font-bold text-slate-900 mb-4">Application & Move-In Workflow</h2>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
      <div class="flex items-start gap-3">
        <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-slate-900 text-xs font-bold text-white">
          1
        </div>
        <div>
          <h3 class="text-sm font-semibold text-slate-900">Student Registration</h3>
          <p class="mt-1 text-xs text-slate-500 leading-relaxed">
            Create an account using your valid Student Card ID, academic department, and personal contact info.
          </p>
        </div>
      </div>

      <div class="flex items-start gap-3">
        <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-slate-900 text-xs font-bold text-white">
          2
        </div>
        <div>
          <h3 class="text-sm font-semibold text-slate-900">Administrative Triage</h3>
          <p class="mt-1 text-xs text-slate-500 leading-relaxed">
            Housing staff cross-reference your record with university rosters and approve valid applications into rooms.
          </p>
        </div>
      </div>

      <div class="flex items-start gap-3">
        <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-slate-900 text-xs font-bold text-white">
          3
        </div>
        <div>
          <h3 class="text-sm font-semibold text-slate-900">Dormitory Check-In</h3>
          <p class="mt-1 text-xs text-slate-500 leading-relaxed">
            Access your assigned Block & Room number directly on your dashboard and present your ID at the reception desk.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Institutional Notice Card -->
  <section class="mt-8 rounded-xl border border-blue-200 bg-blue-50/60 p-5 text-slate-800">
    <div class="flex items-start gap-3.5">
      <div class="rounded-lg bg-blue-100 p-2 text-blue-700 shrink-0">
        <Icon name="shield" size={20} />
      </div>
      <div class="space-y-1">
        <h3 class="text-sm font-bold text-blue-950">Intake Policy & Identification Requirement</h3>
        <p class="text-xs text-blue-900/90 leading-relaxed">
          Accommodation is strictly reserved for actively enrolled students who appear on the official university matriculation list for the current academic year. Applications with unverified student card IDs will remain pending until official records are verified by the administration.
        </p>
      </div>
    </div>
  </section>
</Layout>
