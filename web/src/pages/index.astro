---
/**
 * RÉSIVO — landing (docs/DESIGN.md §8, plan Phase 4).
 * Brand-gradient hero (the only gradient surface here besides the primary CTA),
 * the real 4-step intake lifecycle and the services the portal actually offers.
 * Visual layer only: no data, no invented figures, no imagery.
 * Elevated craft with calm institutional breathing room and strict tabular figures.
 */
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import BrandMark from '../components/BrandMark.astro';
import { localizePath, t, type SupportedLocale } from '../lib/i18n';

const locale: SupportedLocale = Astro.locals.locale || 'en';

/* The real lifecycle: Register › Verification › Room assigned › Living in residence. */
const steps = [
  {
    label: t(locale, 'landing.step_1_title'),
    icon: 'id-card',
    copy: t(locale, 'landing.step_1_desc'),
  },
  {
    label: t(locale, 'landing.step_2_title'),
    icon: 'user-check',
    copy: t(locale, 'landing.step_2_desc'),
  },
  {
    label: t(locale, 'landing.step_3_title'),
    icon: 'bed',
    copy: t(locale, 'landing.step_3_desc'),
  },
  {
    label: t(locale, 'landing.step_4_title'),
    icon: 'home',
    copy: t(locale, 'landing.step_4_desc'),
  },
];

/* What a resident actually does in the portal — application status, room, tickets, transfers. */
const services = [
  {
    title: t(locale, 'landing.service_status_title'),
    icon: 'clock',
    copy: t(locale, 'landing.service_status_desc'),
  },
  {
    title: t(locale, 'landing.service_room_title'),
    icon: 'bed',
    copy: t(locale, 'landing.service_room_desc'),
  },
  {
    title: t(locale, 'landing.service_maintenance_title'),
    icon: 'wrench',
    copy: t(locale, 'landing.service_maintenance_desc'),
  },
  {
    title: t(locale, 'landing.service_transfers_title'),
    icon: 'arrow-left-right',
    copy: t(locale, 'landing.service_transfers_desc'),
  },
];
---

<Layout
  title={locale === 'fr' ? 'RÉSIVO — Portail Officiel d’Hébergement Étudiant' : 'RÉSIVO — Official Student Housing Portal'}
  activeNav="home"
>
  <!-- Hero — quiet institutional navy surface with structured asymmetric split -->
  <section
    class="relative overflow-hidden rounded-hero border border-navy-700/70 bg-navy-900 px-5 py-8 sm:px-10 sm:py-14 lg:py-16 shadow-e2"
    style="background-image: var(--grad-brand);"
  >
    <!-- Deep legibility plate ensuring rock-solid AA contrast on dark gradient -->
    <span class="absolute inset-0 bg-navy-900/85 backdrop-blur-[1px]" aria-hidden="true"></span>

    <!-- Micro-texture coordinate grid -->
    <svg
      class="pointer-events-none absolute inset-0 h-full w-full opacity-[0.04] text-surface"
      xmlns="http://www.w3.org/2000/svg"
      width="100%"
      height="100%"
      aria-hidden="true"
    >
      <defs>
        <pattern id="hero-grid" width="40" height="40" patternUnits="userSpaceOnUse">
          <path d="M0 40h40M40 0v40" stroke="currentColor" stroke-width="0.5" stroke-dasharray="1 7" />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#hero-grid)" />
    </svg>

    <!-- Top hairline highlight -->
    <div class="absolute inset-x-0 top-0 h-px bg-white/15" aria-hidden="true"></div>

    <div class="relative grid gap-10 lg:grid-cols-12 lg:items-center">
      <!-- Left Column: Hero Narrative & Primary Direct Actions -->
      <div class="flex flex-col gap-6 lg:col-span-7">
        <BrandMark variant="logo" tone="white" size={112} alt="RÉSIVO" />

        <div class="flex flex-col gap-3">
          <div class="flex flex-wrap items-center gap-2">
            <span class="inline-flex items-center gap-1.5 rounded-input border border-teal-500/30 bg-teal-500/15 px-2.5 py-1 text-xs font-semibold uppercase tracking-wider text-teal-300">
              <span class="h-1.5 w-1.5 rounded-full bg-teal-400" aria-hidden="true"></span>
              <span>{t(locale, 'landing.hero_overline')}</span>
            </span>
            <span class="text-xs font-mono text-on-dark-2">·</span>
            <span class="font-mono text-xs uppercase tracking-wider text-on-dark-2 font-medium">DOU TLEMCEN</span>
          </div>

          <h1 class="measure font-display text-h1 text-surface sm:text-display tracking-tight leading-tight">
            {t(locale, 'landing.hero_title')}
          </h1>
          <p class="measure text-body text-on-dark leading-relaxed">
            {t(locale, 'landing.hero_desc')}
          </p>
        </div>

        <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
          <a class="btn btn-gradient shadow-sm" href={localizePath(locale, '/register')}>
            <Icon name="user" size={18} />
            <span>{t(locale, 'landing.hero_register_cta')}</span>
          </a>
          <a
            class="btn border border-navy-600 bg-navy-800/90 text-on-dark hover:border-navy-500 hover:bg-navy-700 transition-colors"
            href={localizePath(locale, '/login')}
          >
            <Icon name="log-in" size={18} />
            <span>{t(locale, 'landing.hero_signin_cta')}</span>
          </a>
        </div>

        <div class="flex flex-wrap items-center gap-3 pt-1 text-small text-on-dark-2">
          <p class="flex items-center gap-2 rounded-input border border-navy-700/80 bg-navy-800/80 px-3 py-1.5 text-xs text-on-dark font-medium shadow-sm">
            <Icon name="map-pin" size={14} class="text-teal-400 shrink-0" />
            <span>Direction des Œuvres Universitaires · Cité Universitaire · Tlemcen</span>
          </p>
          <p class="tnum flex items-center gap-2 rounded-input border border-navy-700/80 bg-navy-800/80 px-3 py-1.5 text-xs text-on-dark-2 font-medium shadow-sm">
            <Icon name="clock" size={14} class="text-gold-300 shrink-0" />
            <span>{t(locale, 'landing.desk_hours')}</span>
          </p>
        </div>
      </div>

      <!-- Right Column: Institutional Verification & Live Session Card -->
      <div class="lg:col-span-5">
        <div class="relative overflow-hidden rounded-card border border-white/15 bg-navy-800/95 p-4 sm:p-6 text-on-dark shadow-e2 backdrop-blur-sm">
          <!-- Top accent line -->
          <div class="absolute inset-x-0 top-0 h-0.5 bg-gradient-to-r from-teal-500 via-teal-400 to-green-500" aria-hidden="true"></div>

          <!-- Academic Session Header -->
          <div class="flex flex-wrap items-center justify-between gap-2 border-b border-navy-700 pb-3.5">
            <span class="flex items-center gap-2 text-small font-medium text-teal-400">
              <span class="live-dot live-dot--connected"></span>
              <span class="tnum tracking-wide">{locale === 'fr' ? 'Session Universitaire 2026–2027' : 'Academic Session 2026–2027'}</span>
            </span>
            <span class="rounded-input border border-navy-600 bg-navy-900/90 px-2.5 py-0.5 font-mono text-[11px] font-semibold text-on-dark-2 uppercase">
              DOU TLEMCEN
            </span>
          </div>

          <!-- Dossier Verification Matrix -->
          <div class="mt-5 flex flex-col gap-4">
            <div class="flex flex-wrap items-start justify-between gap-2 sm:gap-3">
              <div>
                <p class="overline text-on-dark-2">{locale === 'fr' ? 'Dossier d’hébergement' : 'Housing application'}</p>
                <p class="font-display text-h3 text-surface font-semibold">{locale === 'fr' ? 'Vérification du dossier' : 'Intake verification'}</p>
              </div>
              <span class="inline-flex items-center gap-1.5 rounded-input border border-teal-500/30 bg-teal-500/15 px-2.5 py-1 text-xs font-semibold text-teal-300 shadow-sm">
                <Icon name="check" size={14} />
                <span>{locale === 'fr' ? 'Inscriptions ouvertes' : 'Intake active'}</span>
              </span>
            </div>

            <div class="rounded-input border border-navy-700/80 bg-navy-900/70 p-3.5 text-xs text-on-dark-2 shadow-inner">
              <div class="flex items-center justify-between py-2 border-b border-navy-700/60">
                <span class="font-medium">{locale === 'fr' ? 'Contrôle fichier' : 'Roster check'}</span>
                <span class="tnum font-mono text-surface font-semibold bg-navy-800 px-2 py-0.5 rounded-input border border-navy-700">MATRICULE DOU</span>
              </div>
              <div class="flex items-center justify-between py-2 border-b border-navy-700/60">
                <span class="font-medium">{locale === 'fr' ? 'Attribution chambre' : 'Room allocation'}</span>
                <span class="tnum font-mono text-surface font-semibold bg-navy-800 px-2 py-0.5 rounded-input border border-navy-700">PAVILLON A · B · C</span>
              </div>
              <div class="flex items-center justify-between pt-2">
                <span class="font-medium">{locale === 'fr' ? 'Badge résident' : 'Resident pass'}</span>
                <span class="inline-flex items-center gap-1 text-xs font-semibold text-teal-300">
                  <Icon name="shield-check" size={14} />
                  <span>{locale === 'fr' ? 'Badge officiel' : 'Official pass'}</span>
                </span>
              </div>
            </div>

            <!-- Micro-dispatch status note -->
            <div class="flex items-center justify-between border-t border-navy-700/80 pt-3 text-[11px] font-mono text-on-dark-2">
              <span>DISPATCH DESK</span>
              <span class="tnum text-gold-300 font-semibold" dir="ltr">{t(locale, 'landing.hotline')}</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- How it works — the four real stages of the intake lifecycle -->
  <section class="mt-14 sm:mt-16">
    <div class="flex flex-col gap-1.5">
      <p class="overline text-muted">{t(locale, 'landing.steps_overline')}</p>
      <h2 class="font-display text-h1 sm:text-display text-ink tracking-tight">{t(locale, 'landing.steps_title')}</h2>
      <p class="measure text-small font-normal text-muted leading-relaxed">
        {t(locale, 'landing.steps_desc')}
      </p>
    </div>

    <ol class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        steps.map((step, index) => (
          <li class="card group flex flex-col justify-between gap-4 p-5 sm:p-6 transition-all duration-200 hover:border-teal-600 hover:shadow-e2">
            <div class="flex flex-col gap-4">
              <div class="flex items-center justify-between">
                <span class="flex h-11 w-11 items-center justify-center rounded-input border border-border bg-subtle text-teal-600 shadow-sm transition-transform duration-200 group-hover:scale-105">
                  <Icon name={step.icon} size={20} />
                </span>
                <span class="tnum font-mono text-xs font-semibold text-teal-600 border border-teal-600/20 bg-teal-500/10 px-2 py-0.5 rounded-input">
                  0{index + 1}
                </span>
              </div>
              <div>
                <p class="overline text-muted">{locale === 'fr' ? `Étape 0${index + 1}` : `Step 0${index + 1}`}</p>
                <h3 class="text-h3 font-semibold text-ink transition-colors group-hover:text-teal-600">{step.label}</h3>
              </div>
            </div>
            <p class="text-small font-normal text-muted leading-relaxed">{step.copy}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- What you can do — the services that exist in the portal today -->
  <section class="mt-14 sm:mt-16">
    <div class="flex flex-col gap-1.5">
      <p class="overline text-muted">{t(locale, 'landing.services_overline')}</p>
      <h2 class="font-display text-h1 sm:text-display text-ink tracking-tight">{t(locale, 'landing.services_title')}</h2>
      <p class="measure text-small font-normal text-muted leading-relaxed">
        {t(locale, 'landing.services_desc')}
      </p>
    </div>

    <div class="mt-6 grid gap-5 sm:grid-cols-2">
      {
        services.map((service) => (
          <article class="card group flex flex-col gap-4 p-5 sm:p-6 transition-all duration-200 hover:border-teal-600 hover:shadow-e2">
            <span class="flex h-11 w-11 items-center justify-center rounded-input border border-border bg-subtle text-teal-600 shadow-sm transition-transform duration-200 group-hover:scale-105">
              <Icon name={service.icon} size={20} />
            </span>
            <div>
              <h3 class="text-h3 font-semibold text-ink transition-colors group-hover:text-teal-600">{service.title}</h3>
              <p class="measure mt-1.5 text-small font-normal text-muted leading-relaxed">{service.copy}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Trust band — intake policy and the institution that runs it -->
  <section class="relative overflow-hidden mt-14 sm:mt-16 rounded-hero border border-navy-700/80 bg-navy-900 p-6 sm:p-10 text-on-dark shadow-e2">
    <!-- Inset hairline border -->
    <div class="pointer-events-none absolute inset-2 rounded-[12px] border border-white/5" aria-hidden="true"></div>

    <div class="relative flex flex-col gap-5">
      <span class="flex h-12 w-12 items-center justify-center rounded-card border border-navy-700 bg-navy-800 text-gold-300 shadow-sm">
        <Icon name="shield-check" size={24} />
      </span>

      <div class="flex flex-col gap-2">
        <h2 class="font-display text-h1 sm:text-h2 text-surface font-semibold tracking-tight">
          {locale === 'fr' ? 'Règlement d’admission & justificatifs d’identité' : 'Intake policy & identification requirement'}
        </h2>
        <p class="measure text-body font-normal text-on-dark leading-relaxed">
          {locale === 'fr'
            ? 'L’hébergement est strictement réservé aux étudiants régulièrement inscrits figurant sur la liste officielle de l’université pour l’année académique en cours. Les dossiers non confirmés demeurent en attente jusqu’à validation par la Direction des Œuvres Universitaires (DOU) de Tlemcen.'
            : 'Accommodation is strictly reserved for actively matriculated university students appearing on the official university admission roster for the current academic year. Unmatched registrations remain pending until physical verification by the administration of Direction des Œuvres Universitaires (DOU) Tlemcen.'}
        </p>
      </div>

      <div class="mt-2 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between border-t border-navy-700/80 pt-5 text-small text-on-dark-2">
        <p class="flex items-center gap-2">
          <Icon name="map-pin" size={16} class="text-gold-300 shrink-0" />
          <span>Direction des Œuvres Universitaires · Cité Universitaire · Tlemcen</span>
        </p>
        <p class="tnum flex items-center gap-2 font-mono text-xs text-on-dark font-medium">
          <Icon name="phone" size={14} class="text-teal-400 shrink-0" />
          <span dir="ltr">{t(locale, 'landing.hotline')}</span>
        </p>
      </div>
    </div>
  </section>
</Layout>
