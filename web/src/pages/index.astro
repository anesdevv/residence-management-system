---
/**
 * RÉSIVO — landing (docs/DESIGN.md §8, plan Phase 4).
 * Brand-gradient hero (the only gradient surface here besides the primary CTA),
 * the real 4-step intake lifecycle and the services the portal actually offers.
 * Visual layer only: no data, no invented figures, no imagery.
 */
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import BrandMark from '../components/BrandMark.astro';
import { localizePath, t, type SupportedLocale } from '../lib/i18n';

const locale: SupportedLocale = Astro.locals.locale || 'en';

/* The real lifecycle: Register › Verification › Room assigned › Living in residence. */
const steps = [
  {
    label: t(locale, 'landing.step_1_title'),
    icon: 'id-card',
    copy: t(locale, 'landing.step_1_desc'),
  },
  {
    label: t(locale, 'landing.step_2_title'),
    icon: 'user-check',
    copy: t(locale, 'landing.step_2_desc'),
  },
  {
    label: t(locale, 'landing.step_3_title'),
    icon: 'bed',
    copy: t(locale, 'landing.step_3_desc'),
  },
  {
    label: t(locale, 'landing.step_4_title'),
    icon: 'home',
    copy: t(locale, 'landing.step_4_desc'),
  },
];

/* What a resident actually does in the portal — application status, room, tickets, transfers. */
const services = [
  {
    title: t(locale, 'landing.service_status_title'),
    icon: 'clock',
    copy: t(locale, 'landing.service_status_desc'),
  },
  {
    title: t(locale, 'landing.service_room_title'),
    icon: 'bed',
    copy: t(locale, 'landing.service_room_desc'),
  },
  {
    title: t(locale, 'landing.service_maintenance_title'),
    icon: 'wrench',
    copy: t(locale, 'landing.service_maintenance_desc'),
  },
  {
    title: t(locale, 'landing.service_transfers_title'),
    icon: 'arrow-left-right',
    copy: t(locale, 'landing.service_transfers_desc'),
  },
];
---

<Layout title={locale === 'fr' ? 'RÉSIVO — Portail Officiel d’Hébergement Étudiant' : 'RÉSIVO — Official Student Housing Portal'} activeNav="home">
  <!-- Hero — the brand gradient is allowed here and nowhere else on this page. -->
  <section
    class="relative overflow-hidden rounded-hero px-6 py-10 sm:px-10 sm:py-12"
    style="background-image: var(--grad-brand)"
  >
    <!-- Geometric pattern derived from the mark (windows + dot), ≤6% white -->
    <svg class="pointer-events-none absolute inset-0 h-full w-full text-surface opacity-5" aria-hidden="true">
      <defs>
        <pattern id="hero-windows" width="48" height="48" patternUnits="userSpaceOnUse">
          <path d="M6 6h12v12H6z" fill="none" stroke="currentColor" stroke-width="1.5" />
          <path d="M30 6h12v12H30z" fill="none" stroke="currentColor" stroke-width="1.5" />
          <path d="M6 30h12v12H6z" fill="none" stroke="currentColor" stroke-width="1.5" />
          <circle cx="36" cy="36" r="3" fill="currentColor" />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#hero-windows)" />
    </svg>

    <div class="relative flex flex-col gap-6">
      <BrandMark variant="logo" tone="white" size={112} alt="RÉSIVO" />

      <div class="flex flex-col gap-3">
        <p class="overline text-on-dark">{t(locale, 'landing.hero_overline')}</p>
        <h1 class="measure font-display text-h1 text-surface sm:text-display">
          {t(locale, 'landing.hero_title')}
        </h1>
        <p class="measure text-body text-on-dark">
          {t(locale, 'landing.hero_desc')}
        </p>
      </div>

      <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
        <a class="btn btn-gradient" href={localizePath(locale, '/register')}>
          <Icon name="user" size={18} />
          <span>{t(locale, 'landing.hero_register_cta')}</span>
        </a>
        <a
          class="btn border-on-dark/50 text-on-dark hover:border-on-dark hover:bg-surface/10"
          href={localizePath(locale, '/login')}
        >
          <Icon name="log-in" size={18} />
          <span>{t(locale, 'landing.hero_signin_cta')}</span>
        </a>
      </div>

      <p class="w-fit rounded-pill bg-navy-900/60 px-3 py-1 text-small font-normal text-on-dark">
        <span class="flex flex-wrap items-center gap-2">
          <Icon name="map-pin" size={14} />
          <span>Direction des Œuvres Universitaires · Cité Universitaire · Tlemcen</span>
        </span>
      </p>
    </div>
  </section>

  <!-- How it works — the four real stages of the intake lifecycle -->
  <section class="mt-12">
    <div class="flex flex-col gap-1">
      <h2 class="font-display text-h1 text-ink">{t(locale, 'landing.steps_title')}</h2>
      <p class="measure text-small font-normal text-muted">
        {t(locale, 'landing.steps_desc')}
      </p>
    </div>

    <ol class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        steps.map((step, index) => (
          <li class="card flex flex-col gap-3 p-4 sm:p-6">
            <span class="flex h-10 w-10 items-center justify-center rounded-input bg-subtle text-teal-600">
              <Icon name={step.icon} size={20} />
            </span>
            <span class="overline">{locale === 'fr' ? `Étape ${index + 1}` : `Step ${index + 1}`}</span>
            <h3 class="text-h3 text-ink">{step.label}</h3>
            <p class="text-small font-normal text-muted">{step.copy}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- What you can do — the services that exist in the portal today -->
  <section class="mt-12">
    <div class="flex flex-col gap-1">
      <h2 class="font-display text-h1 text-ink">{t(locale, 'landing.services_title')}</h2>
      <p class="measure text-small font-normal text-muted">
        {t(locale, 'landing.services_desc')}
      </p>
    </div>

    <div class="mt-6 grid gap-4 sm:grid-cols-2">
      {
        services.map((service) => (
          <article class="card flex flex-col gap-3 p-4 sm:p-6">
            <span class="flex h-10 w-10 items-center justify-center rounded-input bg-subtle text-teal-600">
              <Icon name={service.icon} size={20} />
            </span>
            <h3 class="text-h3 text-ink">{service.title}</h3>
            <p class="measure text-small font-normal text-muted">{service.copy}</p>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Trust band — intake policy and the institution that runs it -->
  <section class="mt-12 flex flex-col gap-4 rounded-hero bg-navy-900 p-6 text-on-dark sm:p-8">
    <span class="flex h-12 w-12 items-center justify-center rounded-card bg-navy-800 text-gold-300">
      <Icon name="shield-check" size={24} />
    </span>
    <h2 class="font-display text-h2 text-surface">
      {locale === 'fr' ? 'Règlement d’admission & justificatifs d’identité' : 'Intake policy & identification requirement'}
    </h2>
    <p class="measure text-small font-normal text-on-dark">
      {locale === 'fr'
        ? 'L’hébergement est strictement réservé aux étudiants régulièrement inscrits figurant sur la liste officielle de l’université pour l’année académique en cours. Les dossiers non confirmés demeurent en attente jusqu’à validation par la Direction des Œuvres Universitaires (DOU) de Tlemcen.'
        : 'Accommodation is strictly reserved for actively matriculated university students appearing on the official university admission roster for the current academic year. Unmatched registrations remain pending until physical verification by the administration of Direction des Œuvres Universitaires (DOU) Tlemcen.'}
    </p>
    <p class="flex flex-wrap items-center gap-2 border-t border-navy-700 pt-4 text-small text-on-dark">
      <Icon name="map-pin" size={16} class="text-gold-300" />
      <span>Direction des Œuvres Universitaires · Cité Universitaire · Tlemcen</span>
    </p>
  </section>
</Layout>
