---
/**
 * RÉSIVO — StatCard (docs/DESIGN.md §6).
 * Outfit number + overline label + hint, icon in a soft tinted square.
 * Gold is decorative only: the tinted square is soft gold, the glyph stays navy.
 */
import Icon from './Icon.astro';

interface Props {
  label: string;
  value: string | number;
  hint?: string;
  icon: string;
  accent?: 'teal' | 'navy' | 'gold' | 'danger';
  class?: string;
}

const { label, value, hint, icon, accent = 'teal', class: className = '' } = Astro.props;

const ACCENTS: Record<string, string> = {
  teal: 'bg-teal-600/10 text-teal-600',
  navy: 'bg-navy-800/10 text-navy-800',
  gold: 'bg-gold-500/15 text-navy-800',
  danger: 'bg-danger-bg text-danger',
};
const accentClass = ACCENTS[accent] ?? ACCENTS.teal;
---

<div class={`card p-4 sm:p-6 ${className}`}>
  <div class="flex items-start justify-between gap-4">
    <span class="overline">{label}</span>
    <span class={`flex h-11 w-11 shrink-0 items-center justify-center rounded-input ${accentClass}`}>
      <Icon name={icon} size={20} />
    </span>
  </div>
  <p class="mt-3 font-display text-display tnum text-ink">{value}</p>
  {hint && <p class="mt-1 text-small font-normal text-muted">{hint}</p>}
</div>
