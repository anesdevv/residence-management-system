---
// web/src/components/ResendButton.astro
import Icon from './Icon.astro';

interface Props {
  endpoint: string; // API endpoint to POST to for resend
  identifierKey?: string; // Input field or param name, e.g. 'email' or 'identifier'
  identifierValue?: string; // Target email or card id
  flow?: 'signup' | 'recovery' | 'magiclink' | 'email_change';
  class?: string;
}

const {
  endpoint,
  identifierKey = 'email',
  identifierValue = '',
  flow = 'signup',
  class: className = '',
} = Astro.props;
---

<div
  class={`resend-control flex flex-col items-center gap-2 ${className}`}
  data-resend-root
  data-endpoint={endpoint}
  data-id-key={identifierKey}
  data-id-val={identifierValue}
  data-flow={flow}
>
  <button
    type="button"
    class="btn btn-secondary text-small py-2 px-4 transition-all disabled:opacity-60 disabled:cursor-not-allowed"
    data-resend-btn
  >
    <Icon name="refresh-cw" size={15} />
    <span data-resend-label>Resend code</span>
  </button>

  <p
    class="text-xs text-muted text-center"
    role="status"
    aria-live="polite"
    data-resend-status
  >
    You can request another code after the countdown.
  </p>

  <div
    class="hidden w-full text-xs text-danger bg-danger-subtle border border-danger-line rounded-input p-2.5 text-center mt-1"
    data-resend-error
  ></div>
</div>

<script>
  import { calculateCooldown, formatProviderRateLimitError } from '../lib/resend-cooldown';

  function setupResendControls() {
    const controls = document.querySelectorAll<HTMLElement>('[data-resend-root]');

    controls.forEach((root) => {
      if ((root as any).__resendInitialized) return;
      (root as any).__resendInitialized = true;

      const endpoint = root.getAttribute('data-endpoint') ?? '';
      const idKey = root.getAttribute('data-id-key') ?? 'email';
      let idVal = root.getAttribute('data-id-val') ?? '';
      const flow = root.getAttribute('data-flow') ?? 'signup';

      const btn = root.querySelector<HTMLButtonElement>('[data-resend-btn]');
      const label = root.querySelector<HTMLElement>('[data-resend-label]');
      const statusEl = root.querySelector<HTMLElement>('[data-resend-status]');
      const errorEl = root.querySelector<HTMLElement>('[data-resend-error]');

      const storagePrefix = `resivo_resend_${flow}`;
      
      function getHistory(): number[] {
        try {
          const raw = sessionStorage.getItem(`${storagePrefix}_history`);
          return raw ? JSON.parse(raw) : [];
        } catch {
          return [];
        }
      }

      function getLastSent(): number | null {
        try {
          const raw = sessionStorage.getItem(`${storagePrefix}_last`);
          return raw ? Number(raw) : null;
        } catch {
          return null;
        }
      }

      function recordSend() {
        const now = Date.now();
        const history = getHistory().filter((t) => now - t < 60 * 60 * 1000);
        history.push(now);
        try {
          sessionStorage.setItem(`${storagePrefix}_last`, String(now));
          sessionStorage.setItem(`${storagePrefix}_history`, JSON.stringify(history));
        } catch {}
      }

      let timer: any = null;

      function updateUI() {
        const state = calculateCooldown(getLastSent(), getHistory());

        if (btn) btn.disabled = !state.canResend;
        if (label) label.textContent = state.buttonLabel;
        if (statusEl) statusEl.textContent = state.statusText;

        if (state.secondsRemaining > 0 && !timer) {
          timer = setInterval(() => {
            updateUI();
          }, 1000);
        } else if (state.secondsRemaining === 0 && timer) {
          clearInterval(timer);
          timer = null;
        }
      }

      // Initial render
      updateUI();

      if (btn) {
        btn.addEventListener('click', async () => {
          const state = calculateCooldown(getLastSent(), getHistory());
          if (!state.canResend) return;

          // If idVal wasn't set statically, attempt to read from form on the page
          if (!idVal) {
            const input = document.querySelector<HTMLInputElement>(`input[name="${idKey}"], input#${idKey}`);
            if (input) idVal = input.value;
          }

          if (errorEl) {
            errorEl.classList.add('hidden');
            errorEl.textContent = '';
          }

          btn.disabled = true;
          if (label) label.textContent = 'Sending...';

          try {
            const response = await fetch(endpoint, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ [idKey]: idVal, flow }),
            });

            if (!response.ok) {
              const data = await response.json().catch(() => ({}));
              throw new Error(data.message || `Request failed with status ${response.status}`);
            }

            recordSend();
            updateUI();
          } catch (err: any) {
            if (errorEl) {
              errorEl.textContent = formatProviderRateLimitError(err);
              errorEl.classList.remove('hidden');
            }
            updateUI();
          }
        });
      }
    });
  }

  setupResendControls();
  document.addEventListener('astro:page-load', setupResendControls);
</script>
