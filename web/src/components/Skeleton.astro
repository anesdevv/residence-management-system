---
/**
 * RÉSIVO — Skeleton (docs/DESIGN.md §6, §10).
 * Pure placeholders: always `aria-hidden="true"`. Mark the region that is
 * loading with `aria-busy="true"` on the page side.
 * Reduced motion is honoured globally (the pulse is disabled in global.css).
 */
interface Props {
  variant?: 'line' | 'rows' | 'card';
  rows?: number;
  class?: string;
}

const { variant = 'line', rows = 3, class: className = '' } = Astro.props;
---

{
  variant === 'line' && <span class={`skeleton block h-4 w-full ${className}`} aria-hidden="true" />
}

{
  variant === 'rows' && (
    <div class={`flex flex-col gap-2 ${className}`} aria-hidden="true">
      {Array.from({ length: rows }).map((_, index) => (
        <span class={`skeleton block h-4 ${index === rows - 1 ? 'w-3/5' : 'w-full'}`} />
      ))}
    </div>
  )
}

{
  variant === 'card' && (
    <div class={`card p-4 sm:p-6 ${className}`} aria-hidden="true">
      <span class="skeleton block h-5 w-2/5" />
      <div class="mt-4 flex flex-col gap-2">
        {Array.from({ length: rows }).map((_, index) => (
          <span class={`skeleton block h-4 ${index === rows - 1 ? 'w-1/2' : 'w-full'}`} />
        ))}
      </div>
    </div>
  )
}
