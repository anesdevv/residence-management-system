---
/**
 * RÉSIVO — DashboardShell (docs/DESIGN.md §8).
 * Desktop: sticky top nav with the brand mark, the four section links
 * (Dashboard · Maintenance · Room change · Profile) with a teal-600 active
 * state, the institutional block, the user avatar and sign-out.
 * Mobile: bottom tab bar with icons + labels, safe-area padding, active = teal-600.
 * Every target is ≥ 44px on touch; no scripts, no layout shift.
 */
import Icon from './Icon.astro';
import BrandMark from './BrandMark.astro';
import Avatar from './Avatar.astro';
import { localizePath, t, type SupportedLocale } from '../lib/i18n';

interface Props {
  title: string;
  activeNav: 'dashboard' | 'maintenance' | 'room-change' | 'profile';
}

const { activeNav } = Astro.props;
const rawEmail = Astro.locals.user?.email ?? '';
const isSyntheticAuth = rawEmail.toLowerCase().endsWith('@students.residence.local');
const displayIdentity = isSyntheticAuth ? rawEmail.split('@')[0] : rawEmail;
const locale: SupportedLocale = Astro.locals.locale || 'en';

const pathname = Astro.url.pathname;
const cleanQuery = new URLSearchParams(Astro.url.search);
cleanQuery.delete('lang');
const queryString = cleanQuery.toString() ? `?${cleanQuery.toString()}` : '';
const targetEnBase = localizePath('en', pathname) + queryString;
const targetFrBase = localizePath('fr', pathname) + queryString;

const targetEnPath = targetEnBase + (targetEnBase.includes('?') ? '&lang=en' : '?lang=en');
const targetFrPath = targetFrBase + (targetFrBase.includes('?') ? '&lang=fr' : '?lang=fr');

const navItems = [
  {
    key: 'dashboard',
    href: localizePath(locale, '/dashboard'),
    label: t(locale, 'nav.overview'),
    short: locale === 'fr' ? 'Accueil' : 'Overview',
    icon: 'dashboard',
  },
  {
    key: 'maintenance',
    href: localizePath(locale, '/dashboard/maintenance'),
    label: t(locale, 'nav.maintenance'),
    short: locale === 'fr' ? 'Travaux' : 'Fixes',
    icon: 'wrench',
  },
  {
    key: 'room-change',
    href: localizePath(locale, '/dashboard/room-change'),
    label: locale === 'fr' ? 'Changement de chambre' : 'Room Transfer',
    short: locale === 'fr' ? 'Transfert' : 'Transfer',
    icon: 'arrow-left-right',
  },
  {
    key: 'profile',
    href: localizePath(locale, '/dashboard/profile'),
    label: t(locale, 'nav.profile'),
    short: locale === 'fr' ? 'Profil' : 'Profile',
    icon: 'user',
  },
] as const;
---

<div class="min-h-screen bg-canvas">
  <a class="skip" href="#main-content">
    {locale === 'fr' ? 'Aller au contenu principal' : 'Skip to main content'}
  </a>
  <header class="sticky top-0 z-40 h-16 border-b border-line bg-surface">
    <div class="mx-auto flex h-full max-w-7xl items-center justify-between gap-3 px-4 sm:px-6">
      <!-- Clean Brand Logo without truncating page subtitle -->
      <a href={localizePath(locale, '/dashboard')} class="flex shrink-0 items-center gap-2.5 whitespace-nowrap" aria-label="RÉSIVO">
        <BrandMark variant="mark" size={32} />
        <span class="font-display text-h2 font-bold tracking-tight text-ink">RÉSIVO</span>
      </a>

      <!-- Desktop Navigation Links (single row, no wrapping) -->
      <nav aria-label="Dashboard" class="hidden md:flex items-center gap-1 mx-2 lg:mx-6 overflow-hidden">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              aria-current={activeNav === item.key ? 'page' : undefined}
              class={`whitespace-nowrap inline-flex min-h-[38px] items-center gap-2 rounded-input px-3 py-1.5 text-small font-medium transition-colors ${
                activeNav === item.key
                  ? 'bg-subtle text-ink font-semibold'
                  : 'text-muted hover:text-ink hover:bg-subtle/60'
              }`}
            >
              <Icon name={item.icon} size={16} class={activeNav === item.key ? 'text-teal-600' : 'text-muted'} />
              <span>{item.label}</span>
            </a>
          ))
        }
      </nav>

      <!-- Right Controls: Language toggle + User Avatar + Sign out -->
      <div class="ms-auto flex items-center gap-2 sm:gap-3">
        <!-- Language switcher -->
        <nav aria-label={t(locale, 'nav.language')} class="flex items-center rounded-input border border-line bg-subtle p-0.5 text-small font-semibold shrink-0">
          <a
            href={targetFrPath}
            data-locale-switch="fr"
            class={`rounded-input px-2.5 py-1 transition-colors whitespace-nowrap ${
              locale === 'fr' ? 'bg-surface text-ink shadow-e1' : 'text-muted hover:text-ink'
            }`}
            aria-current={locale === 'fr' ? 'true' : undefined}
          >
            FR
          </a>
          <a
            href={targetEnPath}
            data-locale-switch="en"
            class={`rounded-input px-2.5 py-1 transition-colors whitespace-nowrap ${
              locale === 'en' ? 'bg-surface text-ink shadow-e1' : 'text-muted hover:text-ink'
            }`}
            aria-current={locale === 'en' ? 'true' : undefined}
          >
            EN
          </a>
        </nav>

        <a
          href={localizePath(locale, '/dashboard/profile')}
          class="flex items-center gap-2 rounded-input p-1 hover:bg-subtle transition-colors shrink-0 touch-target-44"
          aria-label={`Signed in as ${displayIdentity || 'resident'}, open profile`}
          title={displayIdentity}
        >
          <Avatar name={displayIdentity || 'Resident Student'} size={32} />
          <span class="hidden xl:inline-block max-w-[120px] truncate text-small font-medium text-ink">{displayIdentity}</span>
        </a>

        <a
          href="/logout"
          class="btn btn-secondary btn-sm whitespace-nowrap shrink-0 hidden sm:inline-flex"
          aria-label={t(locale, 'nav.sign_out')}
        >
          <Icon name="log-out" size={15} />
          <span class="text-small">{t(locale, 'nav.sign_out')}</span>
        </a>
      </div>
    </div>
  </header>

  <main id="main-content" class="pb-24 md:pb-12">
    <div class="mx-auto w-full max-w-7xl px-4 py-6 sm:px-6 lg:py-8">
      <slot />
    </div>
  </main>

  <nav
    aria-label="Dashboard"
    class="fixed inset-x-0 bottom-0 z-50 border-t border-line bg-surface pb-safe md:hidden"
  >
    <div class="mx-auto grid h-16 max-w-lg grid-cols-4 px-1">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            aria-current={activeNav === item.key ? 'page' : undefined}
            class={`flex min-h-[44px] flex-col items-center justify-center gap-1 py-1.5 text-small transition-colors ${
              activeNav === item.key ? 'font-semibold text-teal-600' : 'text-muted hover:text-ink'
            }`}
          >
            <Icon name={item.icon} size={20} class={activeNav === item.key ? 'text-teal-600' : 'text-muted'} />
            <span class="truncate max-w-[72px] text-center text-small leading-tight">{item.short}</span>
          </a>
        ))
      }
    </div>
  </nav>
</div>
