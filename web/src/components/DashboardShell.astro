---
/**
 * RÉSIVO — DashboardShell (docs/DESIGN.md §8).
 * Desktop: sticky top nav with the brand mark, the four section links
 * (Dashboard · Maintenance · Room change · Profile) with a teal-600 active
 * state, the institutional block, the user avatar and sign-out.
 * Mobile: bottom tab bar with icons + labels, safe-area padding, active = teal-600.
 * Every target is ≥ 44px on touch; no scripts, no layout shift.
 */
import Icon from './Icon.astro';
import BrandMark from './BrandMark.astro';
import Avatar from './Avatar.astro';
import { localizePath, t, type SupportedLocale } from '../lib/i18n';

interface Props {
  title: string;
  activeNav: 'dashboard' | 'maintenance' | 'room-change' | 'profile';
}

const { title, activeNav } = Astro.props;
const rawEmail = Astro.locals.user?.email ?? '';
const isSyntheticAuth = rawEmail.toLowerCase().endsWith('@students.residence.local');
const displayIdentity = isSyntheticAuth ? rawEmail.split('@')[0] : rawEmail;
const locale: SupportedLocale = Astro.locals.locale || 'en';

const pathname = Astro.url.pathname;
const cleanQuery = new URLSearchParams(Astro.url.search);
cleanQuery.delete('lang');
const queryString = cleanQuery.toString() ? `?${cleanQuery.toString()}` : '';
const targetEnBase = localizePath('en', pathname) + queryString;
const targetFrBase = localizePath('fr', pathname) + queryString;

const targetEnPath = targetEnBase + (targetEnBase.includes('?') ? '&lang=en' : '?lang=en');
const targetFrPath = targetFrBase + (targetFrBase.includes('?') ? '&lang=fr' : '?lang=fr');

const navItems = [
  { key: 'dashboard', href: localizePath(locale, '/dashboard'), label: t(locale, 'nav.overview'), short: t(locale, 'nav.overview'), icon: 'dashboard' },
  { key: 'maintenance', href: localizePath(locale, '/dashboard/maintenance'), label: t(locale, 'nav.maintenance'), short: t(locale, 'nav.maintenance'), icon: 'wrench' },
  { key: 'room-change', href: localizePath(locale, '/dashboard/room-change'), label: t(locale, 'terms.room_change_request'), short: t(locale, 'nav.room_changes'), icon: 'arrow-left-right' },
  { key: 'profile', href: localizePath(locale, '/dashboard/profile'), label: t(locale, 'nav.profile'), short: t(locale, 'nav.profile'), icon: 'user' },
] as const;
---

<div class="min-h-screen bg-canvas">
  <!-- 3px brand-gradient strip at the shell top edge. -->
  <div class="gradient-top-line"></div>

  <header class="sticky top-0 z-40 border-b border-line bg-surface/90 backdrop-blur-md">
    <div class="mx-auto flex h-16 max-w-7xl items-center gap-4 px-4 sm:px-6">
      <a href={localizePath(locale, '/dashboard')} class="flex min-w-0 shrink-0 items-center gap-3" aria-label="RÉSIVO dashboard">
        <BrandMark variant="mark" size={36} />
        <span class="flex min-w-0 flex-col">
          <span class="font-display text-h2 text-ink">RÉSIVO</span>
          <span class="truncate text-small font-normal text-muted">{title}</span>
        </span>
      </a>

      <nav aria-label="Dashboard" class="ml-auto hidden items-center gap-1 lg:flex">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              aria-current={activeNav === item.key ? 'page' : undefined}
              class={`relative inline-flex min-h-11 items-center gap-2 rounded-input px-3 text-body font-semibold transition-colors ${
                activeNav === item.key ? 'text-teal-600' : 'text-ink-2 hover:bg-subtle hover:text-ink'
              }`}
            >
              <Icon name={item.icon} size={18} />
              <span>{item.label}</span>
              {activeNav === item.key && (
                <span class="absolute inset-x-2 bottom-0 h-0.5 rounded-pill bg-teal-600" aria-hidden="true" />
              )}
            </a>
          ))
        }
      </nav>

      <div class="ml-auto flex min-w-0 items-center gap-2 sm:gap-3 lg:ml-3">
        <!-- Language switcher -->
        <nav aria-label={t(locale, 'nav.language')} class="flex items-center rounded-pill border border-line bg-subtle p-0.5 text-xs font-semibold">
          <a
            href={targetFrPath}
            data-locale-switch="fr"
            class={`rounded-pill px-2.5 py-1 transition-colors ${
              locale === 'fr' ? 'bg-surface text-ink shadow-xs' : 'text-muted hover:text-ink'
            }`}
            aria-current={locale === 'fr' ? 'true' : undefined}
          >
            FR
          </a>
          <a
            href={targetEnPath}
            data-locale-switch="en"
            class={`rounded-pill px-2.5 py-1 transition-colors ${
              locale === 'en' ? 'bg-surface text-ink shadow-xs' : 'text-muted hover:text-ink'
            }`}
            aria-current={locale === 'en' ? 'true' : undefined}
          >
            EN
          </a>
        </nav>

        <span class="hidden flex-col items-end xl:flex">
          <span class="text-small font-semibold text-ink-2">Cité Universitaire Tlemcen</span>
          <span class="text-small font-normal text-muted">Direction des Œuvres Universitaires (DOU)</span>
        </span>
        <span class="hidden max-w-[12rem] truncate text-small font-normal text-muted 2xl:block">{displayIdentity}</span>
        <a
          href={localizePath(locale, '/dashboard/profile')}
          class="shrink-0 rounded-input p-0.5"
          aria-label={`Signed in as ${displayIdentity || 'resident'} — open profile`}
        >
          <Avatar name={displayIdentity || 'Resident'} size={40} />
        </a>
        <a href="/logout" class="btn btn-secondary shrink-0" aria-label={t(locale, 'nav.sign_out')}>
          <Icon name="log-out" size={16} />
          <span class="hidden sm:inline">{t(locale, 'nav.sign_out')}</span>
        </a>
      </div>
    </div>
  </header>

  <main class="pb-24 lg:pb-12">
    <div class="mx-auto w-full max-w-7xl px-4 py-6 sm:px-6 lg:py-8">
      <slot />
    </div>
  </main>

  <nav
    aria-label="Dashboard"
    class="fixed inset-x-0 bottom-0 z-50 border-t border-line bg-surface/95 pb-safe backdrop-blur-md lg:hidden"
  >
    <div class="mx-auto grid h-16 max-w-lg grid-cols-4 px-1">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            aria-current={activeNav === item.key ? 'page' : undefined}
            class={`flex min-h-11 flex-col items-center justify-center gap-1 py-2 text-small transition-colors ${
              activeNav === item.key ? 'font-semibold text-teal-600' : 'text-muted'
            }`}
          >
            <Icon name={item.icon} size={22} />
            <span>{item.short}</span>
          </a>
        ))
      }
    </div>
  </nav>
</div>
