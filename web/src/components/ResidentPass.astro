---
/**
 * RÉSIVO — ResidentPass (docs/DESIGN.md §1, §6, §8).
 * Official digital resident credential card.
 * World-class institutional credential with crisp border framing,
 * high-contrast typography, strict tabular figures, and official verified status badge.
 */
import BrandMark from './BrandMark.astro';
import Icon from './Icon.astro';
import { t, formatFloor, type SupportedLocale } from '../lib/i18n';

interface Props {
  fullName: string;
  cardId: string;
  block: string | number;
  floor: string | number;
  room: string | number;
  studyLevel?: string;
  university?: string;
  issuedAt?: string;
  class?: string;
}

const { fullName, cardId, block, floor, room, studyLevel, university, issuedAt, class: className = '' } = Astro.props;
const locale: SupportedLocale = Astro.locals.locale || 'en';

const institutionLabel = locale === 'fr'
  ? 'Direction des Œuvres Universitaires · DOU Tlemcen'
  : 'Direction des Œuvres Universitaires · DOU Tlemcen';
const stateLabel = locale === 'fr'
  ? 'République Algérienne Démocratique et Populaire'
  : "People's Democratic Republic of Algeria";
---

<article
  class={`relative overflow-hidden rounded-hero border border-white/20 shadow-e2 max-w-xl w-full ${className}`}
  style="background-image: var(--grad-brand);"
  aria-label="Resident pass"
>
  <!-- Legibility plate: guarantees AA/AAA contrast on every text element against gradient -->
  <span class="absolute inset-0 bg-navy-900/60 backdrop-blur-[1px]" aria-hidden="true"></span>

  <!-- Security guilloche micro-texture watermark -->
  <svg
    class="pointer-events-none absolute inset-0 h-full w-full opacity-[0.05] text-surface"
    xmlns="http://www.w3.org/2000/svg"
    width="100%"
    height="100%"
    aria-hidden="true"
  >
    <defs>
      <pattern id="pass-security-grid" width="32" height="32" patternUnits="userSpaceOnUse">
        <circle cx="16" cy="16" r="0.75" fill="currentColor" />
        <path d="M0 16h32M16 0v32" stroke="currentColor" stroke-width="0.5" stroke-dasharray="2 4" />
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#pass-security-grid)" />
  </svg>

  <!-- Inset hairline security perimeter framing -->
  <div
    class="pointer-events-none absolute inset-1.5 sm:inset-2.5 rounded-[12px] border border-white/10"
    aria-hidden="true"
  >
    <!-- Corner registration marks -->
    <span class="absolute top-1 start-1.5 font-mono text-[9px] text-gold-300/40 select-none">+</span>
    <span class="absolute top-1 end-1.5 font-mono text-[9px] text-gold-300/40 select-none">+</span>
    <span class="absolute bottom-1 start-1.5 font-mono text-[9px] text-gold-300/40 select-none">+</span>
    <span class="absolute bottom-1 end-1.5 font-mono text-[9px] text-gold-300/40 select-none">+</span>
  </div>

  <div class="relative flex flex-col gap-5 p-4 sm:p-7">
    <!-- Institutional Top Authority Header -->
    <div class="flex flex-col gap-2 border-b border-white/15 pb-4">
      <div class="flex flex-wrap items-center justify-between gap-2 text-[10px] font-mono uppercase tracking-widest text-on-dark-2">
        <span>{stateLabel}</span>
        <span class="text-gold-300/90 font-semibold">{institutionLabel}</span>
      </div>

      <div class="flex items-center justify-between gap-4 pt-1">
        <div class="flex items-center gap-3">
          <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-input border border-white/15 bg-white/10 p-1.5 shadow-sm">
            <BrandMark variant="mark" tone="white" size={32} alt="" />
          </div>
          <div>
            <p class="font-display text-h2 font-bold tracking-tight text-surface">RÉSIVO</p>
            <p class="text-small font-normal text-on-dark-2">Cité Universitaire · Tlemcen</p>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <span class="inline-flex items-center gap-1.5 rounded-input border border-gold-500/35 bg-gold-500/15 px-2.5 py-1 text-xs font-semibold uppercase tracking-wider text-gold-300 shadow-sm">
            <span class="h-1.5 w-1.5 rounded-full bg-gold-400" aria-hidden="true"></span>
            <span>{t(locale, 'dashboard.pass_title')}</span>
          </span>
        </div>
      </div>
    </div>

    <!-- Resident Identity Block -->
    <div>
      <p class="overline text-on-dark-2">{t(locale, 'terms.resident')}</p>
      <p class="font-display text-h1 sm:text-display font-bold tracking-tight text-surface">
        {fullName}
      </p>
      <div class="mt-1 flex flex-wrap items-center gap-2 text-small font-normal text-on-dark">
        {studyLevel && (
          <span class="inline-flex items-center rounded-pill border border-white/20 bg-white/10 px-2 py-0.5 text-xs font-semibold text-surface">
            {studyLevel}
          </span>
        )}
        {studyLevel && university && <span class="text-on-dark-2">·</span>}
        <span>{university || 'Université de Tlemcen'}</span>
      </div>
    </div>

    <!-- Quarters Allocation Matrix (Block / Floor / Room) -->
    <dl class="grid grid-cols-3 divide-x divide-white/15 rtl:divide-x-reverse rounded-input border border-white/20 bg-white/[0.04] p-3 sm:p-4 text-center sm:text-start backdrop-blur-[2px]">
      <div class="min-w-0 px-2 sm:px-3 first:ps-0 last:pe-0">
        <dt class="overline text-on-dark-2">{t(locale, 'fields.block')}</dt>
        <dd class="tnum font-display text-h1 sm:text-display font-semibold text-surface tracking-tight">
          {block}
        </dd>
      </div>
      <div class="min-w-0 px-2 sm:px-3 first:ps-0 last:pe-0">
        <dt class="overline text-on-dark-2">{t(locale, 'fields.floor')}</dt>
        <dd class="tnum font-display text-h1 sm:text-display font-semibold text-surface tracking-tight">
          {formatFloor(floor, locale, true)}
        </dd>
      </div>
      <div class="min-w-0 px-2 sm:px-3 first:ps-0 last:pe-0">
        <dt class="overline text-on-dark-2">{t(locale, 'fields.room')}</dt>
        <dd class="tnum font-display text-h1 sm:text-display font-semibold text-surface tracking-tight">
          {room}
        </dd>
      </div>
    </dl>

    <!-- Security & Verification Bottom Bar (Card ID + Verified status badge) -->
    <div class="flex flex-col gap-4 border-t border-white/15 pt-4 sm:flex-row sm:items-end sm:justify-between">
      <div class="min-w-0">
        <dt class="overline text-on-dark-2">{t(locale, 'fields.card_id')}</dt>
        <dd class="tnum font-mono text-h2 font-semibold tracking-wider text-surface" dir="ltr">
          {cardId}
        </dd>
        {issuedAt && (
          <p class="tnum mt-1 flex items-center gap-1.5 text-xs text-on-dark-2">
            <Icon name="calendar" size={13} class="text-gold-300" />
            <span>{t(locale, 'dashboard.pass_issued', { date: issuedAt })}</span>
          </p>
        )}
      </div>

      <!-- Official Verified Status Badge -->
      <div class="inline-flex items-center gap-2 rounded-input border border-teal-400/40 bg-teal-500/20 px-3.5 py-2 text-on-dark shadow-sm">
        <Icon name="shield-check" size={18} class="text-teal-300 shrink-0" />
        <span class="text-xs font-semibold uppercase tracking-wider text-teal-200">
          {t(locale, 'dashboard.pass_verified')}
        </span>
      </div>
    </div>
  </div>
</article>
