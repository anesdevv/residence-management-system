---
/**
 * RÉSIVO — ResidentPass (docs/DESIGN.md §1, §6, §8).
 * The ONE place the brand gradient + gold live on the web portal.
 *
 * Legibility: the gradient is overlaid with a translucent navy plate
 * (`bg-navy-900/45`, a token utility — no raw colour) so every label keeps
 * WCAG AA against the teal/green end of the gradient; the QR block sits on a
 * solid `surface` plate with `navy-900` modules.
 *
 * The QR-style block is deterministic: a pure function of `cardId`
 * (FNV-1a seed → xorshift32 bit stream on a 21×21 grid with the three real
 * finder patterns and the timing rows). No Date, no Math.random, no library —
 * the same card id always renders byte-identical SVG.
 */
import BrandMark from './BrandMark.astro';

interface Props {
  fullName: string;
  cardId: string;
  block: string | number;
  floor: string | number;
  room: string | number;
  studyLevel?: string;
  university?: string;
  issuedAt?: string;
  class?: string;
}

const { fullName, cardId, block, floor, room, studyLevel, university, issuedAt, class: className = '' } = Astro.props;

/* --- deterministic QR-style grid ------------------------------------------ */
const GRID = 21;

let seed = 0x811c9dc5;
for (const char of cardId || 'RÉSIVO') {
  seed ^= char.codePointAt(0) ?? 0;
  seed = Math.imul(seed, 0x01000193);
}
seed = (seed >>> 0) || 0x9e3779b9;

const nextBit = () => {
  seed ^= seed << 13;
  seed >>>= 0;
  seed ^= seed >>> 17;
  seed ^= seed << 5;
  seed >>>= 0;
  return (seed & 1) === 1;
};

/** Finder-pattern value at (x, y); null outside the three 7×7 blocks. */
const finderValue = (x: number, y: number): boolean | null => {
  let lx = -1;
  let ly = -1;
  if (x < 7 && y < 7) {
    lx = x;
    ly = y;
  } else if (x >= 14 && y < 7) {
    lx = x - 14;
    ly = y;
  } else if (x < 7 && y >= 14) {
    lx = x;
    ly = y - 14;
  }
  if (lx < 0) return null;
  return Math.max(Math.abs(lx - 3), Math.abs(ly - 3)) !== 2;
};

/** Quiet separators around each finder block. */
const inFinderArea = (x: number, y: number) =>
  (x < 8 && y < 8) || (x >= 13 && y < 8) || (x < 8 && y >= 13);

let modules = '';
for (let y = 0; y < GRID; y += 1) {
  for (let x = 0; x < GRID; x += 1) {
    const finder = finderValue(x, y);
    let dark: boolean;
    if (finder !== null) dark = finder;
    else if (inFinderArea(x, y)) dark = false;
    else if (y === 6) dark = x % 2 === 0; // timing row
    else if (x === 6) dark = y % 2 === 0; // timing column
    else dark = nextBit();
    if (dark) modules += `M${x} ${y}h1v1h-1z`;
  }
}

const meta = [studyLevel, university].filter(Boolean).join(' · ');
---

<article
  class={`relative overflow-hidden rounded-hero shadow-e2 ${className}`}
  style="background-image: var(--grad-brand)"
  aria-label="Resident pass"
>
  <!-- Legibility plate: keeps every label AA against the gradient. -->
  <span class="absolute inset-0 bg-navy-900/45" aria-hidden="true"></span>

  <div class="relative flex flex-col gap-5 p-5 sm:p-6">
    <div class="flex items-start justify-between gap-4">
      <div class="flex items-center gap-3">
        <BrandMark variant="mark" tone="white" size={36} alt="" />
        <div>
          <p class="font-display text-h2 text-surface">RÉSIVO</p>
          <p class="text-small font-normal text-on-dark">Cité Universitaire · Tlemcen</p>
        </div>
      </div>
      <p class="overline text-gold-300 text-right">Resident pass</p>
    </div>

    <div>
      <p class="overline text-on-dark">Resident</p>
      <p class="font-display text-h1 text-surface">{fullName}</p>
      {meta && <p class="mt-0.5 text-small font-normal text-on-dark">{meta}</p>}
    </div>

    <dl class="grid grid-cols-3 gap-4 border-y border-surface/25 py-4">
      <div class="min-w-0">
        <dt class="overline text-on-dark">Block</dt>
        <dd class="font-display text-h1 tnum text-surface">{block}</dd>
      </div>
      <div class="min-w-0">
        <dt class="overline text-on-dark">Floor</dt>
        <dd class="font-display text-h1 tnum text-surface">{floor}</dd>
      </div>
      <div class="min-w-0">
        <dt class="overline text-on-dark">Room</dt>
        <dd class="font-display text-h1 tnum text-surface">{room}</dd>
      </div>
    </dl>

    <div class="flex items-end justify-between gap-4">
      <div class="min-w-0">
        <p class="overline text-on-dark">Card ID</p>
        <p class="tnum font-display text-h2 text-surface">{cardId}</p>
        {issuedAt && <p class="mt-1 text-small font-normal text-on-dark">Issued {issuedAt}</p>}
      </div>
      <div class="shrink-0 rounded-input bg-surface p-2">
        <svg
          viewBox={`0 0 ${GRID} ${GRID}`}
          width={96}
          height={96}
          class="block h-24 w-24 text-navy-900"
          shape-rendering="crispEdges"
          aria-hidden="true"
          focusable="false"
        >
          <path d={modules} fill="currentColor" />
        </svg>
      </div>
    </div>
  </div>
</article>
