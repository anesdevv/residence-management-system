---
/**
 * RÉSIVO — KeyValue (docs/DESIGN.md §6).
 * A 2-column `<dl>` of label/value rows: overline muted label, `text-ink` value,
 * `.tnum` for IDs, room numbers, counts and dates.
 *
 * Data form:
 *   <KeyValue rows={[{ label: 'Card ID', value: '20230001', tnum: true }]} />
 *
 * Slot form — pass your own <dt>/<dd> pairs wrapped in a plain <div>:
 *   <KeyValue columns={1}>
 *     <div>
 *       <dt class="overline">Faculty</dt>
 *       <dd class="text-body text-ink">Sciences</dd>
 *     </div>
 *   </KeyValue>
 */
interface Row {
  label: string;
  value: string | number;
  /** Tabular figures — use for IDs, numbers, dates. */
  tnum?: boolean;
  /** Tabular figures + wider tracking, for card/mono-style values. */
  mono?: boolean;
}

interface Props {
  rows?: Row[];
  columns?: 1 | 2;
  class?: string;
}

const { rows, columns = 2, class: className = '' } = Astro.props;
const gridClass = columns === 1 ? 'grid-cols-1' : 'grid-cols-1 sm:grid-cols-2';
---

<dl class={`grid gap-x-6 gap-y-3 ${gridClass} ${className}`}>
  {
    rows
      ? rows.map((row) => (
          <div class="min-w-0">
            <dt class="overline">{row.label}</dt>
            <dd
              class={`mt-0.5 break-words text-body text-ink ${row.tnum || row.mono ? 'tnum' : ''} ${row.mono ? 'tracking-wide' : ''}`}
            >
              {row.value}
            </dd>
          </div>
        ))
      : <slot />
  }
</dl>
