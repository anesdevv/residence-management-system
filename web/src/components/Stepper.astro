---
/**
 * RÉSIVO — Stepper (docs/DESIGN.md §6).
 * Horizontal on desktop, vertical on mobile. Numbered dots + connectors:
 * done = ok tokens, current = teal-600, todo = line/muted.
 * `aria-current="step"` marks the current one.
 *
 * The maintenance lifecycle is: Pending › In progress › Resolved
 *   <Stepper steps={['Pending', 'In progress', 'Resolved']} current={1} />
 */
import Icon from './Icon.astro';

type StepState = 'done' | 'current' | 'todo';

interface Props {
  steps: string[];
  current: number;
  /** Optional per-step override; defaults to done/current/todo around `current`. */
  states?: StepState[];
  class?: string;
}

const { steps, current, states, class: className = '' } = Astro.props;

const items = steps.map((label, index) => {
  const explicit = states?.[index];
  const state: StepState = explicit ?? (index < current ? 'done' : index === current ? 'current' : 'todo');
  return { label, state, isLast: index === steps.length - 1 };
});

const DOT: Record<StepState, string> = {
  done: 'border-ok-line bg-ok-bg text-ok',
  current: 'border-teal-600 bg-teal-600 text-surface',
  todo: 'border-line bg-subtle text-muted',
};

const LABEL: Record<StepState, string> = {
  done: 'text-ink-2',
  current: 'font-semibold text-ink',
  todo: 'text-muted',
};
---

<ol class={`stepper flex flex-col sm:flex-row sm:items-start ${className}`}>
  {
    items.map((step, index) => (
      <li
        class="stepper-step flex flex-1 items-stretch gap-3 pb-6 last:pb-0 sm:flex-col sm:gap-2 sm:pb-0"
        aria-current={step.state === 'current' ? 'step' : undefined}
        data-state={step.state}
      >
        <div class="flex shrink-0 flex-col items-center self-stretch sm:w-full sm:flex-row">
          <span
            class={`stepper-dot flex h-6 w-6 shrink-0 items-center justify-center rounded-pill border text-small font-semibold tnum ${DOT[step.state]}`}
          >
            {step.state === 'done' ? (
              <span class="stepper-icon inline-flex items-center justify-center">
                <Icon name="check" size={13} />
              </span>
            ) : (
              <span class="stepper-num">{index + 1}</span>
            )}
          </span>
          {!step.isLast && (
            <div
              class="stepper-track relative mt-1 w-px flex-1 overflow-hidden rounded-pill bg-line sm:mt-0 sm:ml-2 sm:h-px sm:w-full"
              aria-hidden="true"
            >
              <span
                class={`stepper-fill absolute inset-0 bg-ok-line ${step.state === 'done' ? 'is-done' : ''}`}
              />
            </div>
          )}
        </div>
        <span class={`stepper-label text-small ${LABEL[step.state]}`}>{step.label}</span>
      </li>
    ))
  }
</ol>

<style>
  /* Stepper motion craft — charles-ux-animation:
     1. Transitions indicate progress cleanly without bouncy overshoot.
     2. Moving / resizing on screen curve: cubic-bezier(0.77, 0, 0.175, 1) over 240ms.
     3. Animate strictly transform and opacity, never width/height/margin/padding.
     4. prefers-reduced-motion completely cancels transforms/delays while preserving visible state cues.
  */
  .stepper-dot {
    transition:
      transform 200ms cubic-bezier(0.32, 0.72, 0, 1),
      background-color 200ms ease,
      border-color 200ms ease,
      color 200ms ease;
    will-change: transform;
  }

  .stepper-step[aria-current="step"] .stepper-dot {
    transform: scale(1.05);
  }

  .stepper-icon,
  .stepper-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition:
      opacity 180ms ease,
      transform 180ms cubic-bezier(0.32, 0.72, 0, 1);
  }

  .stepper-label {
    transition: color 200ms ease;
  }

  /* Connector progress fill:
     Mobile (vertical): scaleY from top.
     Desktop (horizontal): scaleX from left.
     Zero bounce: monotonic cubic-bezier(0.77, 0, 0.175, 1).
  */
  .stepper-fill {
    transform-origin: top center;
    transform: scaleY(0);
    transition: transform 240ms cubic-bezier(0.77, 0, 0.175, 1);
    will-change: transform;
  }

  .stepper-fill.is-done {
    transform: scaleY(1);
  }

  @media (min-width: 640px) {
    .stepper-fill {
      transform-origin: left center;
      transform: scaleX(0);
    }

    .stepper-fill.is-done {
      transform: scaleX(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stepper-dot,
    .stepper-icon,
    .stepper-num,
    .stepper-label,
    .stepper-fill {
      transition: none !important;
      animation: none !important;
      transition-delay: 0ms !important;
      animation-delay: 0ms !important;
    }

    .stepper-step[aria-current="step"] .stepper-dot {
      transform: none !important;
    }

    .stepper-fill {
      transform: scaleY(0) !important;
    }

    .stepper-fill.is-done {
      transform: scaleY(1) !important;
    }

    @media (min-width: 640px) {
      .stepper-fill {
        transform: scaleX(0) !important;
      }

      .stepper-fill.is-done {
        transform: scaleX(1) !important;
      }
    }
  }
</style>
