---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import BrandMark from '../components/BrandMark.astro';
import DashboardShell from '../components/DashboardShell.astro';
import { localizePath, t, getDirection, type SupportedLocale } from '../lib/i18n';

interface Props {
  title?: string;
  description?: string;
  activeNav?: 'dashboard' | 'maintenance' | 'room-change' | 'profile' | 'login' | 'register' | 'home';
}

const {
  title = 'RÉSIVO: Cité Universitaire Tlemcen',
  description = 'Official student housing portal of Cité Universitaire Tlemcen, Direction des Œuvres Universitaires (DOU).',
  activeNav,
} = Astro.props;

const user = Astro.locals.user;
const locale: SupportedLocale = Astro.locals.locale || 'en';
const pathname = Astro.url.pathname;
const cleanPathname = pathname === '/fr' ? '/' : pathname.startsWith('/fr/') ? pathname.slice(3) : pathname;

const currentNav = activeNav || (
  cleanPathname === '/' ? 'home' :
  cleanPathname.startsWith('/dashboard/maintenance') ? 'maintenance' :
  cleanPathname.startsWith('/dashboard/room-change') ? 'room-change' :
  cleanPathname.startsWith('/dashboard/profile') ? 'profile' :
  cleanPathname.startsWith('/dashboard') ? 'dashboard' :
  cleanPathname.startsWith('/login') ? 'login' :
  cleanPathname.startsWith('/register') ? 'register' : 'home'
);

type DashboardNav = 'dashboard' | 'maintenance' | 'room-change' | 'profile';

const dashNav = (['dashboard', 'maintenance', 'room-change', 'profile'] as const).includes(currentNav as DashboardNav)
  ? (currentNav as DashboardNav)
  : null;
const isAuth = currentNav === 'login' || currentNav === 'register';
const isLogin = currentNav === 'login';
const isHome = currentNav === 'home';

const sectionTitles: Record<DashboardNav, string> = {
  dashboard: t(locale, 'nav.dashboard'),
  maintenance: t(locale, 'nav.maintenance'),
  'room-change': t(locale, 'terms.room_change_request'),
  profile: t(locale, 'nav.profile'),
};

const cleanQuery = new URLSearchParams(Astro.url.search);
cleanQuery.delete('lang');
const queryString = cleanQuery.toString() ? `?${cleanQuery.toString()}` : '';
const targetEnBase = localizePath('en', pathname) + queryString;
const targetFrBase = localizePath('fr', pathname) + queryString;

const targetEnPath = targetEnBase + (targetEnBase.includes('?') ? '&lang=en' : '?lang=en');
const targetFrPath = targetFrBase + (targetFrBase.includes('?') ? '&lang=fr' : '?lang=fr');
const canonicalEn = new URL(targetEnBase, Astro.url).href;
const canonicalFr = new URL(targetFrBase, Astro.url).href;
---

<!doctype html>
<html lang={locale} dir={getDirection(locale)} class="overflow-x-clip">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0A2342" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/brand/resivo_mark.png" />
    <link rel="alternate" hreflang="en" href={canonicalEn} />
    <link rel="alternate" hreflang="fr" href={canonicalFr} />
    <link rel="alternate" hreflang="x-default" href={canonicalEn} />
    <!-- Self-hosted fonts only: preload the two faces used above the fold. -->
    <link rel="preload" as="font" type="font/woff2" href="/fonts/inter-400.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/outfit-600.woff2" crossorigin />
    <title>{title}</title>
  </head>
  <body class="flex min-h-screen flex-col overflow-x-clip bg-canvas font-sans text-ink" data-timeout-msg={t(locale, 'errors.timeout')}>
    {dashNav ? (
      <DashboardShell title={sectionTitles[dashNav]} activeNav={dashNav}>
        <slot />
      </DashboardShell>
    ) : isAuth ? (
      <>
        <a class="skip" href="#main-content">
          {locale === 'fr' ? 'Aller au contenu principal' : 'Skip to main content'}
        </a>
        <!-- Minimal auth chrome -->
        <header class="border-b border-line bg-surface">
          <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-3 px-4 sm:px-6">
            <div class="flex items-center gap-4">
              <a href={localizePath(locale, '/')} class="flex items-center gap-2.5 whitespace-nowrap">
                <BrandMark variant="mark" size={32} />
                <span class="font-display text-h2 font-bold tracking-tight text-ink">RÉSIVO</span>
              </a>
              <span class="h-4 w-px bg-line hidden sm:block" aria-hidden="true"></span>
              <a
                href={localizePath(locale, '/')}
                class="hidden sm:inline-flex items-center gap-1.5 text-small font-medium text-muted hover:text-ink transition-colors whitespace-nowrap"
              >
                <Icon name="arrow-left" size={14} class="rtl-mirror" />
                <span>{locale === 'fr' ? 'Retour à l’accueil' : 'Back to home'}</span>
              </a>
            </div>

            <div class="ms-auto flex items-center gap-2 sm:gap-3 shrink-0">
              <a
                href={localizePath(locale, '/')}
                class="sm:hidden inline-flex items-center gap-1 text-small font-medium text-muted hover:text-ink transition-colors px-2 py-1 whitespace-nowrap"
                aria-label={locale === 'fr' ? 'Retour à l’accueil' : 'Back to home'}
              >
                <Icon name="arrow-left" size={14} class="rtl-mirror" />
                <span>{locale === 'fr' ? 'Accueil' : 'Home'}</span>
              </a>

              <!-- Language switcher -->
              <nav aria-label={t(locale, 'nav.language')} class="flex items-center rounded-input border border-line bg-subtle p-0.5 text-small font-semibold">
                <a
                  href={targetFrPath}
                  data-locale-switch="fr"
                  class={`rounded-input px-2.5 py-1 transition-colors whitespace-nowrap ${
                    locale === 'fr' ? 'bg-surface text-ink shadow-e1' : 'text-muted hover:text-ink'
                  }`}
                  aria-current={locale === 'fr' ? 'true' : undefined}
                >
                  FR
                </a>
                <a
                  href={targetEnPath}
                  data-locale-switch="en"
                  class={`rounded-input px-2.5 py-1 transition-colors whitespace-nowrap ${
                    locale === 'en' ? 'bg-surface text-ink shadow-e1' : 'text-muted hover:text-ink'
                  }`}
                  aria-current={locale === 'en' ? 'true' : undefined}
                >
                  EN
                </a>
              </nav>
            </div>
          </div>
        </header>

        <main id="main-content" class="w-full flex-1">
          <div class="mx-auto w-full max-w-7xl px-4 py-6 sm:px-6 sm:py-8">
            <slot />
          </div>
        </main>

        <footer class="border-t border-line bg-surface">
          <p class="mx-auto max-w-7xl px-4 py-4 text-center text-small font-normal text-muted sm:px-6">
            Direction des Œuvres Universitaires (DOU), Cité Universitaire Tlemcen
          </p>
        </footer>
      </>
    ) : (
      <>
        <a class="skip" href="#main-content">
          {locale === 'fr' ? 'Aller au contenu principal' : 'Skip to main content'}
        </a>
        <!-- Institutional banner (desktop) -->
        <div class="hidden border-b border-navy-700 bg-navy-900 text-small text-on-dark-2 md:block">
          <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-2 sm:px-6">
            <div class="flex items-center gap-2">
              <Icon name="shield-check" size={14} class="text-teal-500 shrink-0" />
              <span>DOU Tlemcen, Direction des Œuvres Universitaires</span>
            </div>
            <div class="flex items-center gap-4">
              <span>{t(locale, 'landing.desk_hours')}</span>
              <span class="h-3 w-px bg-navy-700" aria-hidden="true"></span>
              <span class="font-medium text-on-dark tnum">{t(locale, 'landing.hotline')}</span>
            </div>
          </div>
        </div>

        <!-- Public header -->
        <header class="sticky top-0 z-40 border-b border-line bg-surface">
          <div class="mx-auto flex max-w-7xl items-center justify-between gap-3 px-4 py-3 sm:px-6">
            <a href={user ? localizePath(locale, '/dashboard') : localizePath(locale, '/')} class="flex min-w-0 shrink items-center gap-2.5 sm:gap-3" aria-label="RÉSIVO">
              <BrandMark variant="mark" size={38} />
              <span class="flex min-w-0 flex-col">
                <span class="font-display text-h2 leading-none text-ink">RÉSIVO</span>
                <span class="hidden sm:inline text-small font-normal text-muted">Cité Universitaire, {t(locale, 'nav.student_portal')}</span>
              </span>
            </a>

            <!-- Desktop navigation -->
            <nav class="hidden items-center gap-2 md:flex" aria-label="Main">
              {user ? (
                <>
                  <a
                    href={localizePath(locale, '/dashboard')}
                    class="inline-flex min-h-11 items-center gap-2 rounded-input px-3 text-body font-semibold text-ink-2 transition-colors hover:bg-subtle hover:text-ink whitespace-nowrap"
                  >
                    <Icon name="dashboard" size={17} />
                    <span>{t(locale, 'nav.dashboard')}</span>
                  </a>
                  <a href="/logout" class="btn btn-secondary whitespace-nowrap">
                    <Icon name="log-out" size={16} />
                    <span>{t(locale, 'nav.sign_out')}</span>
                  </a>
                </>
              ) : (
                <>
                  <a
                    href={localizePath(locale, '/')}
                    class={`inline-flex min-h-11 items-center rounded-input px-3 text-body transition-colors whitespace-nowrap ${
                      isHome ? 'font-semibold text-teal-600' : 'font-semibold text-ink-2 hover:bg-subtle hover:text-ink'
                    }`}
                  >
                    {t(locale, 'nav.home')}
                  </a>
                  <a
                    href={localizePath(locale, '/login')}
                    class={`inline-flex min-h-11 items-center gap-2 rounded-input px-3 text-body transition-colors whitespace-nowrap ${
                      isLogin ? 'font-semibold text-teal-600' : 'font-semibold text-ink-2 hover:bg-subtle hover:text-ink'
                    }`}
                  >
                    <Icon name="log-in" size={16} />
                    <span>{t(locale, 'nav.sign_in')}</span>
                  </a>
                  <a href={localizePath(locale, '/register')} class="btn btn-primary whitespace-nowrap">
                    <Icon name="user" size={16} />
                    <span>{t(locale, 'nav.register_resident')}</span>
                  </a>
                </>
              )}

              <!-- Language switcher -->
              <div class="ms-2 flex items-center rounded-input border border-line bg-subtle p-0.5 text-small font-semibold" role="group" aria-label={t(locale, 'nav.language')}>
                <a
                  href={targetFrPath}
                  data-locale-switch="fr"
                  class={`rounded-input px-2.5 py-1 transition-colors whitespace-nowrap ${
                    locale === 'fr' ? 'bg-surface text-ink shadow-e1' : 'text-muted hover:text-ink'
                  }`}
                  aria-current={locale === 'fr' ? 'true' : undefined}
                >
                  FR
                </a>
                <a
                  href={targetEnPath}
                  data-locale-switch="en"
                  class={`rounded-input px-2.5 py-1 transition-colors whitespace-nowrap ${
                    locale === 'en' ? 'bg-surface text-ink shadow-e1' : 'text-muted hover:text-ink'
                  }`}
                  aria-current={locale === 'en' ? 'true' : undefined}
                >
                  EN
                </a>
              </div>
            </nav>

            <!-- Mobile quick controls -->
            <div class="flex items-center gap-2 md:hidden">
              <!-- Mobile language switcher -->
              <div class="flex items-center rounded-input border border-line bg-subtle p-0.5 text-small font-semibold shrink-0" role="group" aria-label={t(locale, 'nav.language')}>
                <a
                  href={targetFrPath}
                  data-locale-switch="fr"
                  class={`rounded-input px-2 py-1 transition-colors whitespace-nowrap ${
                    locale === 'fr' ? 'bg-surface text-ink shadow-e1' : 'text-muted hover:text-ink'
                  }`}
                  aria-current={locale === 'fr' ? 'true' : undefined}
                >
                  FR
                </a>
                <a
                  href={targetEnPath}
                  data-locale-switch="en"
                  class={`rounded-input px-2 py-1 transition-colors whitespace-nowrap ${
                    locale === 'en' ? 'bg-surface text-ink shadow-e1' : 'text-muted hover:text-ink'
                  }`}
                  aria-current={locale === 'en' ? 'true' : undefined}
                >
                  EN
                </a>
              </div>

              <!-- Accessible Mobile Menu Button -->
              <button
                type="button"
                id="mobile-drawer-toggle"
                class="touch-target-44 rounded-input border border-line bg-surface text-ink hover:bg-subtle transition-colors"
                aria-label={locale === 'fr' ? 'Ouvrir le menu de navigation' : 'Open navigation menu'}
                aria-expanded="false"
                aria-controls="mobile-drawer"
              >
                <Icon name="menu" size={20} />
              </button>
            </div>
          </div>
        </header>

        <!-- Mobile Navigation Drawer Backdrop & Panel -->
        <div id="mobile-drawer-backdrop" class="fixed inset-0 z-50 bg-navy-900/60 opacity-0 pointer-events-none transition-opacity duration-300 md:hidden" aria-hidden="true"></div>

        <aside
          id="mobile-drawer"
          class="fixed inset-y-0 end-0 z-50 flex w-[85vw] max-w-xs flex-col justify-between border-s border-line bg-surface p-5 shadow-e2 transition-transform duration-300 translate-x-full rtl:-translate-x-full md:hidden"
          aria-label={t(locale, 'nav.student_portal')}
          aria-hidden="true"
        >
          <div class="flex flex-col gap-6">
            <!-- Drawer top: Brand & Close button -->
            <div class="flex items-center justify-between border-b border-line pb-4">
              <a href={user ? localizePath(locale, '/dashboard') : localizePath(locale, '/')} class="flex items-center gap-2.5">
                <BrandMark variant="mark" size={32} />
                <span class="font-display text-h2 font-bold text-ink">RÉSIVO</span>
              </a>
              <button
                type="button"
                id="mobile-drawer-close"
                class="touch-target-44 rounded-input text-muted hover:text-ink hover:bg-subtle transition-colors"
                aria-label={locale === 'fr' ? 'Fermer le menu' : 'Close menu'}
              >
                <Icon name="x" size={22} />
              </button>
            </div>

            <!-- Drawer Links -->
            <nav class="flex flex-col gap-1.5" aria-label="Mobile Navigation">
              {user ? (
                <>
                  <a
                    href={localizePath(locale, '/dashboard')}
                    class={`flex min-h-[44px] items-center gap-3 rounded-input px-3.5 py-2.5 text-body font-semibold transition-colors ${
                      currentNav === 'dashboard' ? 'bg-teal-600/10 text-teal-600' : 'text-ink-2 hover:bg-subtle hover:text-ink'
                    }`}
                  >
                    <Icon name="dashboard" size={20} />
                    <span>{t(locale, 'nav.dashboard')}</span>
                  </a>
                  <a
                    href={localizePath(locale, '/dashboard/maintenance')}
                    class={`flex min-h-[44px] items-center gap-3 rounded-input px-3.5 py-2.5 text-body font-semibold transition-colors ${
                      currentNav === 'maintenance' ? 'bg-teal-600/10 text-teal-600' : 'text-ink-2 hover:bg-subtle hover:text-ink'
                    }`}
                  >
                    <Icon name="wrench" size={20} />
                    <span>{t(locale, 'nav.maintenance')}</span>
                  </a>
                  <a
                    href={localizePath(locale, '/dashboard/room-change')}
                    class={`flex min-h-[44px] items-center gap-3 rounded-input px-3.5 py-2.5 text-body font-semibold transition-colors ${
                      currentNav === 'room-change' ? 'bg-teal-600/10 text-teal-600' : 'text-ink-2 hover:bg-subtle hover:text-ink'
                    }`}
                  >
                    <Icon name="arrow-left-right" size={20} />
                    <span>{t(locale, 'terms.room_change_request')}</span>
                  </a>
                  <a
                    href={localizePath(locale, '/dashboard/profile')}
                    class={`flex min-h-[44px] items-center gap-3 rounded-input px-3.5 py-2.5 text-body font-semibold transition-colors ${
                      currentNav === 'profile' ? 'bg-teal-600/10 text-teal-600' : 'text-ink-2 hover:bg-subtle hover:text-ink'
                    }`}
                  >
                    <Icon name="user" size={20} />
                    <span>{t(locale, 'nav.profile')}</span>
                  </a>
                  <div class="my-2 border-t border-line"></div>
                  <a
                    href="/logout"
                    class="flex min-h-[44px] items-center gap-3 rounded-input px-3.5 py-2.5 text-body font-semibold text-danger hover:bg-danger-bg transition-colors"
                  >
                    <Icon name="log-out" size={20} />
                    <span>{t(locale, 'nav.sign_out')}</span>
                  </a>
                </>
              ) : (
                <>
                  <a
                    href={localizePath(locale, '/')}
                    class={`flex min-h-[44px] items-center gap-3 rounded-input px-3.5 py-2.5 text-body font-semibold transition-colors ${
                      isHome ? 'bg-teal-600/10 text-teal-600' : 'text-ink-2 hover:bg-subtle hover:text-ink'
                    }`}
                  >
                    <Icon name="home" size={20} />
                    <span>{t(locale, 'nav.home')}</span>
                  </a>
                  <a
                    href={localizePath(locale, '/login')}
                    class={`flex min-h-[44px] items-center gap-3 rounded-input px-3.5 py-2.5 text-body font-semibold transition-colors ${
                      isLogin ? 'bg-teal-600/10 text-teal-600' : 'text-ink-2 hover:bg-subtle hover:text-ink'
                    }`}
                  >
                    <Icon name="log-in" size={20} />
                    <span>{t(locale, 'nav.sign_in')}</span>
                  </a>
                  <a
                    href={localizePath(locale, '/register')}
                    class="btn btn-primary mt-2 w-full justify-start gap-3 whitespace-nowrap"
                  >
                    <Icon name="user" size={18} />
                    <span>{t(locale, 'nav.register_resident')}</span>
                  </a>
                </>
              )}
            </nav>
          </div>

          <!-- Drawer bottom info -->
          <div class="border-t border-line pt-4 text-small text-muted flex flex-col gap-2">
            <div class="flex items-center gap-2 text-ink-2 font-medium">
              <Icon name="phone" size={14} class="text-teal-600 shrink-0 rtl-mirror" />
              <a href="tel:+21343210000" class="hover:underline tracking-wide tnum" dir="ltr">+213 (0) 43 21 00 00</a>
            </div>
            <p>Direction des Œuvres Universitaires (DOU)</p>
            <p class="text-small text-muted">Cité Universitaire, Tlemcen</p>
          </div>
        </aside>

        <!-- Public content slot -->
        <main id="main-content" class="w-full flex-1">
          <div class="mx-auto w-full max-w-7xl px-4 py-6 sm:px-6 sm:py-8">
            <slot />
          </div>
        </main>

        <!-- Institutional footer -->
        <footer class="border-t border-line bg-surface text-small text-muted">
          <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6">
            <div class="grid grid-cols-1 gap-8 md:grid-cols-4">
              <div class="space-y-3 md:col-span-2">
                <BrandMark variant="logo" size={80} alt="RÉSIVO" />
                <p class="measure font-normal leading-relaxed">
                  {t(locale, 'landing.footer_desc')}
                </p>
                <div class="font-normal">
                  {t(locale, 'landing.footer_institution')}
                </div>
              </div>

              <div>
                <h2 class="text-small font-semibold mb-3 text-ink">{t(locale, 'landing.footer_services_title')}</h2>
                <ul class="flex flex-col gap-1">
                  <li><a href={localizePath(locale, '/register')} class="link py-1 inline-block">{t(locale, 'landing.step_1_title')}</a></li>
                  <li><a href={localizePath(locale, '/login')} class="link py-1 inline-block">{t(locale, 'landing.service_status_title')}</a></li>
                  <li><a href={localizePath(locale, '/dashboard/maintenance')} class="link py-1 inline-block">{t(locale, 'nav.maintenance')}</a></li>
                  <li><a href={localizePath(locale, '/dashboard/room-change')} class="link py-1 inline-block">{t(locale, 'terms.room_change_request')}</a></li>
                </ul>
              </div>

              <div>
                <h2 class="text-small font-semibold mb-3 text-ink">{t(locale, 'landing.footer_contact_title')}</h2>
                <ul class="flex flex-col gap-2">
                  <li class="flex items-center gap-2">
                    <Icon name="building" size={14} class="shrink-0 text-muted" />
                    <span>{t(locale, 'landing.footer_housing_bureau')}</span>
                  </li>
                  <li class="flex items-center gap-2">
                    <Icon name="phone" size={14} class="shrink-0 text-muted" />
                    <span class="tnum">+213 (0) 43 21 00 00</span>
                  </li>
                  <li class="flex items-center gap-2">
                    <Icon name="mail" size={14} class="shrink-0 text-muted" />
                    <span>residence.tlemcen@dou-univ.dz</span>
                  </li>
                  <li class="flex items-center gap-2">
                    <Icon name="clock" size={14} class="shrink-0 text-muted" />
                    <span>{t(locale, 'landing.footer_emergency')}</span>
                  </li>
                </ul>
              </div>
            </div>

            <div
              class="mt-8 flex flex-col items-center justify-between gap-3 border-t border-line pt-6 font-normal sm:flex-row"
            >
              <p>{t(locale, 'landing.footer_rights', { year: new Date().getFullYear() })}</p>
              <p>{t(locale, 'landing.footer_tagline')}</p>
            </div>
          </div>
        </footer>
      </>
    )}

    <!-- Toast host: fixed bottom-right on desktop, above the mobile tab bar. -->
    <div id="toast-host"></div>
    <script is:inline>
      document.querySelectorAll('[data-toast]').forEach(function (toast) {
        var dismiss = function () {
          toast.remove();
        };
        var button = toast.querySelector('[data-toast-dismiss]');
        if (button) button.addEventListener('click', dismiss);
        setTimeout(dismiss, 4000);
      });

      /* Language switcher persistent cookie handler */
      document.addEventListener('click', function (e) {
        var target = e.target && e.target.closest ? e.target.closest('[data-locale-switch]') : null;
        if (target) {
          var targetLocale = target.getAttribute('data-locale-switch');
          if (targetLocale) {
            document.cookie = 'resivo_locale=' + targetLocale + '; path=/; max-age=31536000; SameSite=Lax';
          }
        }
      });

      /* Double-submit protection & submission timeout watchdog */
      document.addEventListener('submit', function (e) {
        if (e.defaultPrevented) return;
        var form = e.target;
        if (!(form instanceof HTMLFormElement)) return;

        // Prevent double submit if already submitting
        if (form.dataset.submitting === 'true') {
          e.preventDefault();
          return;
        }
        form.dataset.submitting = 'true';

        var submitBtn = form.querySelector('button[type="submit"], input[type="submit"]');
        if (submitBtn) {
          submitBtn.setAttribute('data-submitting', 'true');
        }

        var isMultipart = form.enctype === 'multipart/form-data' || Boolean(form.querySelector('input[type="file"]'));
        var timeoutMs = isMultipart ? 30000 : 20000;

        var originalText = submitBtn ? submitBtn.innerHTML : '';
        var timer = setTimeout(function () {
          delete form.dataset.submitting;
          if (submitBtn) {
            submitBtn.removeAttribute('disabled');
            submitBtn.removeAttribute('data-submitting');
            submitBtn.innerHTML = originalText;
          }
          var existingBanner = form.querySelector('.timeout-banner');
          if (!existingBanner) {
            var banner = document.createElement('div');
            banner.className = 'timeout-banner mt-3 p-3 rounded-input border border-danger-line bg-danger-bg text-danger text-small font-medium';
            banner.setAttribute('role', 'alert');
            banner.textContent = document.body.dataset.timeoutMsg || 'The server is taking too long to respond. Check your connection and try again.';
            form.prepend(banner);
          }
        }, timeoutMs + 1000);

        window.addEventListener('pageshow', function () {
          clearTimeout(timer);
          delete form.dataset.submitting;
          if (submitBtn) {
            submitBtn.removeAttribute('disabled');
            submitBtn.removeAttribute('data-submitting');
            submitBtn.innerHTML = originalText;
          }
        });
      });

      /* Tab focus throttle (do not refetch unless data is older than 30 s) */
      window._resivoLastPageLoad = Date.now();
      window.addEventListener('focus', function () {
        var elapsed = Date.now() - (window._resivoLastPageLoad || 0);
        if (elapsed < 30000) {
          // Data is fresh; skip refetching
          return;
        }
        window._resivoLastPageLoad = Date.now();
      });

      /* Mobile navigation drawer open/close controller */
      (function() {
        var toggle = document.getElementById('mobile-drawer-toggle');
        var drawer = document.getElementById('mobile-drawer');
        var backdrop = document.getElementById('mobile-drawer-backdrop');
        var closeBtn = document.getElementById('mobile-drawer-close');
        if (!drawer || !backdrop) return;

        function openDrawer() {
          drawer.classList.remove('translate-x-full', 'rtl:-translate-x-full');
          drawer.setAttribute('aria-hidden', 'false');
          backdrop.classList.remove('opacity-0', 'pointer-events-none');
          backdrop.classList.add('opacity-100');
          if (toggle) toggle.setAttribute('aria-expanded', 'true');
          document.body.style.overflow = 'hidden';
        }

        function closeDrawer() {
          drawer.classList.add('translate-x-full', 'rtl:-translate-x-full');
          drawer.setAttribute('aria-hidden', 'true');
          backdrop.classList.remove('opacity-100');
          backdrop.classList.add('opacity-0', 'pointer-events-none');
          if (toggle) toggle.setAttribute('aria-expanded', 'false');
          document.body.style.overflow = '';
        }

        if (toggle) {
          toggle.addEventListener('click', function() {
            var isOpen = toggle.getAttribute('aria-expanded') === 'true';
            if (isOpen) closeDrawer(); else openDrawer();
          });
        }

        if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
        backdrop.addEventListener('click', closeDrawer);

        drawer.querySelectorAll('a').forEach(function(link) {
          link.addEventListener('click', closeDrawer);
        });

        document.addEventListener('keydown', function(e) {
          if (e.key === 'Escape' && drawer.getAttribute('aria-hidden') === 'false') {
            closeDrawer();
          }
        });
      })();
    </script>
    <style>
      h1,
      h2 {
        overflow-wrap: break-word;
        min-width: 0;
        text-wrap: balance;
      }
    </style>
  </body>
</html>
