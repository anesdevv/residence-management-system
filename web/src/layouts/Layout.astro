---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import BrandMark from '../components/BrandMark.astro';
import DashboardShell from '../components/DashboardShell.astro';
import { localizePath, t, type SupportedLocale } from '../lib/i18n';

interface Props {
  title?: string;
  description?: string;
  activeNav?: 'dashboard' | 'maintenance' | 'room-change' | 'profile' | 'login' | 'register' | 'home';
}

const {
  title = 'RÉSIVO — Cité Universitaire Tlemcen',
  description = 'Official student housing portal of Cité Universitaire Tlemcen — Direction des Œuvres Universitaires (DOU).',
  activeNav,
} = Astro.props;

const user = Astro.locals.user;
const locale: SupportedLocale = Astro.locals.locale || 'en';
const pathname = Astro.url.pathname;
const cleanPathname = pathname === '/fr' ? '/' : pathname.startsWith('/fr/') ? pathname.slice(3) : pathname;

const currentNav = activeNav || (
  cleanPathname === '/' ? 'home' :
  cleanPathname.startsWith('/dashboard/maintenance') ? 'maintenance' :
  cleanPathname.startsWith('/dashboard/room-change') ? 'room-change' :
  cleanPathname.startsWith('/dashboard/profile') ? 'profile' :
  cleanPathname.startsWith('/dashboard') ? 'dashboard' :
  cleanPathname.startsWith('/login') ? 'login' :
  cleanPathname.startsWith('/register') ? 'register' : 'home'
);

type DashboardNav = 'dashboard' | 'maintenance' | 'room-change' | 'profile';

const dashNav = (['dashboard', 'maintenance', 'room-change', 'profile'] as const).includes(currentNav as DashboardNav)
  ? (currentNav as DashboardNav)
  : null;
const isAuth = currentNav === 'login' || currentNav === 'register';
const isLogin = currentNav === 'login';
const isHome = currentNav === 'home';

const sectionTitles: Record<DashboardNav, string> = {
  dashboard: t(locale, 'nav.dashboard'),
  maintenance: t(locale, 'nav.maintenance'),
  'room-change': t(locale, 'terms.room_change_request'),
  profile: t(locale, 'nav.profile'),
};

const currentPathWithSearch = pathname + Astro.url.search;
const targetEnPath = localizePath('en', currentPathWithSearch);
const targetFrPath = localizePath('fr', currentPathWithSearch);
const canonicalEn = new URL(targetEnPath, Astro.url).href;
const canonicalFr = new URL(targetFrPath, Astro.url).href;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0A2342" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/brand/resivo_mark.png" />
    <link rel="alternate" hreflang="en" href={canonicalEn} />
    <link rel="alternate" hreflang="fr" href={canonicalFr} />
    <link rel="alternate" hreflang="x-default" href={canonicalEn} />
    <!-- Self-hosted fonts only: preload the two faces used above the fold. -->
    <link rel="preload" as="font" type="font/woff2" href="/fonts/inter-400.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/outfit-600.woff2" crossorigin />
    <title>{title}</title>
  </head>
  <body class="flex min-h-screen flex-col bg-canvas font-sans text-ink">
    {dashNav ? (
      <DashboardShell title={sectionTitles[dashNav]} activeNav={dashNav}>
        <slot />
      </DashboardShell>
    ) : isAuth ? (
      <>
        <!-- Minimal auth chrome -->
        <header class="border-b border-line bg-surface">
          <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
            <a href={localizePath(locale, '/')} class="flex items-center gap-3">
              <BrandMark variant="mark" size={36} />
              <span class="flex flex-col">
                <span class="font-display text-h2 text-ink">RÉSIVO</span>
                <span class="text-small font-normal text-muted">Cité Universitaire • {t(locale, 'nav.student_portal')}</span>
              </span>
            </a>

            <div class="flex items-center gap-3">
              <span class="hidden items-center gap-2 text-small text-muted sm:flex">
                <span class="live-dot live-dot--connected"></span>
                <span>{t(locale, 'nav.student_portal')}</span>
              </span>

              <!-- Language switcher -->
              <nav aria-label={t(locale, 'nav.language')} class="flex items-center rounded-pill border border-line bg-subtle p-0.5 text-xs font-semibold">
                <a
                  href={targetFrPath}
                  data-locale-switch="fr"
                  class={`rounded-pill px-2.5 py-1 transition-colors ${
                    locale === 'fr' ? 'bg-surface text-ink shadow-xs' : 'text-muted hover:text-ink'
                  }`}
                  aria-current={locale === 'fr' ? 'true' : undefined}
                >
                  FR
                </a>
                <a
                  href={targetEnPath}
                  data-locale-switch="en"
                  class={`rounded-pill px-2.5 py-1 transition-colors ${
                    locale === 'en' ? 'bg-surface text-ink shadow-xs' : 'text-muted hover:text-ink'
                  }`}
                  aria-current={locale === 'en' ? 'true' : undefined}
                >
                  EN
                </a>
              </nav>
            </div>
          </div>
        </header>

        <main class="w-full flex-1">
          <div class="mx-auto w-full max-w-7xl px-4 py-6 sm:px-6 sm:py-8">
            <slot />
          </div>
        </main>

        <footer class="border-t border-line bg-surface">
          <p class="mx-auto max-w-7xl px-4 py-4 text-center text-small font-normal text-muted sm:px-6">
            Direction des Œuvres Universitaires (DOU) • Cité Universitaire Tlemcen
          </p>
        </footer>
      </>
    ) : (
      <>
        <!-- Institutional banner (desktop) -->
        <div class="hidden border-b border-navy-700 bg-navy-900 text-small text-on-dark-2 md:block">
          <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-2 sm:px-6">
            <div class="flex items-center gap-2">
              <span class="live-dot live-dot--connected"></span>
              <span>DOU Tlemcen • Direction des Œuvres Universitaires</span>
            </div>
            <div class="flex items-center gap-4">
              <span>{t(locale, 'landing.desk_hours')}</span>
              <span aria-hidden="true">•</span>
              <span class="font-medium text-on-dark">{t(locale, 'landing.hotline')}</span>
            </div>
          </div>
        </div>

        <!-- Public header -->
        <header class="sticky top-0 z-40 border-b border-line bg-surface/90 backdrop-blur-md">
          <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
            <a href={user ? localizePath(locale, '/dashboard') : localizePath(locale, '/')} class="flex items-center gap-3">
              <BrandMark variant="mark" size={40} />
              <span class="flex flex-col">
                <span class="font-display text-h2 text-ink">RÉSIVO</span>
                <span class="text-small font-normal text-muted">Cité Universitaire • {t(locale, 'nav.student_portal')}</span>
              </span>
            </a>

            <!-- Desktop navigation -->
            <nav class="hidden items-center gap-2 md:flex" aria-label="Main">
              {user ? (
                <>
                  <a
                    href={localizePath(locale, '/dashboard')}
                    class="inline-flex min-h-11 items-center gap-2 rounded-input px-3 text-body font-semibold text-ink-2 transition-colors hover:bg-subtle hover:text-ink"
                  >
                    <Icon name="dashboard" size={17} />
                    <span>{t(locale, 'nav.dashboard')}</span>
                  </a>
                  <a href="/logout" class="btn btn-secondary">
                    <Icon name="log-out" size={16} />
                    <span>{t(locale, 'nav.sign_out')}</span>
                  </a>
                </>
              ) : (
                <>
                  <a
                    href={localizePath(locale, '/')}
                    class={`inline-flex min-h-11 items-center rounded-input px-3 text-body transition-colors ${
                      isHome ? 'font-semibold text-teal-600' : 'font-semibold text-ink-2 hover:bg-subtle hover:text-ink'
                    }`}
                  >
                    {t(locale, 'nav.home')}
                  </a>
                  <a
                    href={localizePath(locale, '/login')}
                    class={`inline-flex min-h-11 items-center gap-2 rounded-input px-3 text-body transition-colors ${
                      isLogin ? 'font-semibold text-teal-600' : 'font-semibold text-ink-2 hover:bg-subtle hover:text-ink'
                    }`}
                  >
                    <Icon name="log-in" size={16} />
                    <span>{t(locale, 'nav.sign_in')}</span>
                  </a>
                  <a href={localizePath(locale, '/register')} class="btn btn-primary">
                    <Icon name="user" size={16} />
                    <span>{t(locale, 'nav.register_resident')}</span>
                  </a>
                </>
              )}

              <!-- Language switcher -->
              <div class="ml-2 flex items-center rounded-pill border border-line bg-subtle p-0.5 text-xs font-semibold" role="group" aria-label={t(locale, 'nav.language')}>
                <a
                  href={targetFrPath}
                  data-locale-switch="fr"
                  class={`rounded-pill px-2.5 py-1 transition-colors ${
                    locale === 'fr' ? 'bg-surface text-ink shadow-xs' : 'text-muted hover:text-ink'
                  }`}
                  aria-current={locale === 'fr' ? 'true' : undefined}
                >
                  FR
                </a>
                <a
                  href={targetEnPath}
                  data-locale-switch="en"
                  class={`rounded-pill px-2.5 py-1 transition-colors ${
                    locale === 'en' ? 'bg-surface text-ink shadow-xs' : 'text-muted hover:text-ink'
                  }`}
                  aria-current={locale === 'en' ? 'true' : undefined}
                >
                  EN
                </a>
              </div>
            </nav>

            <!-- Mobile quick controls -->
            <div class="flex items-center gap-2 md:hidden">
              <!-- Mobile language switcher -->
              <div class="flex items-center rounded-pill border border-line bg-subtle p-0.5 text-xs font-semibold" role="group" aria-label={t(locale, 'nav.language')}>
                <a
                  href={targetFrPath}
                  data-locale-switch="fr"
                  class={`rounded-pill px-2 py-1 transition-colors ${
                    locale === 'fr' ? 'bg-surface text-ink shadow-xs' : 'text-muted hover:text-ink'
                  }`}
                  aria-current={locale === 'fr' ? 'true' : undefined}
                >
                  FR
                </a>
                <a
                  href={targetEnPath}
                  data-locale-switch="en"
                  class={`rounded-pill px-2 py-1 transition-colors ${
                    locale === 'en' ? 'bg-surface text-ink shadow-xs' : 'text-muted hover:text-ink'
                  }`}
                  aria-current={locale === 'en' ? 'true' : undefined}
                >
                  EN
                </a>
              </div>

              {user ? (
                <>
                  <a href={localizePath(locale, '/dashboard')} class="btn btn-secondary">
                    <span>{t(locale, 'nav.dashboard')}</span>
                  </a>
                  <a href="/logout" class="btn btn-ghost btn-icon" aria-label={t(locale, 'nav.sign_out')} title={t(locale, 'nav.sign_out')}>
                    <Icon name="log-out" size={18} />
                  </a>
                </>
              ) : (
                <>
                  <a href={localizePath(locale, '/login')} class="btn btn-secondary">
                    <span>{t(locale, 'nav.sign_in')}</span>
                  </a>
                  <a href={localizePath(locale, '/register')} class="btn btn-primary">
                    <span>{t(locale, 'common.add')}</span>
                  </a>
                </>
              )}
            </div>
          </div>
        </header>

        <!-- Public content slot -->
        <main class="w-full flex-1">
          <div class="mx-auto w-full max-w-7xl px-4 py-6 sm:px-6 sm:py-8">
            <slot />
          </div>
        </main>

        <!-- Institutional footer -->
        <footer class="border-t border-line bg-surface text-small text-muted">
          <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6">
            <div class="grid grid-cols-1 gap-8 md:grid-cols-4">
              <div class="space-y-3 md:col-span-2">
                <img
                  src="/brand/resivo_logo.png"
                  alt="RÉSIVO"
                  width="92"
                  height="80"
                  loading="lazy"
                  decoding="async"
                />
                <p class="measure font-normal leading-relaxed">
                  {t(locale, 'landing.footer_desc')}
                </p>
                <div class="font-normal">
                  {t(locale, 'landing.footer_institution')}
                </div>
              </div>

              <div>
                <h2 class="overline mb-3 text-ink">{t(locale, 'landing.footer_services_title')}</h2>
                <ul class="flex flex-col gap-1">
                  <li><a href={localizePath(locale, '/register')} class="link py-1 inline-block">{t(locale, 'landing.step_1_title')}</a></li>
                  <li><a href={localizePath(locale, '/login')} class="link py-1 inline-block">{t(locale, 'landing.service_status_title')}</a></li>
                  <li><a href={localizePath(locale, '/dashboard/maintenance')} class="link py-1 inline-block">{t(locale, 'nav.maintenance')}</a></li>
                  <li><a href={localizePath(locale, '/dashboard/room-change')} class="link py-1 inline-block">{t(locale, 'terms.room_change_request')}</a></li>
                </ul>
              </div>

              <div>
                <h2 class="overline mb-3 text-ink">{t(locale, 'landing.footer_contact_title')}</h2>
                <ul class="flex flex-col gap-2">
                  <li class="flex items-center gap-2">
                    <Icon name="building" size={14} class="shrink-0 text-muted" />
                    <span>{t(locale, 'landing.footer_housing_bureau')}</span>
                  </li>
                  <li class="flex items-center gap-2">
                    <Icon name="phone" size={14} class="shrink-0 text-muted" />
                    <span>+213 (0) 43 21 00 00</span>
                  </li>
                  <li class="flex items-center gap-2">
                    <Icon name="mail" size={14} class="shrink-0 text-muted" />
                    <span>residence.tlemcen@dou-univ.dz</span>
                  </li>
                  <li class="flex items-center gap-2">
                    <Icon name="clock" size={14} class="shrink-0 text-muted" />
                    <span>{t(locale, 'landing.footer_emergency')}</span>
                  </li>
                </ul>
              </div>
            </div>

            <div
              class="mt-8 flex flex-col items-center justify-between gap-3 border-t border-line pt-6 font-normal sm:flex-row"
            >
              <p>{t(locale, 'landing.footer_rights', { year: new Date().getFullYear() })}</p>
              <p>{t(locale, 'landing.footer_tagline')}</p>
            </div>
          </div>
        </footer>
      </>
    )}

    <!-- Toast host: fixed bottom-right on desktop, above the mobile tab bar. -->
    <div id="toast-host"></div>
    <script is:inline>
      document.querySelectorAll('[data-toast]').forEach(function (toast) {
        var dismiss = function () {
          toast.remove();
        };
        var button = toast.querySelector('[data-toast-dismiss]');
        if (button) button.addEventListener('click', dismiss);
        setTimeout(dismiss, 4000);
      });

      /* Language switcher persistent cookie handler */
      document.querySelectorAll('[data-locale-switch]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var targetLocale = btn.getAttribute('data-locale-switch');
          if (targetLocale) {
            document.cookie = 'resivo_locale=' + targetLocale + '; path=/; max-age=31536000; SameSite=Lax';
          }
        });
      });

      /* Double-submit protection & submission timeout watchdog */
      document.addEventListener('submit', function (e) {
        var form = e.target;
        if (!(form instanceof HTMLFormElement)) return;

        // Prevent double submit if already submitting
        if (form.dataset.submitting === 'true') {
          e.preventDefault();
          return;
        }
        form.dataset.submitting = 'true';

        var submitBtn = form.querySelector('button[type="submit"], input[type="submit"]');
        if (submitBtn) {
          submitBtn.setAttribute('data-submitting', 'true');
        }

        var isMultipart = form.enctype === 'multipart/form-data' || Boolean(form.querySelector('input[type="file"]'));
        var timeoutMs = isMultipart ? 30000 : 20000;

        var originalText = submitBtn ? submitBtn.innerHTML : '';
        var timer = setTimeout(function () {
          delete form.dataset.submitting;
          if (submitBtn) {
            submitBtn.removeAttribute('disabled');
            submitBtn.removeAttribute('data-submitting');
            submitBtn.innerHTML = originalText;
          }
          var existingBanner = form.querySelector('.timeout-banner');
          if (!existingBanner) {
            var banner = document.createElement('div');
            banner.className = 'timeout-banner mt-3 p-3 rounded-md bg-red-50 border border-red-200 text-red-800 text-sm font-medium';
            banner.textContent = 'The server is taking too long to respond. Check your connection and try again.';
            form.prepend(banner);
          }
        }, timeoutMs + 1000);

        window.addEventListener('pageshow', function () {
          clearTimeout(timer);
          delete form.dataset.submitting;
          if (submitBtn) {
            submitBtn.removeAttribute('disabled');
            submitBtn.removeAttribute('data-submitting');
            submitBtn.innerHTML = originalText;
          }
        });
      });

      /* Tab focus throttle (do not refetch unless data is older than 30 s) */
      window._resivoLastPageLoad = Date.now();
      window.addEventListener('focus', function () {
        var elapsed = Date.now() - (window._resivoLastPageLoad || 0);
        if (elapsed < 30000) {
          // Data is fresh; skip refetching
          return;
        }
        window._resivoLastPageLoad = Date.now();
      });
    </script>
  </body>
</html>
