---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import DashboardShell from '../components/DashboardShell.astro';

interface Props {
  title?: string;
  activeNav?: 'dashboard' | 'maintenance' | 'room-change' | 'profile' | 'login' | 'register' | 'home';
}

const { title = 'RÉSIVO — Cité Universitaire Tlemcen', activeNav } = Astro.props;
const user = Astro.locals.user;
const pathname = Astro.url.pathname;

const currentNav = activeNav || (
  pathname === '/' ? 'home' :
  pathname.startsWith('/dashboard/maintenance') ? 'maintenance' :
  pathname.startsWith('/dashboard/room-change') ? 'room-change' :
  pathname.startsWith('/dashboard/profile') ? 'profile' :
  pathname.startsWith('/dashboard') ? 'dashboard' :
  pathname.startsWith('/login') ? 'login' :
  pathname.startsWith('/register') ? 'register' : 'home'
);

type DashboardNav = 'dashboard' | 'maintenance' | 'room-change' | 'profile';

const dashNav = (['dashboard', 'maintenance', 'room-change', 'profile'] as const).includes(currentNav as DashboardNav)
  ? (currentNav as DashboardNav)
  : null;
const isAuth = currentNav === 'login' || currentNav === 'register';
const isLogin = currentNav === 'login';
const isHome = currentNav === 'home';

const sectionTitles: Record<DashboardNav, string> = {
  dashboard: 'Dashboard',
  maintenance: 'Maintenance',
  'room-change': 'Room Change',
  profile: 'Profile',
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#000b2b" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body class="flex min-h-screen flex-col bg-canvas font-sans text-ink antialiased">
    {dashNav ? (
      <DashboardShell title={sectionTitles[dashNav]} activeNav={dashNav}>
        <slot />
      </DashboardShell>
    ) : isAuth ? (
      <>
        <!-- Minimal auth chrome -->
        <header class="border-b border-line/60 bg-surface/85 backdrop-blur-xl">
          <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6">
            <a href="/" class="flex items-center gap-3">
              <img src="/favicon.svg" alt="" class="h-9 w-9 shrink-0 object-contain" />
              <span class="flex flex-col">
                <span class="font-display text-base font-extrabold leading-tight tracking-tight text-navy">RÉSIVO</span>
                <span class="text-[11px] font-medium text-muted">Cité Universitaire • Student Portal</span>
              </span>
            </a>
            <span class="hidden items-center gap-2 text-xs font-medium text-muted sm:flex">
              <span class="inline-block h-1.5 w-1.5 rounded-full bg-amber"></span>
              <span>Student Portal</span>
            </span>
          </div>
        </header>

        <main class="w-full flex-1">
          <div class="mx-auto w-full max-w-7xl px-4 py-6 sm:px-6 sm:py-8">
            <slot />
          </div>
        </main>

        <footer class="border-t border-line/60 bg-surface">
          <p class="mx-auto max-w-7xl px-4 py-4 text-center text-[11px] text-muted sm:px-6">
            Direction des Œuvres Universitaires (DOU) • Cité Universitaire Tlemcen
          </p>
        </footer>
      </>
    ) : (
      <>
        <!-- Institutional banner (desktop) -->
        <div class="hidden border-b border-white/10 bg-navy text-[11px] text-white/70 md:block">
          <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-2 sm:px-6">
            <div class="flex items-center gap-2 font-medium tracking-wide">
              <span class="inline-block h-1.5 w-1.5 rounded-full bg-amber"></span>
              <span>DOU Tlemcen • Direction des Œuvres Universitaires</span>
            </div>
            <div class="flex items-center gap-4">
              <span>Desk: Sun–Thu 08:30–16:30</span>
              <span aria-hidden="true">•</span>
              <span class="font-medium text-white/85">24/7 Security Hotline: +213 (0) 43 21 00 00</span>
            </div>
          </div>
        </div>

        <!-- Public header -->
        <header class="sticky top-0 z-40 border-b border-line/60 bg-surface/90 backdrop-blur-md">
          <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6">
            <a href={user ? '/dashboard' : '/'} class="group flex items-center gap-3">
              <img src="/favicon.svg" alt="" class="h-10 w-10 shrink-0 object-contain" />
              <span class="flex flex-col">
                <span class="font-display text-base font-extrabold leading-tight tracking-tight text-navy">RÉSIVO</span>
                <span class="text-[11px] font-medium text-muted">Cité Universitaire • Student Portal</span>
              </span>
            </a>

            <!-- Desktop navigation -->
            <nav class="hidden items-center gap-1 text-sm font-medium md:flex">
              {user ? (
                <>
                  <a
                    href="/dashboard"
                    class="flex items-center gap-2 rounded-lg px-3 py-2 text-muted transition-colors hover:bg-canvas hover:text-ink"
                  >
                    <Icon name="dashboard" size={17} />
                    <span>Dashboard</span>
                  </a>
                  <a
                    href="/logout"
                    class="flex items-center gap-1.5 rounded-lg border border-line px-3.5 py-2 text-xs font-semibold text-muted transition-colors hover:border-amber/60 hover:text-amber-ink"
                  >
                    <Icon name="logout" size={14} />
                    <span>Sign out</span>
                  </a>
                </>
              ) : (
                <>
                  <a
                    href="/"
                    class={`rounded-lg px-3 py-2 transition-colors ${isHome ? 'bg-canvas font-semibold text-navy' : 'text-muted hover:bg-canvas hover:text-ink'}`}
                  >
                    Home
                  </a>
                  <a
                    href="/login"
                    class={`flex items-center gap-1.5 rounded-lg px-3 py-2 transition-colors ${isLogin ? 'bg-canvas font-semibold text-navy' : 'text-muted hover:bg-canvas hover:text-ink'}`}
                  >
                    <Icon name="login" size={16} />
                    <span>Sign in</span>
                  </a>
                  <a
                    href="/register"
                    class="flex items-center gap-1.5 rounded-lg bg-navy px-4 py-2 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-navy-2"
                  >
                    <Icon name="user" size={16} />
                    <span>Register as Resident</span>
                  </a>
                </>
              )}
            </nav>

            <!-- Mobile quick controls -->
            <div class="flex items-center gap-2 md:hidden">
              {user ? (
                <div class="flex items-center gap-2">
                  <a
                    href="/dashboard"
                    class="flex min-h-[36px] items-center rounded-lg border border-line px-3 py-1.5 text-xs font-semibold text-muted"
                  >
                    Dashboard
                  </a>
                  <a
                    href="/logout"
                    class="flex h-9 w-9 items-center justify-center rounded-lg border border-line text-muted transition-colors hover:text-amber-ink"
                    aria-label="Sign out"
                  >
                    <Icon name="logout" size={16} />
                  </a>
                </div>
              ) : (
                <div class="flex items-center gap-2 text-xs font-semibold">
                  <a href="/login" class="flex min-h-[36px] items-center rounded-lg border border-line px-3 py-1.5 text-muted">
                    Sign in
                  </a>
                  <a href="/register" class="flex min-h-[36px] items-center rounded-lg bg-navy px-3 py-1.5 text-white">
                    Register
                  </a>
                </div>
              )}
            </div>
          </div>
        </header>

        <!-- Public content slot -->
        <main class="w-full flex-1">
          <div class="mx-auto w-full max-w-7xl px-4 py-6 sm:px-6 sm:py-8">
            <slot />
          </div>
        </main>

        <!-- Institutional footer -->
        <footer class="border-t border-line/70 bg-surface text-sm text-muted">
          <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6">
            <div class="grid grid-cols-1 gap-8 md:grid-cols-4">
              <div class="space-y-3 md:col-span-2">
                <img src="/resivo-logo.svg" alt="RÉSIVO" class="h-20 w-20" width="80" height="80" loading="lazy" />
                <p class="max-w-md text-xs leading-relaxed text-muted">
                  Official university accommodation system for enrolled students. Providing secure housing, streamlined room allocations, and 24/7 facility maintenance services in Tlemcen.
                </p>
                <div class="pt-1 text-xs text-muted/80">
                  Direction des Œuvres Universitaires (DOU) • Ministère de l'Enseignement Supérieur et de la Recherche Scientifique
                </div>
              </div>

              <div>
                <h3 class="mb-3 text-xs font-semibold uppercase tracking-wider text-navy">Resident Services</h3>
                <ul class="space-y-2 text-xs">
                  <li><a href="/register" class="transition-colors hover:text-amber-ink">Online Registration</a></li>
                  <li><a href="/login" class="transition-colors hover:text-amber-ink">Application Status Check</a></li>
                  <li><a href="/dashboard/maintenance" class="transition-colors hover:text-amber-ink">Maintenance &amp; Repairs</a></li>
                  <li><a href="/dashboard/room-change" class="transition-colors hover:text-amber-ink">Room Transfer Requests</a></li>
                </ul>
              </div>

              <div>
                <h3 class="mb-3 text-xs font-semibold uppercase tracking-wider text-navy">Department Contact</h3>
                <ul class="space-y-2 text-xs text-muted">
                  <li class="flex items-center gap-2">
                    <Icon name="building" size={14} class="shrink-0 text-muted/70" />
                    <span>Housing Bureau, Administration Bloc A</span>
                  </li>
                  <li class="flex items-center gap-2">
                    <Icon name="phone" size={14} class="shrink-0 text-muted/70" />
                    <span>+213 (0) 43 21 00 00</span>
                  </li>
                  <li class="flex items-center gap-2">
                    <Icon name="mail" size={14} class="shrink-0 text-muted/70" />
                    <span>residence.tlemcen@dou-univ.dz</span>
                  </li>
                  <li class="flex items-center gap-2">
                    <Icon name="clock" size={14} class="shrink-0 text-muted/70" />
                    <span>Emergency Desk: Open 24/7</span>
                  </li>
                </ul>
              </div>
            </div>

            <div class="mt-8 flex flex-col items-center justify-between gap-3 border-t border-line/50 pt-6 text-xs text-muted sm:flex-row">
              <p>© {new Date().getFullYear()} Cité Universitaire Tlemcen. All rights reserved.</p>
              <p>RÉSIVO — Student Residence Management Platform</p>
            </div>
          </div>
        </footer>
      </>
    )}
  </body>
</html>
